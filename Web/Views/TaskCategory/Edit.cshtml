@model Domain.TaskCategory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                    Task Category
                </h5>

                <a href="@Url.Action("Index", "TaskCategory")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Edit", "TaskCategory", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.TaskCategoryId)
                @Html.HiddenFor(model => model.TeamId)
                @Html.HiddenFor(model => model.Team.TeamName)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.TeamId,
                                new { @class = "form-label" }
                            )

                            <input type="text"
                                   class="form-control"
                                   value="@(Model.Team != null ? Model.Team.TeamName : "")"
                                   readonly />

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.TaskCategoryName,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.TaskCategoryName,
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.TaskCategoryName,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-3">

                            @Html.LabelFor(
                                model => model.Weightage,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.Weightage,
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Weightage,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

}