@using Service
@model IEnumerable<Domain.TaskCategory>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "TaskCategory", FormMethod.Post))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                        Task Categories
                    </h5>

                    <a href="@Url.Action("Create", "TaskCategory")"
                       class="btn btn-sm btn-primary">

                        <i class="align-middle me-1" data-lucide="plus"></i>
                        Add New

                    </a>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="TeamId" class="form-label">
                                Team
                            </label>

                            <select id="TeamId"
                                    name="TeamId"
                                    class="form-select">

                                <option value="0">-- Select --</option>

                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TeamId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle w-100">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Weightage</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.TaskCategoryName
                                    </td>

                                    <td>
                                        @item.Weightage
                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm">

                                            <a href="@Url.Action("Edit", "TaskCategory", new { id = item.TaskCategoryId })"
                                               class="btn btn-primary"
                                               title="Edit">

                                                <i class="align-middle"
                                                   data-lucide="pencil"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn btn-danger"
                                                    title="Delete"
                                                    onclick="deleteItem('@item.TaskCategoryId')">

                                                <i class="align-middle"
                                                   data-lucide="trash-2"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            loadTeams();

            $("#dataTable").DataTable({
                paging: false,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadTeams() {

            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    var dropDown = $("#TeamId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.TeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function deleteItem(itemId) {

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true
            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "TaskCategory")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted, Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted, Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}