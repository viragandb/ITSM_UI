@using Service
@using Service.IM
@model IEnumerable<Domain.AssetVerificationRequest>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "AssetVerification", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="search"></i>
                        Asset Verification Requests
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="AssetCategoryId" class="form-label">
                                Asset Category
                            </label>

                            <select id="AssetCategoryId"
                                    name="AssetCategoryId"
                                    class="form-select">
                            </select>

                        </div>

                        <div class="col-md-4">

                            <label for="BranchId" class="form-label">
                                Location
                            </label>

                            <select id="BranchId"
                                    name="BranchId"
                                    class="form-select select2">
                            </select>

                        </div>

                        <div class="col-md-4">

                            <label for="DepartmentId" class="form-label">
                                Department
                            </label>

                            <select id="DepartmentId"
                                    name="DepartmentId"
                                    class="form-select select2">
                            </select>

                        </div>

                        <div class="col-md-3">

                            <label for="StartDate" class="form-label">
                                Verification Date From
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="StartDate"
                                   value="@ViewBag.StartDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-3">

                            <label for="EndDate" class="form-label">
                                Verification Date To
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="EndDate"
                                   value="@ViewBag.EndDate"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>

                                <tr>
                                    <th>Request #</th>
                                    <th>Asset Category</th>
                                    <th>Branch</th>
                                    <th>Department</th>
                                    <th>Requester</th>
                                    <th>Planned Verification Date</th>
                                    <th>Status</th>
                                    <th>Requested Date</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "Info", "AssetVerification", "", new { id = item.AssetVerificationRequestId }, null)"
                                               target="_blank">

                                                Request #@item.AssetVerificationRequestId

                                            </a>

                                        </td>

                                        <td>
                                            @item.AssetCategory.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.Branch.Name
                                        </td>

                                        <td>
                                            @item.Department.DepartmentName
                                        </td>

                                        <td>
                                            @item.RequestedUser.FullName
                                        </td>

                                        <td>
                                            @item.VerificationDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>

                                            <span class="badge bg-secondary">
                                                @item.Status.EnumDisplayName()
                                            </span>

                                        </td>

                                        <td>
                                            @item.RequestedDate
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }

            $("#dataTable").DataTable({

                responsive: true,
                lengthChange: false,
                autoWidth: false,
                paging: false,

                buttons: [

                    {
                        extend: "excelHtml5",
                        text: "Excel",
                        title: "ITSM - Asset Verification Requests",
                        exportOptions: {
                            modifier: {
                                page: "current"
                            }
                        }
                    },

                    {
                        extend: "pdfHtml5",
                        text: "PDF",
                        title: "ITSM - Asset Verification Requests",
                        orientation: "landscape",
                        exportOptions: {
                            modifier: {
                                page: "current"
                            }
                        }
                    },

                    {
                        extend: "print",
                        text: "Print",
                        title: "ITSM - Asset Verification Requests",
                        autoPrint: true
                    },

                    "colvis"

                ]

            }).buttons().container().appendTo(
                "#dataTable_wrapper .col-md-6:eq(0)"
            );


            loadAssetCategory();
            loadLocations();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.BranchId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }


                    loadDepartments();

                }
            );

        }


        $("#BranchId").on("change", function () {

            loadDepartments();

        });


        function loadDepartments() {

            var branchId =
                $("#BranchId").val();


            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown =
                        $("#DepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.DepartmentId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.AssetCategoryId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}