@using Service
@using Service.IM
@model IEnumerable<Web.Models.AVPendingBranchVM>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("PendingToBeCreated", "AssetVerification", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                        Asset Verification Requests
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label for="AssetCategoryId" class="form-label">
                                Asset Category
                            </label>

                            <select id="AssetCategoryId"
                                    name="AssetCategoryId"
                                    class="form-select">
                            </select>

                        </div>

                        <div class="col-md-3">

                            <label for="BranchId" class="form-label">
                                Location
                            </label>

                            <select id="BranchId"
                                    name="BranchId"
                                    class="form-select select2">
                            </select>

                        </div>

                        <div class="col-md-3">

                            <label for="StartDate" class="form-label">
                                Verification Date From
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="StartDate"
                                   value="@ViewBag.StartDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-3">

                            <label for="EndDate" class="form-label">
                                Verification Date To
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="EndDate"
                                   value="@ViewBag.EndDate"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>

                                <tr>
                                    <th style="width:250px;">
                                        Branch
                                    </th>

                                    <th>
                                        Department/s Status
                                    </th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td class="fw-semibold align-top">

                                            <i class="align-middle me-1" data-lucide="building-2"></i>
                                            @item.BranchName

                                        </td>

                                        <td>

                                            <div class="table-responsive">

                                                <table class="table table-sm table-bordered table-hover align-middle mb-0">

                                                    <thead>

                                                        <tr>
                                                            <th>Department</th>
                                                            <th>Status</th>
                                                            <th>Date</th>
                                                        </tr>

                                                    </thead>

                                                    <tbody>

                                                        @foreach (var dept in item.PendingDepartments)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @dept.Departmentname
                                                                </td>

                                                                <td>

                                                                    @if (dept.AssetVerificationId == 0)
                                                                    {
                                                                        <span class="badge bg-danger">
                                                                            @dept.Status
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="@Html.EncodedActionLink("", "Info", "AssetVerification", "", new { id = dept.AssetVerificationId }, null)"
                                                                           target="_blank"
                                                                           class="text-decoration-none">

                                                                            <i class="align-middle me-1" data-lucide="external-link"></i>

                                                                            Request #@dept.AssetVerificationId
                                                                            -
                                                                            @dept.Status

                                                                        </a>
                                                                    }

                                                                </td>

                                                                <td>
                                                                    @dept.Date
                                                                </td>

                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }


            $("#dataTable").DataTable({
                responsive: true,
                lengthChange: false,
                autoWidth: false,
                paging: false,
                searching: true,
                ordering: true,
                info: true
            });


            loadAssetCategory();
            loadLocations();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.BranchId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.AssetCategoryId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}