@using Service
@model Web.Models.AssetVerificationVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "AssetVerification", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="search"></i>
                        Create Request
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label for="AssetCategoryId" class="form-label">
                                Asset Category
                            </label>

                            <select id="AssetCategoryId"
                                    name="AssetCategoryId"
                                    class="form-select">
                            </select>

                        </div>

                        <div class="col-md-3">

                            <label for="BranchId" class="form-label">
                                Location
                            </label>

                            <select id="BranchId"
                                    name="BranchId"
                                    class="form-select select2">
                            </select>

                        </div>

                        <div class="col-md-3">

                            <label for="DepartmentId" class="form-label">
                                Department
                            </label>

                            <select id="DepartmentId"
                                    name="DepartmentId"
                                    class="form-select select2">
                            </select>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@using (Html.BeginForm("Create", "AssetVerification", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    @Html.HiddenFor(m => Model.BranchId)
    @Html.HiddenFor(m => Model.DepartmentId)
    @Html.HiddenFor(m => Model.AssetCategory)

    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="boxes"></i>
                        Assets
                    </h5>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>

                                <tr>
                                    <th>Asset No</th>
                                    <th>Asset Category</th>
                                    <th>Asset Type</th>
                                    <th>Make</th>
                                    <th>Model</th>
                                    <th>Serial No</th>
                                    <th>Barcode</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (Model.Assets != null)
                                {
                                    for (var i = 0; i < Model.Assets.Count; i++)
                                    {
                                        <tr id="@i">

                                            <td>

                                                @Html.HiddenFor(
                                                    m => Model.Assets[i].AssetId
                                                )

                                                @Html.HiddenFor(
                                                    m => Model.Assets[i].AssetName
                                                )

                                                <a href="@Html.EncodedActionLink("", "Info", "Asset", "", new { id = Model.Assets[i].AssetId }, null)"
                                                   target="_blank">

                                                    @Model.Assets[i].AssetNo

                                                </a>

                                            </td>

                                            <td>
                                                @Model.Assets[i].AssetCategory.EnumDisplayName()
                                            </td>

                                            <td>
                                                @Model.Assets[i].AssetType.AssetTypeName
                                            </td>

                                            <td>
                                                @Model.Assets[i].AssetMake.Name
                                            </td>

                                            <td>
                                                @Model.Assets[i].ModelName
                                            </td>

                                            <td>
                                                @Model.Assets[i].SerialNo
                                            </td>

                                            <td>
                                                @Model.Assets[i].Barcode
                                            </td>

                                            <td>
                                                @Model.Assets[i].Status.EnumDisplayName()
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>


                    <div class="row g-3 mt-2">

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.VerificationDate,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.VerificationDate,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.VerificationDate,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                id="btnSave"
                                class="btn btn-primary btn-sm btnSubmitDisable">

                            <i class="align-middle me-1" data-lucide="send"></i>
                            Submit

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }

            $("#dataTable").DataTable({
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                paging: true,
                searching: true,
                ordering: true,
                info: true
            });

            loadAssetCategory();
            loadLocations();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.BranchId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadDepartments();

                }
            );

        }


        $("#BranchId").on("change", function () {

            loadDepartments();

        });


        function loadDepartments() {

            var branchId =
                $("#BranchId").val();


            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown =
                        $("#DepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.DepartmentId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.AssetCategoryId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}