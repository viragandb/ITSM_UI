@using Service
@model IEnumerable<Domain.AR.AccessRequestType>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "AccessRequestType", FormMethod.Post))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex align-items-center justify-content-between">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="key-round"></i>
                        Access Request Types
                    </h5>

                    <a href="@Url.Action("Create", "AccessRequestType")"
                       class="btn btn-sm btn-primary">

                        <i class="align-middle me-1" data-lucide="plus"></i>

                        Add New

                    </a>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Workflow</th>
                                    <th>IT</th>
                                    <th>Internal</th>
                                    <th>External</th>
                                    <th>Updated By</th>
                                    <th>Updated Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>@item.Name</td>

                                        <td>@item.Workflow.Name</td>

                                        <td>
                                            @if (item.ITOnly)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="align-middle me-1" data-lucide="check"></i>
                                                    Yes
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    No
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.Internal)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="align-middle me-1" data-lucide="check"></i>
                                                    Yes
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    No
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.External)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="align-middle me-1" data-lucide="check"></i>
                                                    Yes
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    No
                                                </span>
                                            }
                                        </td>

                                        <td>@item.UpdatedBy</td>

                                        <td>@item.UpdatedDate</td>

                                        <td class="text-end">

                                            <div class="d-flex justify-content-end gap-1">

                                                <a href="@Url.Action(
                                                             "Edit",
                                                             "AccessRequestType",
                                                             new { id = item.AccessRequestTypeId }
                                                         )"
                                                   class="btn btn-sm btn-primary">

                                                    <i class="align-middle"
                                                       data-lucide="pencil"></i>

                                                </a>

                                                <button type="button"
                                                        onclick="deleteItem('@item.AccessRequestTypeId')"
                                                        class="btn btn-sm btn-danger">

                                                    <i class="align-middle"
                                                       data-lucide="trash-2"></i>

                                                </button>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>
}

@section scripts {

    <script type="text/javascript">

        function deleteItem(itemId) {

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true
            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "AccessRequestType")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and can not be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted, Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted, Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }


        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true,
                columnDefs: [
                    {
                        targets: -1,
                        orderable: false,
                        searchable: false
                    }
                ]
            });

        });

    </script>

}
