@model IEnumerable<Domain.Workflow>
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="git-branch"></i>
                    Workflows
                </h5>

                <a href="@Url.Action("Create", "Workflow")"
                   class="btn btn-sm btn-primary">

                    <i class="align-middle me-1" data-lucide="plus"></i>
                    Add New

                </a>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Levels</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Name
                                    </td>

                                    <td>

                                        @if (item.WorkflowLevels != null)
                                        {
                                            var levels = item.WorkflowLevels
                                                .OrderBy(o => o.LevelNo)
                                                .ToList();

                                            for (var i = 0; i < levels.Count; i++)
                                            {
                                                var level = levels[i];

                                                if (i > 0)
                                                {
                                                    <i class="align-middle mx-1"
                                                       data-lucide="chevrons-right"></i>
                                                }

                                                <span>
                                                    @level.LevelNo -
                                                    @level.WorkflowLevelType.EnumDisplayName()
                                                    (
                                                    @(level.Team != null
                                                        ? level.Team.TeamName
                                                        : "N/A")
                                                    )
                                                </span>
                                            }
                                        }

                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm">

                                            <a href="@Url.Action("Edit", "Workflow", new { id = item.WorkflowId })"
                                               class="btn btn-primary"
                                               title="Edit">

                                                <i class="align-middle"
                                                   data-lucide="pencil"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn btn-danger"
                                                    title="Delete"
                                                    onclick="deleteItem('@item.WorkflowId')">

                                                <i class="align-middle"
                                                   data-lucide="trash-2"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                responsive: true,
                autoWidth: false,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true
            });

        });


        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "Workflow")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted. Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted. Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}