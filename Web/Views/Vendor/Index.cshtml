@using Service
@model IEnumerable<Domain.Vendor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="building-2"></i>
                    Vendors
                </h5>

                <a href="@Url.Action("Create", "Vendor")"
                   class="btn btn-sm btn-primary">

                    <i class="align-middle me-1" data-lucide="plus"></i>
                    Add New

                </a>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Contact No</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.VendorName
                                    </td>

                                    <td>
                                        @item.ContactNo
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @item.Address
                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm">

                                            <a href="@Url.Action("Edit", "Vendor", new { id = item.VendorId })"
                                               class="btn btn-primary"
                                               title="Edit">

                                                <i class="align-middle"
                                                   data-lucide="pencil"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn btn-danger"
                                                    title="Delete"
                                                    onclick="deleteItem('@item.VendorId')">

                                                <i class="align-middle"
                                                   data-lucide="trash-2"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: false,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

        });


        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "Vendor")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted. Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted. Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}