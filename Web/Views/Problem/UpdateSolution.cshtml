@model Domain.Problem
@using Service
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card box-danger">
            <div class="card-header with-border">
                <h3 class="card-title">Close Problem</h3>
                <div class="card-tools pull-right">
                    <a href="@Url.Action("Close", "Problem")" class="btn btn-social btn-cancel">
                        <i class="fa fa-arrow-left"></i>Back
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("UpdateSolution", "Problem", FormMethod.Post, new { @class = "form-horizontal" }))
            {

                @Html.HiddenFor(model => model.ProblemId)

                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-6">
                            @Html.Partial("_ProblemMin", Model)

                        </div>

                        <div class="col-lg-6 ">
                            <div class="card">
                                <div class="card-header with-border">
                                    <h3 class="card-title">Solution </h3>
                                    <div class="card-tools pull-right">

                                        <button type="button" class="btn btn-box-tool" data-widget="collapse" data-bs-toggle="tooltip" title="" data-original-title="Collapse">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Solution, new { @class = "col-md-3 control-label" })
                                        <div class="col-md-9">
                                            @Html.TextAreaFor(model => model.Solution, new { @class = "form-control", rows = "2" })
                                            @Html.ValidationMessageFor(model => model.Solution, null, new { @class = "help-block" })
                                        </div>
                                    </div>
                                                                     
                                    
                                </div>
                                <div class="card-footer">
                                    <div class="text-right">
                                        <button type="submit" class="btn btn-sm btn-social btn-default"><i class="fa fa-floppy-o"></i>Update</button>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>





                </div>

            }
        </div>
        <!-- /.box -->
    </div>
</div>

@section scripts {


}