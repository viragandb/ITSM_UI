@model Domain.Problem
@using Service


<div class="row">
    <div class="col-lg-12">
        <div class="card ">
            <div class="card-header">
                <h3 class="card-title">
                    <b> Problem @Model.ProblemId </b> | @Model.RequestType.Team.TeamName

                </h3>
                <div class="card-tools pull-right">

                    <span class="label text- label-@SystemService.GetPriorityColor(Model.Priority)">
                        @Model.Priority.EnumDisplayName()
                    </span>
                    &nbsp;&nbsp;&nbsp;&nbsp;
                    <span class="label text- label-@ProblemService.GetStatusColor(Model.Status)">
                        @Model.Status.EnumDisplayName()
                    </span>

                </div>
            </div>
            <div class="card-body">
                <div class="col-lg-12">
                    <div class="form-group row">
                        @Html.LabelFor(model => Model.Subject, new { @class = "col-md-3" })
                        <div class="col-md-9">
                             @Model.Subject
                        </div>
                    </div>
                    <div class="form-group row">
                        @Html.LabelFor(model => Model.Description, new { @class = "col-md-3" })
                        <div class="col-md-9">
                            @Model.Description
                        </div>
                    </div>

                    @if (Model.RootCause != null)
                    {
                        <div class="form-group row">
                            @Html.LabelFor(model => Model.RootCause, new { @class = "col-md-3" })
                            <div class="col-md-9">
                                @Model.RootCause
                            </div>
                        </div>

                        <div class="form-group row">
                            @Html.LabelFor(model => Model.Impact, new { @class = "col-md-3" })
                            <div class="col-md-9">
                                @Model.Impact
                            </div>
                        </div>

                        <div class="form-group row">
                            @Html.LabelFor(model => Model.Symptoms, new { @class = "col-md-3" })
                            <div class="col-md-9">
                                @Model.Symptoms
                            </div>
                        </div>
                    }
                    @if (Model.Solution != null)
                    {
                        <div class="form-group row">
                            @Html.LabelFor(model => Model.Solution, new { @class = "col-md-3" })
                            <div class="col-md-9">
                                @Model.Solution
                            </div>
                        </div>
                    }
                </div>
                <div class="col-lg-12">

                    <div class="form-group row">
                        <div class="col-md-4">
                            <i class="fa fa-@Model.RequestType.Category.Icon"></i> &nbsp;&nbsp; @Model.RequestType.Category.CategoryName
                        </div>

                        <div class="col-md-4">
                            <i class="fa fa-@Model.RequestType.AssetType.Icon"></i> &nbsp;&nbsp; @Model.RequestType.AssetType.AssetTypeName
                        </div>

                        <div class="col-md-4">
                            <i class="fa fa-@Model.RequestType.SubCategory.Icon"></i> &nbsp;&nbsp; @Model.RequestType.SubCategory.SubCategoryName
                        </div>

                    </div>
                    <div class="form-group row">
                        <div class="col-md-12">
                            <i class="fa fa-calendar"></i> &nbsp;&nbsp; @Model.RequestedDate
                        </div>

                    </div>
                </div>


            </div>
        </div>


    </div>
</div>
