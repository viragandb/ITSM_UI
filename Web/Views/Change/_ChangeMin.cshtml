@model Domain.Change
@using Service

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <strong>Change @Model.ChangeId</strong>
                    <span class="text-muted">
                        | @Model.ChangeRequestType.ChangeRequestTypeName
                    </span>
                </h5>

                <div class="d-flex align-items-center gap-2">

                    <span class="badge bg-@SystemService.GetPriorityColor(Model.Priority)">
                        @Model.Priority.EnumDisplayName()
                    </span>

                    <span class="badge bg-@ChangeService.GetStatusColor(Model.Status)">
                        @Model.Status.EnumDisplayName()
                    </span>

                </div>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-12">

                        <dl class="row mb-0">

                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.Subject)
                            </dt>

                            <dd class="col-md-9">
                                @Model.Subject
                            </dd>


                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.Description)
                            </dt>

                            <dd class="col-md-9"
                                style="white-space: pre-wrap;">
                                @Model.Description
                            </dd>


                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.ChangeType)
                            </dt>

                            <dd class="col-md-3">
                                @Model.ChangeType
                            </dd>

                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.Risk)
                            </dt>

                            <dd class="col-md-3">
                                @Model.Risk
                            </dd>


                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.StartDate)
                            </dt>

                            <dd class="col-md-3">
                                @Model.StartDate.ToShortDateString()
                            </dd>

                            <dt class="col-md-3">
                                @Html.DisplayNameFor(model => model.EndDate)
                            </dt>

                            <dd class="col-md-3">
                                @Model.EndDate.ToShortDateString()
                            </dd>


                            @if (Model.Reason != null)
                            {
                                <dt class="col-md-3">
                                    @Html.DisplayNameFor(model => model.Reason)
                                </dt>

                                <dd class="col-md-9"
                                    style="white-space: pre-wrap;">
                                    @Model.Reason
                                </dd>


                                <dt class="col-md-3">
                                    @Html.DisplayNameFor(model => model.Impact)
                                </dt>

                                <dd class="col-md-9"
                                    style="white-space: pre-wrap;">
                                    @Model.Impact
                                </dd>


                                <dt class="col-md-3">
                                    @Html.DisplayNameFor(model => model.RollOutPlan)
                                </dt>

                                <dd class="col-md-9"
                                    style="white-space: pre-wrap;">
                                    @Model.RollOutPlan
                                </dd>


                                <dt class="col-md-3">
                                    @Html.DisplayNameFor(model => model.BackOutPlan)
                                </dt>

                                <dd class="col-md-9"
                                    style="white-space: pre-wrap;">
                                    @Model.BackOutPlan
                                </dd>
                            }

                        </dl>

                    </div>

                </div>


                <hr />


                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="d-flex align-items-center">

                            <i class="align-middle me-2"
                               data-lucide="@Model.AssetType.Icon">
                            </i>

                            <span>
                                @Model.AssetType.AssetCategory.EnumDisplayName()
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="d-flex align-items-center">

                            <i class="align-middle me-2"
                               data-lucide="@Model.AssetType.Icon">
                            </i>

                            <span>
                                @Model.AssetType.AssetTypeName
                            </span>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="d-flex align-items-center">

                            <i class="align-middle me-2"
                               data-lucide="@Model.ChangeRequestType.Icon">
                            </i>

                            <span>
                                @Model.ChangeRequestType.ChangeRequestTypeName
                            </span>

                        </div>

                    </div>


                    <div class="col-12">

                        <div class="d-flex align-items-center">

                            <i class="align-middle me-2"
                               data-lucide="calendar">
                            </i>

                            <span>
                                @Model.RequestedDate
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>