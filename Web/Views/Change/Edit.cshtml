@model Domain.Change

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="pencil"></i>
                    Change Request
                </h5>

                <a href="@Url.Action("Plan", "Change")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Edit", "Change", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.ChangeId)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.AssetTypeId)
                            </label>

                            <div class="form-control-plaintext">
                                @Model.AssetType.AssetTypeName
                            </div>

                            @Html.HiddenFor(model => model.AssetType.AssetTypeName)

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.ChangeRequestTypeId)
                            </label>

                            <div class="form-control-plaintext">
                                @Model.ChangeRequestType.ChangeRequestTypeName
                            </div>

                            @Html.HiddenFor(model => model.ChangeRequestType.ChangeRequestTypeName)

                        </div>

                        <div class="col-12">

                            @Html.LabelFor(
                                model => model.Subject,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.Subject,
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Subject,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-12">

                            @Html.LabelFor(
                                model => model.Description,
                                new { @class = "form-label" }
                            )

                            @Html.TextAreaFor(
                                model => model.Description,
                                new
                                {
                                    @class = "form-control",
                                    rows = "4"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Description,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.ChangeType,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.ChangeType,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.Priority,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.Priority,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.Risk,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.Risk,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                        </div>

                        <div class="col-md-3">

                            @Html.LabelFor(
                                model => model.StartDate,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.StartDate,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.StartDate,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-3">

                            @Html.LabelFor(
                                model => model.EndDate,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.EndDate,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.EndDate,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-danger btn-sm">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary btn-sm btnSumbitDisable">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>

@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

}