@using Service
@model IEnumerable<Domain.Change>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "Change", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="search"></i>
                        Changes
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label for="AssetCategoryId" class="form-label">
                                Asset Category
                            </label>

                            <select id="AssetCategoryId"
                                    name="AssetCategoryId"
                                    class="form-select">
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="AssetCategoryId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="AssetTypeId" class="form-label">
                                Asset Type
                            </label>

                            <select id="AssetTypeId"
                                    name="AssetTypeId"
                                    class="form-select">
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="AssetTypeId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="ChangeRequestTypeId" class="form-label">
                                Request Type
                            </label>

                            <select id="ChangeRequestTypeId"
                                    name="ChangeRequestTypeId"
                                    class="form-select">
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="ChangeRequestTypeId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="StatusId" class="form-label">
                                Status
                            </label>

                            @Html.DropDownList(
                                "StatusId",
                                EnumHelper.GetSelectList(typeof(Domain.ChangeStatusEnum)),
                                "-- All --",
                                new { @class = "form-select" }
                            )

                            <span class="text-danger"
                                  data-valmsg-for="StatusId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="StartDate" class="form-label">
                                Requested Date From
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="StartDate"
                                   value="@ViewBag.StartDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-3">

                            <label for="EndDate" class="form-label">
                                Requested Date To
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="EndDate"
                                   value="@ViewBag.EndDate"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>
                                <tr>
                                    <th>Change</th>
                                    <th>Asset Category</th>
                                    <th>Asset Type</th>
                                    <th>Request Type</th>
                                    <th>Subject</th>
                                    <th>Change Type</th>
                                    <th>Priority</th>
                                    <th>Risk</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "Info", "Change", "", new { id = item.ChangeId }, null)"
                                               target="_blank">

                                                Change @item.ChangeId

                                            </a>

                                        </td>

                                        <td>
                                            @item.AssetType.AssetCategory.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.AssetType.AssetTypeName
                                        </td>

                                        <td>
                                            @item.ChangeRequestType.ChangeRequestTypeName
                                        </td>

                                        <td>
                                            @item.Subject
                                        </td>

                                        <td>
                                            @item.ChangeType.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.Priority.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.Risk.EnumDisplayName()
                                        </td>

                                        <td>

                                            <span class="badge bg-@ChangeService.GetStatusColor(item.Status)">
                                                @item.Status.EnumDisplayName()
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

            loadAssetCategory();
            loadChangeRequestType();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.AssetCategoryId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    loadAssetType();

                }
            );

        }


        $("#AssetCategoryId").on("change", function () {

            loadAssetType();

        });


        function loadAssetType() {

            var categoryId =
                $("#AssetCategoryId").val();

            $.getJSON(
                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',
                {
                    assetCategory: categoryId
                },
                function (data) {

                    var dropDown =
                        $("#AssetTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.AssetTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadChangeRequestType() {

            $.getJSON(
                '@Url.Action("GetChangeRequestTypeListJsonResult", "ChangeRequestType")',
                function (data) {

                    var dropDown =
                        $("#ChangeRequestTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.ChangeRequestTypeId,
                                    text: item.ChangeRequestTypeName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.ChangeRequestTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}