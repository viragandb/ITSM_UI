@model Web.Models.MyAssetsVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <ul class="nav nav-pills card-header-pills" role="tablist">

                    <li class="nav-item" role="presentation">
                        <a class="nav-link active"
                           href="#tab_Pending"
                           data-bs-toggle="tab"
                           role="tab"
                           aria-selected="true">

                            <i class="align-middle me-1" data-lucide="clock"></i>
                            Pending

                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_Assets"
                           data-bs-toggle="tab"
                           role="tab"
                           aria-selected="false">

                            <i class="align-middle me-1" data-lucide="boxes"></i>
                            Assets

                        </a>
                    </li>

                </ul>

            </div>

            <div class="card-body">

                <div class="tab-content">

                    <div class="tab-pane fade show active"
                         id="tab_Pending"
                         role="tabpanel">

                        <div id="accordion">

                            @foreach (var item in Model.AssetTransferRequests)
                            {
                                var collapseId = "G_" + item.AssetTransferRequestId;

                                <div class="card mb-3">

                                    <div class="card-header">

                                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">

                                            <div>

                                                <a href="#@collapseId"
                                                   data-bs-toggle="collapse"
                                                   class="text-body text-decoration-none fw-semibold collapsed"
                                                   aria-expanded="false"
                                                   aria-controls="@collapseId">

                                                    <i class="align-middle me-1" data-lucide="file-text"></i>

                                                    #@item.AssetTransferRequestId

                                                </a>

                                                <span class="ms-2 text-muted">

                                                    @item.BranchFrom.Name
                                                    -
                                                    @item.DepartmentFrom.DepartmentName

                                                    <i class="align-middle mx-1" data-lucide="chevrons-right"></i>

                                                    @item.Branch.Name
                                                    -
                                                    @item.Department.DepartmentName

                                                </span>

                                            </div>

                                            <span class="badge bg-@AssetTransferRequestService.GetTransTypeColor(item.TransactionType)">
                                                @item.TransactionType.EnumDisplayName()
                                            </span>

                                        </div>

                                    </div>

                                    <div id="@collapseId"
                                         class="collapse"
                                         data-bs-parent="#accordion">

                                        <div class="card-body">

                                            @Html.Partial("~/Views/AssetTransaction/_Min.cshtml", item)

                                        </div>

                                        <div class="card-footer">

                                            <div class="d-flex justify-content-end">

                                                <button type="button"
                                                        data-id="@item.AssetTransferRequestId"
                                                        data-code="@item.AssetTransferRequestId"
                                                        class="openModalUpdate btn btn-success btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalUpdate">

                                                    <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                                                    Accept

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>


                    <div class="tab-pane fade"
                         id="tab_Assets"
                         role="tabpanel">

                        <div class="table-responsive">

                            <table id="dataTable"
                                   class="table table-striped table-hover align-middle w-100">

                                <thead>
                                    <tr>
                                        <th>Asset No</th>
                                        <th>Asset Category</th>
                                        <th>Asset Type</th>
                                        <th>Make</th>
                                        <th>Model</th>
                                        <th>Serial No</th>
                                        <th>Barcode</th>
                                        <th>Branch</th>
                                        <th>Department</th>
                                        <th>Description</th>
                                        <th>Owned By</th>
                                        <th>To Be Returned Date</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.Assets)
                                    {
                                        <tr>

                                            <td>
                                                @item.AssetNo
                                            </td>

                                            <td>
                                                @item.AssetCategory.EnumDisplayName()
                                            </td>

                                            <td>
                                                @item.AssetType.AssetTypeName
                                            </td>

                                            <td>
                                                @item.AssetMake.Name
                                            </td>

                                            <td>
                                                @item.ModelName
                                            </td>

                                            <td>
                                                @item.SerialNo
                                            </td>

                                            <td>
                                                @item.Barcode
                                            </td>

                                            <td>
                                                @item.Branch.Name
                                            </td>

                                            <td>
                                                @item.Department.DepartmentName
                                            </td>

                                            <td>
                                                @item.Description
                                            </td>

                                            <td>
                                                @item.AllocatedType.EnumDisplayName()
                                            </td>

                                            <td>

                                                @if (item.AllocatedType == Domain.AllocatedTypeEnum.External)
                                                {
                                                    @item.ToBeReturnedDate.ToShortDateString()
                                                }
                                                else
                                                {
                                                    <span>N/A</span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>


<div class="modal fade"
     id="modalUpdate"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    #<span id="updateModalRequestId"></span> Accept
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="updateRequestId"
                       value="" />

                <div class="mb-3">

                    <label for="updateComment"
                           class="form-label">
                        Comment
                    </label>

                    <textarea id="updateComment"
                              class="form-control"
                              rows="3"
                              placeholder="Enter comment"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-success btn-sm btnClickDisable"
                        onclick="updateRequest()">

                    <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                    Accept

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.DataTable) {

                $("#dataTable").DataTable({
                    responsive: true,
                    lengthChange: false,
                    autoWidth: false,
                    paging: false
                });

            }

        });


        $(document).on("click", ".openModalUpdate", function () {

            var requestId =
                $(this).data("id");

            var code =
                $(this).data("code");


            $("#updateRequestId")
                .val(requestId);

            $("#updateModalRequestId")
                .text(code);

            $("#updateComment")
                .val("");

            $("#modalUpdate .btnClickDisable")
                .prop("disabled", false);

        });


        function updateRequest() {

            var requestId =
                $("#updateRequestId").val();

            var comment =
                $("#updateComment").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error!",
                    "Please enter the comment",
                    "error"
                );

                return;

            }


            $("#modalUpdate .btnClickDisable")
                .prop("disabled", true);


            $.ajax({

                url: '@Url.Action("Accept", "Asset")',

                type: "GET",

                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment.trim()
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        $("#modalUpdate .btnClickDisable")
                            .prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#modalUpdate .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }

    </script>

}