@model Domain.AR.PhysicalArea

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title m-0">Physical Area Details</h3>
                <div class="text-right">

                    <a href="@Url.Action("Index", "PhysicalArea")" class="btn btn-sm btn-default">
                        <i class="fas fa-arrow-left"></i>&nbsp;&nbsp;Back
                    </a>

                </div>

            </div>


            @using (Html.BeginForm("Edit", "PhysicalArea", FormMethod.Post, new { @class = "form-horizontal" }))
            {

                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.PhysicalAreaId)


                <div class="card-body">

                    <div class="form-group row">
                        @Html.LabelFor(model => model.BranchId, new { @class = "col-md-2 col-form-label" })
                        <div class="col-md-4">
                            <select id="BranchId" name="BranchId" class="form-control form-control-sm"></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        @Html.LabelFor(model => model.Name, new { @class = "col-sm-2 col-form-label" })
                        <div class="col-md-6">
                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control form-control-sm" })
                            @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <div class="text-right">

                        <button type="reset" class="btn btn-sm btn-danger"><i class="fas fa-undo"></i>&nbsp;Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-save"></i>&nbsp;Save</button>

                    </div>
                </div>
            }
        </div>
    </div>
</div>


@section scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            loadLocations();
        });

          function loadLocations() {
            $.getJSON("@Url.Action("GetItemListJsonResult", "Branch")", function (data) {
                var dropDown = $("#BranchId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.BranchId }).html(optionaldata.Name));
                });
                 if ('@ViewBag.BranchId') {
                     $('#BranchId').val('@ViewBag.BranchId').attr("selected", "selected");
            }
            });
        }





    </script>

}





