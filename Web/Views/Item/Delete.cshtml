@model Domain.Item

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="trash-2"></i>
                    Delete Item
                </h5>

                <a href="@Url.Action("Index", "Item")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            <div class="card-body">

                <div class="alert alert-warning d-flex align-items-center" role="alert">

                    <i class="align-middle me-2" data-lucide="triangle-alert"></i>

                    <div>
                        Are you sure you want to delete this item?
                    </div>

                </div>

                <dl class="row mb-0">

                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.Company.CompanyName)
                    </dt>

                    <dd class="col-md-9">
                        @Html.DisplayFor(model => model.Company.CompanyName)
                    </dd>


                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.Location.LocationName)
                    </dt>

                    <dd class="col-md-9">
                        @Html.DisplayFor(model => model.Location.LocationName)
                    </dd>


                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.ItemName)
                    </dt>

                    <dd class="col-md-9">
                        @Html.DisplayFor(model => model.ItemName)
                    </dd>


                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.ItemSerialNo)
                    </dt>

                    <dd class="col-md-9">
                        @Html.DisplayFor(model => model.ItemSerialNo)
                    </dd>


                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.ItemBarCode)
                    </dt>

                    <dd class="col-md-9">
                        @Html.DisplayFor(model => model.ItemBarCode)
                    </dd>


                    <dt class="col-md-3">
                        @Html.DisplayNameFor(model => model.ItemModelNo)
                    </dt>

                    <dd class="col-md-9 mb-0">
                        @Html.DisplayFor(model => model.ItemModelNo)
                    </dd>

                </dl>

            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <a href="@Url.Action("Index", "Item")"
                           class="btn btn-sm btn-light">

                            <i class="align-middle me-1" data-lucide="arrow-left"></i>
                            Back to List

                        </a>

                        <button type="submit"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="trash-2"></i>
                            Delete

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>