@using Service
@model IEnumerable<Domain.DeptBranch>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("DeptBranch", "Department", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="building-2"></i>
                        Assign Branch
                    </h5>

                    <a href="@Url.Action("AssignBranch", "Department")"
                       class="btn btn-sm btn-primary">

                        <i class="align-middle me-1" data-lucide="plus"></i>
                        Add New

                    </a>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="DepartmentId" class="form-label">
                                Department
                            </label>

                            <select id="DepartmentId"
                                    name="DepartmentId"
                                    class="form-select select2">

                                <option value=""></option>

                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="DepartmentId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-info">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="list"></i>
                    Assigned Branches
                </h5>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle w-100">

                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @(item.Branch != null ? item.Branch.Name : "N/A")
                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                onclick="deleteItem('@item.DeptBranchId')"
                                                title="Delete">

                                            <i class="align-middle" data-lucide="trash-2"></i>

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            $("#DepartmentId").select2({
                width: "100%"
            });

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

            loadDepartments();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadDepartments() {

            $.getJSON(
                '@Url.Action("GetItemsJsonResult", "Department")',
                function (data) {

                    var dropDown = $("#DepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    $("#DepartmentId option[value='1']").remove();

                    var selectedId = '@ViewBag.DepartmentId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    dropDown.trigger("change.select2");

                }
            );

        }


        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("DeleteDeptBranch", "Department")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted, Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted, Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}