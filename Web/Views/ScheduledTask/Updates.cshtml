


@model IEnumerable<Domain.TaskUpdate>
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}


@using (Html.BeginForm("Updates", "ScheduledTask", FormMethod.Get, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="col-md-12">
            <div class="card box-danger">
                <div class="card-header with-border">
                    <h3 class="card-title">Tasks</h3>

                </div>


                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12">

                            <div class="form-group">

                                <label class="control-label col-md-2">
                                    Team :
                                </label>
                                <div class="col-md-4">
                                    <select id="TeamId" name="TeamId" class="form-control">
                                        <option value=""></option>
                                    </select>
                                </div>
                                <label class="control-label col-md-2">
                                    Category :
                                </label>
                                <div class="col-md-4">
                                    <select id="TaskCategoryId" name="TaskCategoryId" class="form-control">
                                        <option value=""></option>
                                    </select>
                                </div>

                            </div>
                            <div class="form-group">

                                <label class="control-label col-md-2">
                                    Assigned To :
                                </label>
                                <div class="col-md-6">
                                    <select id="AssignedTo" name="AssignedTo" class="form-control">
                                        <option value=""></option>
                                    </select>
                                </div>

                            </div>

                            <div class="form-group">


                                <label class="control-label col-md-2">
                                    Review By :
                                </label>
                                <div class="col-md-6">
                                    <select id="ReviewBy" name="ReviewBy" class="form-control">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>


                            <div class="form-group">

                                <label class="control-label col-md-2">
                                    Task Date :
                                </label>
                                <div class="col-md-2">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" name="StartDate" id="StartDate" value="@ViewBag.StartDate" autocomplete="off" class="form-control datepicker" />
                                    </div>
                                </div>


                                <label class="control-label col-md-1">
                                    To
                                </label>
                                <div class="col-md-2">
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" name="EndDate" id="EndDate" value="@ViewBag.EndDate" autocomplete="off" class="form-control datepicker" />
                                    </div>
                                </div>

                                <label class="control-label col-md-1">
                                    Status :
                                </label>
                                <div class="col-md-4">
                                    <select id="StatusId" name="StatusId" class="form-control">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="StatusId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <div class="text-right">
                        <button type="submit" class="btn btn-social">
                            <i class="fa fa-search"></i>Search
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>



    <div class="row">

        <div class="col-md-12">
            <div class="card box-default">
                <div class="card-body">

                    <table id="dataTable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Due Date</th>
                                <th>Task Name</th>
                                <th>Category</th>
                                <th>Task User</th>
                                <th>Reviewer</th>
                                <th>Repeat </th>
                                <th>Score </th>
                                <th>User Comment </th>
                                <th>Reviewer Comment </th>
                                <th>Status </th>
                                <th>Updated Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var item in Model)
                                {
                            <tr>
                                <td>@item.TaskDate.ToShortDateString()</td>
                                <td>

                                    <a href="@Html.EncodedActionLink("", "TaskInfo", "ScheduledTask", "", new { id = item.ScheduledTask.ScheduledTaskId }, null)" target="_blank" class="t">
                                        @item.ScheduledTask.ScheduledTaskId -
                                        @item.ScheduledTask.TaskName
                                    </a>

                                </td>

                                <td>@item.ScheduledTask.TaskCategory.TaskCategoryName</td>
                                <td>@item.ScheduledTask.User.FullName</td>
                                <td>@item.ScheduledTask.Reviewer.FullName</td>


                                <td>
                                    <span class="label text- label-@ScheduledTaskService.GetTaskRepeatTypeColor(@item.ScheduledTask.RepeatType)">
                                        @item.ScheduledTask.RepeatType.EnumDisplayName()
                                    </span>
                                </td>
                                <td>@item.AllocatedScore</td>
                                <td>@item.Comment</td>
                                <td>@item.ReviewerComment</td>
                                <td>

                                    <span class="label text- label-@ScheduledTaskService.GetTaskStatusColor(@item.Status)">
                                        @item.Status.EnumDisplayName()
                                    </span>
                                    @if (@item.IsDelayed)
                                    {
                                        <span class="label text- label-danger"> Delayed</span>
                                    }
                                </td>
                                <td>@item.UpdatedDate</td>

                            </tr>
                                }
                            }
                        </tbody>

                    </table>

                </div>
                <!-- /.box-body -->

            </div>

        </div>
    </div>

}

@section scripts {


    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            $('#dataTable').DataTable({
                "paging": false,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": true
            });

            loadCategory();
            loadTeams();
            loadStatus();
        });


        $("select#TeamId").change(function (evt) {
            loadUsers();
            loadCategory();
        });

        function loadTeams() {

            $.getJSON("@Url.Action("GetTeamUserListJsonResult", "Team")", function (data) {
                var dropDown = $("#TeamId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.TeamId }).html(optionaldata.TeamName));
                });

                if ('@ViewBag.TeamId') {
                      $('#TeamId').val(@ViewBag.TeamId).attr("selected", "selected");
                 }

                loadUsers();
                loadCategory();
            });

        }

         function loadUsers() {
             var _teamId = $('#TeamId').val();

            $.getJSON("@Url.Action("GetUsersByTeamIdJsonResult", "User")",
              {
                  teamId: _teamId
              }, function (data) {
                  var dropDown = $("#AssignedTo");
                  dropDown.empty();
                  dropDown.append("<option value='0'>-- All --</option>");

                  var dropDown2 = $("#ReviewBy");
                  dropDown2.empty();
                  dropDown2.append("<option value='0'>-- All --</option>");

                  $.each(JSON.parse(data), function (index, optionaldata) {
                      dropDown.append($('<option/>', { value: optionaldata.EmpNo }).html(optionaldata.EmpNo + ' - ' +optionaldata.FullName + ' (' + optionaldata.DesignationName + ')' ));
                      dropDown2.append($('<option/>', { value: optionaldata.EmpNo }).html(optionaldata.EmpNo + ' - ' + optionaldata.FullName + ' (' + optionaldata.DesignationName + ')'));
                  });

                   if ('@ViewBag.AssignedTo') {
                       $('#AssignedTo').val(@ViewBag.AssignedTo).attr("selected", "selected");
                  }


                   if ('@ViewBag.ReviewBy') {
                       $('#ReviewBy').val(@ViewBag.ReviewBy).attr("selected", "selected");
                 }

              });
        }


          function loadCategory() {
              var _teamId = $('#TeamId').val();

              $.getJSON("@Url.Action("GetTaskCategoriesListJsonResult", "TaskCategory")",
                  {
                      teamId: _teamId

                  }, function (data) {
                var dropDown = $("#TaskCategoryId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.TaskCategoryId }).html(optionaldata.TaskCategoryName + ' ( ' + optionaldata.Weightage + '% ) ' ));
                });

                if ('@ViewBag.TaskCategoryId') {
                    $('#TaskCategoryId').val(@ViewBag.TaskCategoryId).attr("selected", "selected");
                 }


            });

        }

         function loadStatus() {

            $.getJSON("@Url.Action("GetStatusJsonResult", "ScheduledTask")", function (data) {
                var dropDown = $("#StatusId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });


                if ('@ViewBag.StatusId') {
                    $('#StatusId').val(@ViewBag.StatusId).attr("selected", "selected");
                 }
            });

        }

    </script>

}



