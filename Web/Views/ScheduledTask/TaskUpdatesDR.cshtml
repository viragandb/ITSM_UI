@model Domain.ScheduledTask
@using Service
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card box-danger">
            <div class="card-header with-border">
                <h3 class="card-title">Task  </h3>
                @*<div class="card-tools pull-right">
                    <a href="@Url.Action("ReviewPending", "ScheduledTask")" class="btn btn-social btn-cancel">
                        <i class="fa fa-arrow-left"></i>Back
                    </a>
                </div>*@
            </div>

            @using (Html.BeginForm("TaskReview", "ScheduledTask", FormMethod.Post, new { @class = "form-horizontal" }))
            {

                @Html.HiddenFor(model => model.ScheduledTaskId)

                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-12">
                            @Html.Partial("_ScheduledTask", Model)

                        </div>
                    </div>
                    <div class="row">

                        <div class="col-lg-12 ">
                            <div class="card">
                                <div class="card-header with-border">
                                    <h3 class="card-title">Task Updates </h3>
                                    <div class="card-tools pull-right">

                                        <button type="button" class="btn btn-box-tool" data-widget="collapse" data-bs-toggle="tooltip" title="" data-original-title="Collapse">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body">

                                    <table id="dataTable" class="table table-bordered table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Due Date</th>
                                                <th>User Comment </th>
                                                <th>Reviewer Comment </th>
                                                <th>Status </th>
                                                <th>Updated By</th>
                                                <th>Updated Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                foreach (var item in Model.TaskUpdates)
                                                {
                                            <tr>
                                                <td>@item.TaskDate.ToShortDateString()</td>

                                                <td>@item.Comment</td>
                                                <td>@item.ReviewerComment</td>
                                                <td>

                                                    <span class="label text- label-@ScheduledTaskService.GetTaskStatusColor(@item.Status)">
                                                        @item.Status.EnumDisplayName()
                                                    </span>
                                                    @if (@item.IsDelayed)
                                                    {
                                                        <span class="label text- label-danger"> Delayed</span>
                                                    }
                                                </td>
                                                <td>@item.UpdatedBy</td>
                                                <td>@item.UpdatedDate</td>

                                            </tr>
                                                }
                                            }
                                        </tbody>

                                    </table>

                                </div>
                                @*<div class="card-footer">
                                    <div class="text-right">
                                        <button type="submit" class="btn btn-sm btn-social btn-default btnSumbitDisable"><i class="fa fa-floppy-o"></i>Update</button>
                                    </div>
                                </div>*@
                            </div>

                        </div>

                    </div>





                </div>

            }
        </div>
        <!-- /.box -->
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

}