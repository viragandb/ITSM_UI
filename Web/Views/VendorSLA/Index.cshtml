@using Service
@model IEnumerable<Domain.VendorSLA>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "VendorSLA", FormMethod.Post))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="clock"></i>
                        Vendor SLA
                    </h5>

                    <a href="@Url.Action("Create", "VendorSLA")"
                       class="btn btn-sm btn-primary">

                        <i class="align-middle me-1" data-lucide="plus"></i>
                        Add New

                    </a>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="VendorId"
                                   class="form-label">
                                Vendor
                            </label>

                            <select id="VendorId"
                                    name="VendorId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1"
                               data-lucide="search"></i>

                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Vendor</th>
                                <th>Asset Type</th>
                                <th>SLA (Hrs.)</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @(item.Vendor != null
                                            ? item.Vendor.VendorName
                                            : "N/A")
                                    </td>

                                    <td>
                                        @(item.AssetType != null
                                            ? item.AssetType.AssetTypeName
                                            : "N/A")
                                    </td>

                                    <td>
                                        @item.SLA
                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <a href="@Url.Action("Edit", "VendorSLA", new { id = item.VendorSLAId })"
                                           class="btn btn-sm btn-primary"
                                           title="Edit">

                                            <i class="align-middle"
                                               data-lucide="pencil"></i>

                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Delete"
                                                onclick="deleteItem('@item.VendorSLAId')">

                                            <i class="align-middle"
                                               data-lucide="trash-2"></i>

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

            loadVendors();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadVendors() {

            var dropDown = $("#VendorId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- All --</option>"
            );


            $.getJSON(
                '@Url.Action("GetVendorListJsonResult", "Vendor")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.VendorId,
                                    text: item.VendorName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.VendorId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "VendorSLA")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted. Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted. Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}