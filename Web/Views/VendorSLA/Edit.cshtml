@model Domain.VendorSLA
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="clock"></i>
                    Vendor SLA
                </h5>

                <a href="@Url.Action("Index", "VendorSLA")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Edit", "VendorSLA", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.VendorSLAId)
                @Html.HiddenFor(model => model.VendorId)

                if (Model.Vendor != null)
                {
                    @Html.HiddenFor(model => model.Vendor.VendorName)
                }

                @Html.HiddenFor(model => model.AssetTypeId)

                if (Model.AssetType != null)
                {
                    @Html.HiddenFor(model => model.AssetType.AssetTypeName)
                }

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.VendorId)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @(Model.Vendor != null
                                    ? Model.Vendor.VendorName
                                    : "N/A")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.AssetTypeId)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @(Model.AssetType != null
                                    ? Model.AssetType.AssetTypeName
                                    : "N/A")
                            </div>

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.SLA,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.SLA,
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.SLA,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>