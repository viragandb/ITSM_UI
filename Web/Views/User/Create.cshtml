@model Domain.User

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .ui-autocomplete {
        z-index: 1060;
        max-height: 300px;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        padding: .25rem;
    }

    .ui-menu {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ui-menu-item-wrapper {
        padding: .5rem .75rem;
        cursor: pointer;
        border-radius: .25rem;
    }

    .ui-state-active {
        background: var(--bs-primary);
        color: #fff;
        border: 0;
    }
</style>

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="user-plus"></i>
                    Create New
                </h5>

                <a href="@Url.Action("Index", "User")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Create", "User", FormMethod.Post))
            {
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label for="EmployeeName"
                                   class="form-label">
                                Employee Name
                            </label>

                            <input type="text"
                                   id="EmployeeName"
                                   name="EmployeeName"
                                   placeholder="Type here to search"
                                   class="form-control" />

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.EmpNo,
                                new { @class = "form-label" }
                            )

                            <div class="input-group">

                                @Html.TextBoxFor(
                                    model => model.EmpNo,
                                    new { @class = "form-control" }
                                )

                                <button type="submit"
                                        name="action:EmpNoSearch"
                                        class="btn btn-primary">

                                    <i class="align-middle me-1"
                                       data-lucide="search"></i>

                                    Search

                                </button>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.FullName)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.FullName
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.ContactNo)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.ContactNo
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.DesignationName)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.DesignationName
                            </div>

                        </div>


                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.BranchId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.BranchId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.BranchId,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.Email)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.Email
                            </div>

                        </div>


                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.DepartmentId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.DepartmentId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.DepartmentId,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.ProImageName))
                        {
                            <div class="col-md-6">

                                <label class="form-label d-block">
                                    Profile Image
                                </label>

                                <img src="@Model.ProImageName"
                                     class="rounded border"
                                     style="width:150px; max-width:100%;"
                                     alt="User Image" />

                            </div>
                        }

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                name="action:Save"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            $(".select2").select2({
                width: "100%"
            });

            searchADUser();
            loadBranches();

            $("#BranchId").on("change", function () {
                loadToDepartments();
            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function searchADUser() {

            $("#EmployeeName").autocomplete({

                source: function (request, response) {

                    $.ajax({

                        url: '@Url.Action("GetSearchUserByNameJsonResult", "User")',

                        dataType: "json",

                        data: {
                            term: request.term
                        },

                        success: function (data) {

                            var items = parseJsonResult(data);

                            response(
                                $.map(items, function (item) {

                                    return {

                                        label:
                                            item.FullName +
                                            " - " +
                                            item.DesignationName +
                                            " | " +
                                            item.DepartmentName,

                                        value:
                                            item.FullName +
                                            " - " +
                                            item.DesignationName +
                                            " | " +
                                            item.DepartmentName,

                                        itemId: item.EmpNo
                                    };

                                })
                            );

                        }

                    });

                },

                minLength: 1,

                select: function (event, ui) {

                    $("#EmpNo").val(ui.item.itemId);

                }

            });

        }


        function loadBranches() {

            var dropDown =
                $("#BranchId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.BranchId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    dropDown.trigger("change.select2");

                    loadToDepartments();

                }
            );

        }


        function loadToDepartments() {

            var branchId =
                $("#BranchId").val();

            var dropDown =
                $("#DepartmentId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            if (!branchId || branchId == "0") {

                dropDown.trigger("change.select2");

                return;
            }


            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.DepartmentId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    dropDown.trigger("change.select2");

                }
            );

        }

    </script>
}