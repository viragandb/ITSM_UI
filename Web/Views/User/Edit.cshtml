@model Domain.User

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="user"></i>
                    User Details
                </h5>

                <a href="@Url.Action("Index", "User")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Edit", "User", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.EmpNo)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.EmpNo)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.EmpNo
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.FullName)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.FullName
                            </div>

                            @Html.HiddenFor(model => model.FullName)

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.Email)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.Email
                            </div>

                            @Html.HiddenFor(model => model.Email)

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.ContactNo)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.ContactNo
                            </div>

                            @Html.HiddenFor(model => model.ContactNo)

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.DesignationName)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.DesignationName
                            </div>

                            @Html.HiddenFor(model => model.DesignationName)

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.UserStatus,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.UserStatus,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.UserStatus,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.BranchId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.BranchId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.BranchId,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.DepartmentId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.DepartmentId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.DepartmentId,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $(".select2").select2({
                width: "100%"
            });

            loadBranches();

            $("#BranchId").on("change", function () {
                loadToDepartments();
            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadBranches() {

            var dropDown = $("#BranchId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.BranchId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    dropDown.trigger("change.select2");

                    loadToDepartments();

                }
            );

        }


        function loadToDepartments() {

            var branchId = $("#BranchId").val();

            var dropDown = $("#DepartmentId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            if (!branchId || branchId == "0") {

                dropDown.trigger("change.select2");

                return;
            }


            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.DepartmentId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    dropDown.trigger("change.select2");

                }
            );

        }

    </script>
}