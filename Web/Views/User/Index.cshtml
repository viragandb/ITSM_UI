@model IEnumerable<Domain.User>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="users"></i>
                    Users
                </h5>

                <a href="@Url.Action("Create", "User")"
                   class="btn btn-sm btn-primary">

                    <i class="align-middle me-1" data-lucide="plus"></i>
                    Add New

                </a>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="dataTable"
                           class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Emp. #</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Branch</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Last Active</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.EmpNo
                                    </td>

                                    <td>
                                        @item.FullName
                                    </td>

                                    <td>
                                        @(item.Department != null
                                            ? item.Department.DepartmentName
                                            : "N/A")
                                    </td>

                                    <td>
                                        @item.DesignationName
                                    </td>

                                    <td>
                                        @(item.Branch != null
                                            ? item.Branch.Name
                                            : "N/A")
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @item.UserStatus
                                    </td>

                                    <td>
                                        @item.LastActiveDate
                                    </td>

                                    <td>
                                        @item.UpdatedBy
                                    </td>

                                    <td>
                                        @item.UpdatedDate
                                    </td>

                                    <td class="text-end">

                                        <a href="@Url.Action("Edit", "User", new { empNo = item.EmpNo })"
                                           class="btn btn-sm btn-primary"
                                           title="Edit">

                                            <i class="align-middle"
                                               data-lucide="pencil"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        function updateUser(itemId) {

            $.ajax({

                url: '@Url.Action("Update", "User")',

                type: "GET",

                dataType: "json",

                data: {
                    empNo: itemId
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Updated",
                            "User has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 100);

                    }
                    else {

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("Delete", "User")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted. Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted. Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }


        $(document).ready(function () {

            $("#dataTable").DataTable({
                responsive: true,
                autoWidth: false,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true
            });

        });

    </script>
}