@using Service
@model IEnumerable<Domain.GRNote>
@{
    /**/

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("GRNStockIn", "Report", FormMethod.Get, new { @class = "form-horizontal" }))
{

    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header with-border">
                    <h3 class="card-title">GRNs</h3>

                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">

                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Vendor :
                                        </label>
                                        <select id="VendorId" name="VendorId" class="form-control form-control-sm select2">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label"> GRN Number </label>
                                        <input type="text" id="GRNNo" name="GRNNo" value="@ViewBag.GRNNo" class="form-control form-control-sm" />

                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label"> PO Number </label>
                                        <input type="text" id="PONo" name="PONo" value="@ViewBag.PONo" class="form-control form-control-sm" />

                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label"> Invoice Number </label>
                                        <input type="text" id="InvoiceNo" name="InvoiceNo" value="@ViewBag.InvoiceNo" class="form-control form-control-sm" />

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Received Date :
                                        </label>
                                        <div class="input-group date datePicker" id="start_date" data-bs-target-input="nearest">
                                            <input type="text" name="StartDate" id="StartDate" value="@ViewBag.StartDate" class="form-control form-control-sm datetimepicker-input" />
                                            <div class="input-group-append" data-bs-target="#start_date" data-bs-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            To :
                                        </label>
                                        <div class="input-group date datePicker" id="end_date" data-bs-target-input="nearest">
                                            <input type="text" name="EndDate" id="EndDate" value="@ViewBag.EndDate" class="form-control form-control-sm datetimepicker-input" />
                                            <div class="input-group-append" data-bs-target="#end_date" data-bs-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>


                        </div>
                    </div>


                </div>
                <div class="card-footer">
                    <div class="text-right">
                        <button type="submit" class="btn btn-sm btn-default">
                            <i class="fa fa-search mr-2"></i>Search
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card box-default">
                <div class="card-body">

                    <table id="dataTable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>GRN Number</th>
                                <th>PO Number</th>
                                <th>Invoice Number</th>
                                <th>Purchase Date</th>
                                <th>Received Date</th>
                                <th>Vendor</th>
                                <th>Updated By</th>
                                <th>Updated Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>

                                            <a href="@Html.EncodedActionLink("","GRNInfo", "Asset","", new { id = item.GRNoteId },null)" target="_blank">
                                                @item.GRNNumber
                                            </a>
                                        </td>
                                        <td>@item.PONumber</td>
                                        <td>@item.InvoiceNumber</td>
                                        <td>@item.PurchaseDate.ToShortDateString()</td>
                                        <td>@item.ReceivedDate.ToShortDateString()</td>
                                        <td>@item.Vendor.VendorName</td>
                                        <td>@item.UpdatedBy</td>
                                        <td>@item.UpdatedDate</td>
                                    </tr>

                                }
                            }
                        </tbody>

                    </table>

                </div>
            </div>
        </div>
    </div>


}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            $("#dataTable").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false, "paging": false,
                /* "buttons": ["excel", "pdf", "print", "colvis"]*/
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: 'ITSM - Assets',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    , {
                        extend: 'pdfHtml5',
                        text: ' PDF',
                        title: 'ITSM - Assets',
                        orientation: 'landscape',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    , {
                        extend: 'print',
                        text: '<i class="fa fa-print"></i>',
                        title: 'ITSM - Assets',
                        autoPrint: true
                    }
                    ,
                    "colvis"
                ]
            }).buttons().container().appendTo('#dataTable_wrapper .col-md-6:eq(0)');

            loadVendor();
        });

        function loadVendor() {
            $.getJSON("@Url.Action("GetVendorListJsonResult", "Vendor")", function (data) {
                var dropDown = $("#VendorId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.VendorId }).html(optionaldata.VendorName));
                });

                 if ('@ViewBag.VendorId') {
                     $('#VendorId').val('@ViewBag.VendorId').attr("selected", "selected");
                }

            });
        }
    </script>



}





