@using Service
@model IEnumerable<Domain.TransferItem>
@{
    /**/

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("GatePass", "Report", FormMethod.Get, new { @class = "form-horizontal" }))
{

    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header with-border">
                    <h3 class="card-title">Transactions</h3>

                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Location :
                                        </label>
                                        <select id="BranchId" name="BranchId" class="form-control form-control-sm select2">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Department :
                                        </label>
                                        <select id="DepartmentId" name="DepartmentId" class="form-control form-control-sm select2">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Transaction Type :
                                        </label>
                                        <select id="TransactionTypeId" name="TransactionTypeId" class="form-control form-control-sm select2">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Status :
                                        </label>
                                        <select id="StatusId" name="StatusId" class="form-control form-control-sm select2">
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            Initiated Date :
                                        </label>
                                        <div class="input-group date datePicker" id="start_date" data-bs-target-input="nearest">
                                            <input type="text" name="StartDate" id="StartDate" value="@ViewBag.StartDate" class="form-control form-control-sm datetimepicker-input" />
                                            <div class="input-group-append" data-bs-target="#start_date" data-bs-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-3">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            To :
                                        </label>
                                        <div class="input-group date datePicker" id="end_date" data-bs-target-input="nearest">
                                            <input type="text" name="EndDate" id="EndDate" value="@ViewBag.EndDate" class="form-control form-control-sm datetimepicker-input" />
                                            <div class="input-group-append" data-bs-target="#end_date" data-bs-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>


                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="text-right">
                        <button type="submit" class="btn btn-sm btn-default">
                            <i class="fa fa-search mr-2"></i>Search
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card box-default">
                <div class="card-body">

                    <table id="dataTable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Serial No</th>
                                <th>Asset No</th>
                                <th>Barcode</th>
                                <th>Ref #</th>
                                <th>From Location</th>
                                <th>From Department</th>
                                <th>To Location</th>
                                <th>To Department</th>
                                <th>Transaction Type</th>
                                <th>Assigned Type</th>
                                <th>DAO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Asset.SerialNo</td>
                                        <td>@item.Asset.AssetNo</td>
                                        <td>@item.Asset.Barcode</td>
                                        <td>@item.AssetTransferRequest.AssetTransferRequestId</td>
                                        <td>@item.AssetTransferRequest.BranchFrom.Name</td>
                                        <td>@item.AssetTransferRequest.DepartmentFrom.DepartmentName</td>
                                        <td>@item.AssetTransferRequest.Branch.Name</td>
                                        <td>@item.AssetTransferRequest.Department.DepartmentName</td>
                                        <td>@item.AssetTransferRequest.TransactionType.EnumDisplayName()</td>
                                        <td>@item.AssetTransferRequest.AssignedType.EnumDisplayName()</td>
                                        <td>@item.AssetTransferRequest.BranchFrom.DAOCode</td>
                                    </tr>

                                }
                            }
                        </tbody>

                    </table>

                </div>
            </div>
        </div>
    </div>


}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            $("#dataTable").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false, "paging": false,
                /* "buttons": ["excel", "pdf", "print", "colvis"]*/
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: 'ITSM - Assets',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    , {
                        extend: 'pdfHtml5',
                        text: ' PDF',
                        title: 'ITSM - Assets',
                        orientation: 'landscape',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    , {
                        extend: 'print',
                        text: '<i class="fa fa-print"></i>',
                        title: 'ITSM - Assets',
                        autoPrint: true
                    }
                    ,
                    "colvis"
                ]
            }).buttons().container().appendTo('#dataTable_wrapper .col-md-6:eq(0)');
        });

        $(document).ready(function () {
            loadStatus();
            loadTransactionType();
            loadLocations();
        });

        function loadLocations() {
            $.getJSON("@Url.Action("GetItemListJsonResult", "Branch")", function (data) {
                var dropDown = $("#BranchId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.BranchId }).html(optionaldata.Name));
                });

                 if ('@ViewBag.BranchId') {
                     $('#BranchId').val('@ViewBag.BranchId').attr("selected", "selected");
                }
                loadDepartments();
            });
        }

        $("select#BranchId").change(function (evt) {
            loadDepartments();
        });

        function loadDepartments() {
           var _branchId = $('#BranchId').val();

            $.getJSON("@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")",
                {
                    branchId: _branchId
                }, function (data) {
                var dropDown = $("#DepartmentId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.DepartmentId }).html(optionaldata.DepartmentName));
                });

                if ('@ViewBag.DepartmentId') {
                     $('#DepartmentId').val('@ViewBag.DepartmentId').attr("selected", "selected");
                }

            });
         }

        function loadStatus() {
            $.getJSON("@Url.Action("GetTransStatusJsonResult", "AssetTransaction")", function (data) {
                var dropDown = $("#StatusId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });
                  if ('@ViewBag.StatusId') {
                      $('#StatusId').val('@ViewBag.StatusId').attr("selected", "selected");
                }
            });
        }

        function loadTransactionType() {
            $.getJSON("@Url.Action("GetTransTypesJsonResult", "AssetTransaction")", function (data) {
                var dropDown = $("#TransactionTypeId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });

                if ('@ViewBag.TransactionTypeId') {
                    $('#TransactionTypeId').val('@ViewBag.TransactionTypeId').attr("selected", "selected");
                }

            });
        }

    </script>



}





