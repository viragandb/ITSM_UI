
@using Service
@model IEnumerable<Domain.Ticket>
@{
    /**/

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("CustomerSat", "Report", FormMethod.Get, new { @class = "form-horizontal" }))
{

    <div class="row">
        <div class="col-md-12">
            <div class="card box-danger">
                <div class="card-header with-border">
                    <h3 class="card-title">Tickets</h3>

                </div>


                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12">

                            <div class="form-group row">

                                <label class="col-form-label col-md-2 text-right">
                                    Team :
                                </label>
                                <div class="col-md-4">
                                    <select id="TeamId" name="TeamId" class="form-control form-control-sm">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="TeamId" data-valmsg-replace="true"></span>
                                </div>
                                <label class="col-form-label col-md-2 text-right">
                                    Ticket Type :
                                </label>
                                <div class="col-md-4">
                                    <select id="TicketTypeId" name="TicketTypeId" class="form-control form-control-sm">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="TicketTypeId" data-valmsg-replace="true"></span>
                                </div>



                            </div>
                            <div class="form-group row">

                                <label class="col-form-label col-md-2 text-right">
                                    Assigned To :
                                </label>
                                <div class="col-md-6">
                                    <select id="UserEmpNo" name="UserEmpNo" class="form-control form-control-sm">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="UserEmpNo" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-md-2 text-right">
                                    Category :
                                </label>
                                <div class="col-md-4">
                                    <select id="CategoryId" name="CategoryId" class="form-control form-control-sm">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="CategoryId" data-valmsg-replace="true"></span>
                                </div>




                            </div>
                            <div class="form-group row">
                                <label class="control-label col-md-2 text-right">
                                    Requested Date :
                                </label>
                                <div class="col-md-2">

                                    <div class="input-group date datePicker" id="start_date" data-bs-target-input="nearest">
                                        <input type="text" name="StartDate" id="StartDate" value="@ViewBag.StartDate" class="form-control form-control-sm datetimepicker-input" />
                                        <div class="input-group-append" data-bs-target="#start_date" data-bs-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>

                                </div>

                                <label class="control-label col-md-1 text-right">
                                    To
                                </label>
                                <div class="col-md-2">
                                    <div class="input-group date datePicker" id="end_date" data-bs-target-input="nearest">
                                        <input type="text" name="EndDate" id="EndDate" value="@ViewBag.EndDate" class="form-control form-control-sm datetimepicker-input" />
                                        <div class="input-group-append" data-bs-target="#end_date" data-bs-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                               
                            </div>

                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <div class="text-right">
                        <button type="submit" class="btn btn-sm btn-default">
                            <i class="fa fa-search"></i>&nbsp;&nbsp;Search
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-md-12">
            <div class="card box-default">
                <div class="card-body">

                    <table id="dataTable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Ticket Id</th>
                                <th>Category</th>
                                <th>Asset Type</th>
                                <th>Subcategory</th>
                                <th>Requested By</th>
                                <th>Assigned To</th>
                                <th>Reques -ted Date</th>
                                <th>Resolu -tion Hrs</th>
                                <th>Spent Hrs</th>
                                <th width="60px">Rate</th>
                                <th>SLA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var item in Model)
                                {
                            <tr>

                                <td>
                                    <a href="@Html.EncodedActionLink("","Info", "Ticket","", new { id = item.TicketId },null)" target="_blank">
                                        @item.Code
                                    </a>

                                </td>
                                @*<td>
                                    <span class="label text- label-@TicketService.GetTicketTypeColor(item.RequestType.TicketType)">
                                        @item.RequestType.TicketType.EnumDisplayName()
                                    </span>
                                </td>*@
                                <td>@item.RequestType.Category.CategoryName</td>
                                <td>@item.RequestType.AssetType.AssetTypeName</td>
                                <td>@item.RequestType.SubCategory.SubCategoryName</td>
                                <td>@item.RequestedUser.FullName</td>
                                <td>
                                    @if (item.AssignedToUser != null)
                                    {
                                        @item.AssignedToUser.FullName
                                    }
                                </td>

                                <td align="right">@item.RequestedDate.ToShortDateString()</td>
                                <td align="right">@item.Resolve</td>
                                <td align="right">@item.SpentTime</td>
                                <td>
                                    @item.Rate.EnumDisplayName() (@((int)item.Rate))<br />
                                    <span class="label text-label-@TicketService.GetTicketRateColor(item.Rate)">
                                        @(new HtmlString(@TicketService.GetTicketRate(item.Rate)))
                                    </span>
                                </td>
                                <td>
                                    @if (@item.IsTimeViolated)
                                    {
                                        <label class="badge bg-danger">
                                            Violated
                                        </label>

                                    }
                                </td>
                            </tr>
                                }
                            }
                        </tbody>

                    </table>

                </div>
                <!-- /.box-body -->

            </div>

        </div>
    </div>
    
}


@section scripts {

<script type="text/javascript">


        $(document).ready(function () {

            $("#dataTable").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false, "paging": false,
                /* "buttons": ["excel", "pdf", "print", "colvis"]*/
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: 'Tickets',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    , {
                        extend: 'pdfHtml5',
                        text: ' PDF',
                        title: 'Tickets',
                        orientation: 'landscape',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    ,
                    {
                        extend: 'print',
                        text: '<i class="fa fa-print"></i>',
                        title: 'Tickets',
                        autoPrint: true
                    }
                    ,
                    "colvis"
                ]
            }).buttons().container().appendTo('#dataTable_wrapper .col-md-6:eq(0)');

        });


             $(document).ready(function () {

             loadTeams();
                 loadTicketTypes();
                 loadCategory();
                 loadCompanies();
        });

        $("select#TeamId").change(function (evt) {
            loadUsers();

        });

        function loadTeams() {

            $.getJSON("@Url.Action("GetTeamListJsonResult", "Team")", function (data) {
                var dropDown = $("#TeamId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.TeamId }).html(optionaldata.TeamName));
                });

                if ('@ViewBag.TeamId') {
                      $('#TeamId').val(@ViewBag.TeamId).attr("selected", "selected");
                 }

                loadUsers();
            });

        }

        function loadUsers() {

             var _teamId = $('#TeamId').val();

            $.getJSON("@Url.Action("GetUsersByTeamIdJsonResult", "User")",
              {
                  teamId: _teamId
              }, function (data) {
                  var dropDown = $("#UserEmpNo");

                  dropDown.empty();
                  dropDown.append("<option value='0'>-- All --</option>");

                  $.each(JSON.parse(data), function (index, optionaldata) {
                      dropDown.append($('<option/>', { value: optionaldata.EmpNo }).html(optionaldata.EmpNo + ' - ' +optionaldata.FullName + ' (' + optionaldata.DesignationName + ')' ));
                  });

                   if ('@ViewBag.UserEmpNo') {
                       $('#UserEmpNo').val(@ViewBag.UserEmpNo).attr("selected", "selected");
                 }

              });
        }

        function loadTicketTypes() {

            $.getJSON("@Url.Action("GetTicketTypesJsonResult", "RequestType")", function (data) {
                var dropDown = $("#TicketTypeId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });

                if ('@ViewBag.TicketTypeId') {
                    $('#TicketTypeId').val(@ViewBag.TicketTypeId).attr("selected", "selected");
                 }
            });

        }

        function loadCategory() {

            $.getJSON("@Url.Action("GetCategoryListJsonResult", "Category")",function(data) {
                    var dropDown = $("#CategoryId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.CategoryId }).html(optionaldata.CategoryName));
                });

                 if ('@ViewBag.CategoryId') {
                     $('#CategoryId').val('@ViewBag.CategoryId').attr("selected", "selected");
                }
                @*else {
                     $('#CategoryId').val('@categoryId').attr("selected", "selected");
                }*@

                });


        }



</script>
}







