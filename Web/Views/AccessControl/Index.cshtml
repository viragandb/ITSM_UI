@model Domain.AccessControl

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Plugins/JsTree/dist/themes/default/style.min.css"
      rel="stylesheet" />

<div class="row">

    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <h5 class="card-title mb-0">
                    Manage Access
                </h5>

            </div>

            @using (Html.BeginForm(
                "Index",
                "AccessControl",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "alert alert-danger" }
                )

                <div class="card-body">

                    <div class="row mb-4 align-items-end">

                        <div class="col-md-6">

                            <label class="form-label"
                                   for="GroupId">
                                Group
                            </label>

                            <select id="GroupId"
                                    name="GroupId"
                                    class="form-select">

                                <option value="">
                                    -- Select --
                                </option>

                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="GroupId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <button type="button"
                                    id="btnSearch"
                                    class="btn btn-light w-100">

                                <i class="align-middle me-1"
                                   data-lucide="search"></i>

                                Search

                            </button>

                        </div>

                    </div>

                    <input type="hidden"
                           name="GroupAcess"
                           id="GroupAcess"
                           value="" />

                    <div class="card bg-body-tertiary border-0">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">

                                <i class="align-middle me-2"
                                   data-lucide="shield-check"></i>

                                <h6 class="mb-0">
                                    Access Permissions
                                </h6>

                            </div>

                            <div id="demoTree">
                            </div>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary btnSubmitDisable">

                            <i class="align-middle me-1"
                               data-lucide="save"></i>

                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section scripts {

    <script src="~/Plugins/JsTree/src/jstree.js"></script>
    <script src="~/Plugins/JsTree/src/jstree.checkbox.js"></script>

    <script type="text/javascript">

        $(function () {

            $("form").on("submit", function () {

                var selectedElmsIds = [];

                var selectedElms =
                    $('#demoTree').jstree(
                        "get_selected",
                        true
                    );

                $.each(
                    selectedElms,
                    function () {

                        selectedElmsIds.push(
                            this.id
                        );

                    }
                );

                $('#GroupAcess').val(
                    selectedElmsIds.join(",")
                );

            });


            $("select#GroupId").on(
                "change",
                function () {

                    $("#GroupId").valid();

                }
            );


            $("#btnSearch").on(
                "click",
                function () {

                    loadAccessItems();

                }
            );


            loadUserGroup();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadAccessItems() {

            if (!$("form").valid()) {
                return;
            }

            var systemUserGroupId =
                $("#GroupId").val();


            if (
                !systemUserGroupId ||
                systemUserGroupId == "0"
            ) {
                return;
            }


            $.ajax({

                url: '@Url.Action("GetAccessListJsonResult", "AccessControl")',

                type: 'GET',

                dataType: 'json',

                data: {
                    groupId: systemUserGroupId
                },

                success: function (data) {

                    if (
                        $.jstree.reference(
                            $('#demoTree')
                        )
                    ) {

                        $('#demoTree')
                            .jstree('destroy');

                    }


                    $('#demoTree').jstree({

                        checkbox: {

                            real_checkboxes: true,

                            keep_selected_style: false

                        },

                        core: {

                            check_callback: true,

                            expand_selected_onload: false,

                            themes: {

                                variant: "large"

                            },

                            data: parseJsonResult(data)

                        },

                        plugins: [
                            "checkbox"
                        ]

                    });

                }

            });

        }


        function loadUserGroup() {

            $.getJSON(
                '@Url.Action("GetGroup", "AccessControl")',
                {
                    accountId: $("#AccountId").val()
                },
                function (data) {

                    var dropDown =
                        $("#GroupId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $('<option/>', {
                                    value: item.GroupId,
                                    text: item.GroupName
                                })
                            );

                        }
                    );


                    var groupId =
                        '@ViewBag.GroupId';

                    if (groupId) {

                        dropDown.val(
                            groupId
                        );

                    }


                    $('#GroupId').valid();

                    loadAccessItems();

                }
            );


            if (
                $.jstree.reference(
                    $('#demoTree')
                )
            ) {

                $('#demoTree')
                    .jstree('destroy');

            }

        }

    </script>

}