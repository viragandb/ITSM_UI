@model Domain.CM.ChangeRequest
@using Service.CM
@using Service
@using Domain.CM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="card-title mb-1">

                        <strong>Request #@Model.ChangeRequestId</strong>

                        <span class="mx-2 text-muted">|</span>

                        <i class="align-middle me-1" data-lucide="layers"></i>

                        @Model.ChangeRequestCategory.Name

                    </h5>

                </div>

                <span class="badge bg-@ChangeRequestService.GetStatusColor(Model.Status)">
                    @Model.Status.EnumDisplayName()
                </span>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-lg-8">

                        <div class="mb-3">

                            <div class="fw-semibold mb-1">
                                @Html.DisplayNameFor(model => model.Subject)
                            </div>

                            <div class="text-muted">
                                @Model.Subject
                            </div>

                        </div>

                        <hr />

                        <div class="mb-3">

                            <div class="fw-semibold mb-1">
                                @Html.DisplayNameFor(model => model.Description)
                            </div>

                            <div class="text-muted"
                                 style="white-space: pre-wrap;">
                                @Model.Description
                            </div>

                        </div>

                        <hr />

                        <div class="mb-3">

                            <div class="fw-semibold mb-1">
                                @Html.DisplayNameFor(model => model.Justification)
                            </div>

                            <div class="text-muted"
                                 style="white-space: pre-wrap;">
                                @Model.Justification
                            </div>

                        </div>

                        <hr />

                        <dl class="row">

                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.DurationType)
                            </dt>

                            <dd class="col-sm-3">
                                @Model.DurationType.EnumDisplayName()
                            </dd>

                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.ExpireDate)
                            </dt>

                            <dd class="col-sm-3">

                                @if (Model.DurationType == Domain.AssignedTypeEnum.Permanent)
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    @Model.ExpireDate.ToShortDateString()
                                }

                            </dd>

                            <dt class="col-sm-3">
                                Request Type
                            </dt>

                            <dd class="col-sm-3">
                                @Model.ChangeRequestCategory.Name
                            </dd>

                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.TeamId)
                            </dt>

                            <dd class="col-sm-3">
                                @(Model.Team != null ? Model.Team.TeamName : "N/A")
                            </dd>

                        </dl>


                        @if (Model.ChangeImplementData != null)
                        {
                            <hr />

                            <div class="card mb-3">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                                        Change Details
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <dl class="row mb-0">

                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeAreaId)
                                        </dt>

                                        <dd class="col-sm-9">
                                            @Model.ChangeImplementData.ChangeArea.Name
                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeCategory)
                                        </dt>

                                        <dd class="col-sm-3">

                                            <span class="badge bg-@ChangeRequestService.GetImpactColor(Model.ChangeImplementData.ChangeCategory)">
                                                @Model.ChangeImplementData.ChangeCategory.EnumDisplayName()
                                            </span>

                                        </dd>

                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangePriority)
                                        </dt>

                                        <dd class="col-sm-3">
                                            @Model.ChangeImplementData.ChangePriority.EnumDisplayName()
                                        </dd>


                                        <dt class="col-sm-3">
                                            Change Type/s
                                        </dt>

                                        <dd class="col-sm-9">

                                            @foreach (ChangeRequestTask task in Model.ChangeImplementData.ChangeRequestTasks)
                                            {
                                                <div>
                                                    @task.ChangeType.Name
                                                </div>
                                            }

                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.PlannedChange)
                                        </dt>

                                        <dd class="col-sm-9"
                                            style="white-space: pre-wrap;">
                                            @Model.ChangeImplementData.PlannedChange
                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.RiskAssessment)
                                        </dt>

                                        <dd class="col-sm-9"
                                            style="white-space: pre-wrap;">
                                            @Model.ChangeImplementData.RiskAssessment
                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.RiskIdentification)
                                        </dt>

                                        <dd class="col-sm-9"
                                            style="white-space: pre-wrap;">
                                            @Model.ChangeImplementData.RiskIdentification
                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.RollbackPlan)
                                        </dt>

                                        <dd class="col-sm-9"
                                            style="white-space: pre-wrap;">
                                            @Model.ChangeImplementData.RollbackPlan
                                        </dd>


                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.ChangeImplementData.RollbackTestResults)
                                        </dt>

                                        <dd class="col-sm-9"
                                            style="white-space: pre-wrap;">
                                            @Model.ChangeImplementData.RollbackTestResults
                                        </dd>

                                    </dl>

                                </div>

                            </div>


                            if (Model.ChangeImplementData.IsDowntimeRequired)
                            {
                                <div class="card border-danger mb-3">

                                    <div class="card-header">

                                        <h5 class="card-title mb-0">
                                            <i class="align-middle me-2" data-lucide="clock"></i>
                                            Downtime
                                        </h5>

                                    </div>

                                    <div class="card-body">

                                        <dl class="row mb-0">

                                            <dt class="col-sm-3">
                                                @Html.DisplayNameFor(model => model.ChangeImplementData.Downtime)
                                            </dt>

                                            <dd class="col-sm-9">
                                                @Model.ChangeImplementData.Downtime
                                            </dd>


                                            <dt class="col-sm-3">
                                                @Html.DisplayNameFor(model => model.ChangeImplementData.DowntimeImpactedAreas)
                                            </dt>

                                            <dd class="col-sm-9"
                                                style="white-space: pre-wrap;">
                                                @Model.ChangeImplementData.DowntimeImpactedAreas
                                            </dd>


                                            @if (Model.ChangeImplementData.SendDowntimeAlert)
                                            {
                                                <dt class="col-sm-3">
                                                    @Html.DisplayNameFor(model => model.ChangeImplementData.DowntimeTimePeriod)
                                                </dt>

                                                <dd class="col-sm-9">
                                                    @Model.ChangeImplementData.DowntimeTimePeriod
                                                </dd>


                                                <dt class="col-sm-3">
                                                    @Html.DisplayNameFor(model => model.ChangeImplementData.DowntimePlannedDate)
                                                </dt>

                                                <dd class="col-sm-9">
                                                    @Convert.ToDateTime(Model.ChangeImplementData.DowntimePlannedDate).ToShortDateString()
                                                </dd>


                                                <dt class="col-sm-3">
                                                    Email Recipient/s
                                                </dt>

                                                <dd class="col-sm-9">

                                                    @foreach (DowntimeAlertEmail email in Model.ChangeImplementData.DowntimeAlertEmails)
                                                    {
                                                        <div>
                                                            @email.Email
                                                        </div>
                                                    }

                                                </dd>
                                            }

                                        </dl>

                                    </div>

                                </div>
                            }


                            <div class="card mb-3">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="timer"></i>
                                        SLA
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <dl class="row mb-0">

                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.Resolve)
                                        </dt>

                                        <dd class="col-sm-3">
                                            @Model.Resolve
                                        </dd>

                                        <dt class="col-sm-3">
                                            @Html.DisplayNameFor(model => model.SpentTime)
                                        </dt>

                                        <dd class="col-sm-3">
                                            @Model.SpentTime Hrs.
                                        </dd>

                                    </dl>

                                    @if (Model.IsTimeViolated)
                                    {
                                        <span class="badge bg-danger">
                                            SLA Violated
                                        </span>
                                    }

                                </div>

                            </div>
                        }


                        @if (Model.Assets != null && Model.Assets.Count > 0)
                        {
                            <div class="card">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="boxes"></i>
                                        Assets
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="table-responsive">

                                        <table id="assetDataTable"
                                               class="table table-striped table-hover align-middle w-100">

                                            <thead>
                                                <tr>
                                                    <th>Asset No</th>
                                                    <th>Asset Type</th>
                                                    <th>Make</th>
                                                    <th>Model</th>
                                                    <th>Serial No</th>
                                                    <th>Barcode</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var item in Model.Assets)
                                                {
                                                    <tr>

                                                        <td>

                                                            <a href="@Html.EncodedActionLink("", "Info", "Asset", "", new { id = item.AssetId }, null)"
                                                               target="_blank">

                                                                @item.Asset.AssetNo

                                                            </a>

                                                        </td>

                                                        <td>
                                                            @item.Asset.AssetType.AssetTypeName
                                                        </td>

                                                        <td>
                                                            @item.Asset.AssetMake.Name
                                                        </td>

                                                        <td>
                                                            @item.Asset.ModelName
                                                        </td>

                                                        <td>
                                                            @item.Asset.SerialNo
                                                        </td>

                                                        <td>
                                                            @item.Asset.Barcode
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>


                    <div class="col-lg-4">

                        <div class="card mb-3">

                            <div class="card-header">

                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="user"></i>
                                    Requester
                                </h5>

                            </div>

                            <div class="card-body">

                                <div class="mb-3">

                                    <div class="fw-semibold">
                                        @Model.RequestedBy - @Model.RequestedUser.FullName
                                    </div>

                                </div>

                                <div class="d-flex align-items-center mb-2">

                                    <i class="align-middle me-2" data-lucide="briefcase"></i>

                                    <span>
                                        @Model.RequestedUser.DesignationName
                                    </span>

                                </div>

                                <div class="d-flex align-items-center mb-2">

                                    <i class="align-middle me-2" data-lucide="phone"></i>

                                    <span>
                                        @Model.RequestedUser.ContactNo
                                    </span>

                                </div>

                                <div class="d-flex align-items-center">

                                    <i class="align-middle me-2" data-lucide="mail"></i>

                                    <span>
                                        @Model.RequestedUser.Email
                                    </span>

                                </div>

                            </div>

                        </div>


                        @if (Model.ApprovalByUser != null)
                        {
                            <div class="card mb-3">

                                <div class="card-body text-center">

                                    <img src="@Model.ApprovalByUser.ProImageName"
                                         alt="Approver"
                                         class="rounded-circle mb-3"
                                         style="width:70px;height:70px;object-fit:cover;" />

                                    <h6 class="mb-1">
                                        @Model.ApprovalBy - @Model.ApprovalByUser.FullName
                                    </h6>

                                    <div class="text-muted mb-2">
                                        @Model.ApprovalByUser.DesignationName
                                        (@Model.ApprovalByUser.DepartmentName)
                                    </div>

                                    <span class="badge bg-success">
                                        Approver
                                    </span>

                                </div>

                            </div>
                        }


                        @if (Model.ImplementedByUser != null)
                        {
                            <div class="card mb-3">

                                <div class="card-body text-center">

                                    <img src="@Model.ImplementedByUser.ProImageName"
                                         alt="Implementer"
                                         class="rounded-circle mb-3"
                                         style="width:70px;height:70px;object-fit:cover;" />

                                    <h6 class="mb-1">
                                        @Model.ImplementedBy - @Model.ImplementedByUser.FullName
                                    </h6>

                                    <div class="text-muted mb-2">
                                        @Model.ImplementedByUser.DesignationName
                                        (@Model.ImplementedByUser.DepartmentName)
                                    </div>

                                    <span class="badge bg-success">
                                        Implementer
                                    </span>

                                </div>

                            </div>
                        }


                        @if (Model.ChangeApprovedByUser != null)
                        {
                            <div class="card mb-3">

                                <div class="card-body text-center">

                                    <img src="@Model.ChangeApprovedByUser.ProImageName"
                                         alt="Change Manager"
                                         class="rounded-circle mb-3"
                                         style="width:70px;height:70px;object-fit:cover;" />

                                    <h6 class="mb-1">
                                        @Model.ChangeApprovedBy - @Model.ChangeApprovedByUser.FullName
                                    </h6>

                                    <div class="text-muted mb-2">
                                        @Model.ChangeApprovedByUser.DesignationName
                                        (@Model.ChangeApprovedByUser.DepartmentName)
                                    </div>

                                    <span class="badge bg-primary">
                                        Change Manager
                                    </span>

                                </div>

                            </div>
                        }


                        @if (Model.ChangeRequestDocs != null && Model.ChangeRequestDocs.Count > 0)
                        {
                            <div class="card">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="file-text"></i>
                                        Documents
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="list-group list-group-flush">

                                        @foreach (var item in Model.ChangeRequestDocs)
                                        {
                                            <a href="@item.FileUrl"
                                               target="_blank"
                                               class="list-group-item list-group-item-action px-0">

                                                <i class="align-middle me-2" data-lucide="file-text"></i>
                                                @item.DocumentName

                                            </a>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>


                <div class="row g-4 mt-1">

                    <div class="col-lg-8">

                        <div class="card">

                            <div class="card-header d-flex justify-content-between align-items-center">

                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="history"></i>
                                    Status
                                </h5>

                                <button type="button"
                                        class="btn btn-sm btn-light"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#statusHistory"
                                        aria-expanded="true"
                                        aria-controls="statusHistory">

                                    <i class="align-middle" data-lucide="chevron-down"></i>

                                </button>

                            </div>

                            <div id="statusHistory"
                                 class="collapse show">

                                <div class="card-body">

                                    @foreach (var status in Model.ChangeRequestUpdates.OrderBy(o => o.UpdatedDate))
                                    {
                                        <div class="d-flex mb-4">

                                            <div class="me-3">

                                                <img src="@status.UpdatedUser.ProImageName"
                                                     alt="User"
                                                     class="rounded-circle"
                                                     style="width:45px;height:45px;object-fit:cover;" />

                                            </div>

                                            <div class="flex-grow-1">

                                                <div class="d-flex justify-content-between flex-wrap gap-2 mb-1">

                                                    <strong>
                                                        @status.UpdatedUser.FullName
                                                    </strong>

                                                    <span class="text-muted small">
                                                        @status.UpdatedDate
                                                    </span>

                                                </div>

                                                <div class="border rounded p-3 bg-@ChangeRequestService.GetStatusColor(status.Status)">

                                                    <div class="row">

                                                        <div class="col-md-9">

                                                            <strong>
                                                                @status.Status.EnumDisplayName()
                                                            </strong>

                                                            @if (!string.IsNullOrWhiteSpace(status.Comment))
                                                            {
                                                                <span>
                                                                    | @status.Comment
                                                                </span>
                                                            }

                                                        </div>

                                                        <div class="col-md-3 text-md-end">

                                                            <strong>
                                                                @status.SpentTimeFomated (HH:MM)
                                                            </strong>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-lg-4">

                        <div class="card">

                            <div class="card-header d-flex justify-content-between align-items-center">

                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="list"></i>
                                    Request Log
                                </h5>

                                <button type="button"
                                        class="btn btn-sm btn-light"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#requestLog"
                                        aria-expanded="true"
                                        aria-controls="requestLog">

                                    <i class="align-middle" data-lucide="chevron-down"></i>

                                </button>

                            </div>

                            <div id="requestLog"
                                 class="collapse show">

                                <div class="card-body">

                                    @foreach (var log in Model.ChangeRequestLogs.OrderBy(o => o.UpdatedDate))
                                    {
                                        <div class="d-flex mb-3">

                                            <div class="me-2">

                                                <img src="@(log.UpdatedBy != null ? log.UpdatedUser.ProImageName : "/Images/userimage.png")"
                                                     alt="User"
                                                     class="rounded-circle"
                                                     style="width:40px;height:40px;object-fit:cover;" />

                                            </div>

                                            <div class="flex-grow-1">

                                                <div class="d-flex justify-content-between flex-wrap gap-2">

                                                    <strong>
                                                        @(log.UpdatedBy != null ? log.UpdatedUser.FullName : "N/A")
                                                    </strong>

                                                    <span class="text-muted small">
                                                        @log.UpdatedDate
                                                    </span>

                                                </div>

                                                <div class="text-muted mt-1"
                                                     style="white-space: pre-wrap;">
                                                    @log.Comment
                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($("#assetDataTable").length) {

                $("#assetDataTable").DataTable({
                    paging: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    responsive: true,
                    autoWidth: false
                });

            }

        });

    </script>
}