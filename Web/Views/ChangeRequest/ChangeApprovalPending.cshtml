                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function approveCMC() {

            var requestId = $("#approveCMCRequestId").val();
            var comment = $("#approveCMCComment").val();

            if (!comment || !comment.trim()) {

                Swal.fire(
                    "Error!",
                    "Please enter a comment",
                    "error"
                );

                return;
            }

            $("#btnApproveCMC").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ChangeSendToCMC", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been sent to Approval",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 300);

                    }
                    else {

                        $("#btnApproveCMC").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#btnApproveCMC").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }

    </script>
}