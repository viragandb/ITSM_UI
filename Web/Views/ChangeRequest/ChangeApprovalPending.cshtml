@model ICollection<Domain.CM.ChangeRequest>
@using Service.CM
@using Service
@using Domain.CM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="clock"></i>
                    Pending
                </h5>
            </div>

            <div class="card-body">

                <div class="accordion" id="changeRequestAccordion">

                    @foreach (var item in Model)
                    {
                        var collapseId = "request_" + item.ChangeRequestId;
                        var headingId = "heading_" + item.ChangeRequestId;
                        var impactColor = ChangeRequestService.GetImpactColor(item.ChangeImplementData.ChangeCategory);

                        <div class="accordion-item mb-3 border border-@impactColor">

                            <h2 class="accordion-header" id="@headingId">

                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">

                                    <div class="w-100 d-flex flex-wrap justify-content-between align-items-center gap-2 me-3">

                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <strong>
                                                Request #@item.ChangeRequestId
                                            </strong>

                                            <span class="text-muted">|</span>

                                            <i class="align-middle"
                                               data-lucide="layers">
                                            </i>

                                            <span>
                                                @item.ChangeRequestCategory.Name
                                            </span>

                                        </div>

                                        <span class="badge bg-@impactColor">
                                            @item.ChangeImplementData.ChangeCategory.EnumDisplayName()
                                        </span>

                                    </div>

                                </button>

                            </h2>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#changeRequestAccordion">

                                <div class="accordion-body">

                                    @Html.Partial("_RequestMin", item)

                                </div>

                                <div class="border-top p-3">

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a href="@Html.EncodedActionLink("", "Info", "ChangeRequest", "", new { id = item.ChangeRequestId }, null)"
                                           target="_blank"
                                           class="btn btn-sm btn-light">

                                            <i class="align-middle me-1"
                                               data-lucide="info">
                                            </i>
                                            More

                                        </a>

                                        <button type="button"
                                                data-id="@item.ChangeRequestId"
                                                class="openModalUpdateReject btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalUpdateReject">

                                            <i class="align-middle me-1"
                                               data-lucide="thumbs-down">
                                            </i>
                                            Reject

                                        </button>


                                        @if (item.ChangeImplementData.ChangeCategory == ChangeCategoryEnum.Major ||
                                             item.ChangeImplementData.ChangeCategory == ChangeCategoryEnum.Emergency)
                                        {
                                            <button type="button"
                                                    data-id="@item.ChangeRequestId"
                                                    class="openModalUpdateApproveCMC btn btn-sm btn-warning"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateApproveCMC">

                                                <i class="align-middle me-1"
                                                   data-lucide="send">
                                                </i>
                                                Approve and Send To CMC Approval

                                            </button>
                                        }
                                        else if (item.ChangeImplementData.ChangeCategory == ChangeCategoryEnum.Significant)
                                        {
                                            <button type="button"
                                                    data-id="@item.ChangeRequestId"
                                                    class="openModalUpdateApproveAVP btn btn-sm btn-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateApproveAVP">

                                                <i class="align-middle me-1"
                                                   data-lucide="send">
                                                </i>
                                                Approve and Send To AVP Approval

                                            </button>
                                        }
                                        else if (item.ChangeImplementData.ChangeCategory == ChangeCategoryEnum.Minor)
                                        {
                                            <button type="button"
                                                    data-id="@item.ChangeRequestId"
                                                    class="openModalUpdateApprove btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateApprove">

                                                <i class="align-middle me-1"
                                                   data-lucide="thumbs-up">
                                                </i>
                                                Approve

                                            </button>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
</div>


<div class="modal fade"
     id="modalUpdate"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #
                    <span id="updateRequestLabel"></span>
                    Update
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="updateRequestId"
                       value="" />

                <div class="mb-3">

                    <label for="updateComment"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="updateComment"
                           placeholder="Enter Comment"
                           class="form-control" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-sm btn-light"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        id="btnUpdate"
                        class="btn btn-sm btn-primary"
                        onclick="update()">

                    <i class="align-middle me-1" data-lucide="save"></i>
                    Update

                </button>

            </div>

        </div>

    </div>

</div>


