@section scripts {

    <script type="text/javascript">

        $(document).on("click", ".openModalUpdateApprove", function () {

            var requestId = $(this).data("id");

            $("#approveRequestId").val(requestId);
            $("#approveRequestLabel").text(requestId);
            $("#approveComment").val("");
            $("#btnApprove").prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateApproveAVP", function () {

            var requestId = $(this).data("id");

            $("#approveAVPRequestId").val(requestId);
            $("#approveAVPRequestLabel").text(requestId);
            $("#approveAVPComment").val("");
            $("#btnApproveAVP").prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateApproveVP", function () {

            var requestId = $(this).data("id");

            $("#approveVPRequestId").val(requestId);
            $("#approveVPRequestLabel").text(requestId);
            $("#approveVPComment").val("");
            $("#btnApproveVP").prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateApproveCMC", function () {

            var requestId = $(this).data("id");

            $("#approveCMCRequestId").val(requestId);
            $("#approveCMCRequestLabel").text(requestId);
            $("#approveCMCComment").val("");
            $("#btnApproveCMC").prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateReject", function () {

            var requestId = $(this).data("id");

            $("#rejectRequestId").val(requestId);
            $("#rejectRequestLabel").text(requestId);
            $("#rejectComment").val("");
            $("#btnReject").prop("disabled", false);

        });


        function update() {

            var requestId = $("#updateRequestId").val();
            var comment = $("#updateComment").val();

            if (!comment || !comment.trim()) {

                Swal.fire(
                    "Error!",
                    "Please enter a comment",
                    "error"
                );

                return;
            }

            $("#btnUpdate").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ImplementerUpdate", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been approved",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 300);

                    }
                    else {

                        $("#btnUpdate").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#btnUpdate").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function approve() {

            var requestId = $("#approveRequestId").val();
            var comment = $("#approveComment").val();

            if (!comment || !comment.trim()) {

                Swal.fire(
                    "Error!",
                    "Please enter a comment",
                    "error"
                );

                return;
            }

            $("#btnApprove").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ChangeApprove", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been approved",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 300);

                    }
                    else {

                        $("#btnApprove").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#btnApprove").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function reject() {

            var requestId = $("#rejectRequestId").val();
            var comment = $("#rejectComment").val();

            if (!comment || !comment.trim()) {

                Swal.fire(
                    "Error!",
                    "Please enter a comment",
                    "error"
                );

                return;
            }

            $("#btnReject").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ChangeReject", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been rejected",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 100);

                    }
                    else {

                        $("#btnReject").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#btnReject").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function approveAVP() {

            var requestId = $("#approveAVPRequestId").val();
            var comment = $("#approveAVPComment").val();

            if (!comment || !comment.trim()) {

                Swal.fire(
                    "Error!",
                    "Please enter a comment",
                    "error"
                );

                return;
            }

            $("#btnApproveAVP").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ChangeSendToAVP", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been sent to Approval",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 300);

                    }
                    else {

                        $("#btnApproveAVP").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#btnApproveAVP").prop("disabled", false);

                    Swal.fire(
