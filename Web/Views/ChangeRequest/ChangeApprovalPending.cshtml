            }

            $("#btnApproveVP").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("ChangeSendToVP", "ChangeRequest")',
                type: "GET",
                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been sent to Approval",
                            "success"
                        );

                        setTimeout(function () {
