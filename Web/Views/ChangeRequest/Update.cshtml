@model Web.Models.ChangeImplementVM
@using Service.CM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Update", "ChangeRequest", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.ChangeRequestId)
    @Html.HiddenFor(model => model.ChangeRequest.ChangeRequestCategoryId)

    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <h5 class="card-title mb-0">
                        <strong>Request #@Model.ChangeRequestId</strong>

                        <span class="mx-2 text-muted">|</span>

                        <i class="align-middle me-1" data-lucide="layers"></i>

                        @Model.ChangeRequest.ChangeRequestCategory.Name
                    </h5>

                    @if (Model.ChangeRequest.TeamId != null)
                    {
                        <span class="badge bg-@ChangeRequestService.GetStatusColor(Model.ChangeRequest.Status)">
                            @Model.ChangeRequest.Team.TeamName
                        </span>
                    }

                </div>

                <div class="card-body">

                    @Html.Partial("_RequestMin", Model.ChangeRequest)

                    <hr />

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="mb-3">

                                @Html.LabelFor(
                                    model => model.ChangeAreaId,
                                    new { @class = "form-label" }
                                )

                                @Html.DropDownListFor(
                                    model => model.ChangeAreaId,
                                    new List<SelectListItem>(),
                                    new { @class = "form-select" }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.ChangeAreaId,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>

                        <div class="col-md-5">

                            <div class="mb-3">

                                <label for="ChangeTypeId"
                                       class="form-label">
                                    Change Type
                                </label>

                                <select id="ChangeTypeId"
                                        name="ChangeTypeId"
                                        class="form-select">
                                </select>

                            </div>

                        </div>

                        <div class="col-md-1">

                            <div class="mb-3">

                                <label class="form-label d-block">
                                    &nbsp;
                                </label>

                                <button type="button"
                                        class="btn btn-sm btn-info w-100"
                                        onclick="addChangeType()">

                                    <i class="align-middle me-1" data-lucide="plus"></i>
                                    Add

                                </button>

                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="mb-3">

                                @Html.LabelFor(
                                    model => model.ChangeCategory,
                                    new { @class = "form-label" }
                                )

                                @Html.EnumDropDownListFor(
                                    model => model.ChangeCategory,
                                    "-- Select --",
                                    new { @class = "form-select" }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.ChangeCategory,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>


                            <div class="mb-3">

                                @Html.LabelFor(
                                    model => model.ChangePriority,
                                    new { @class = "form-label" }
                                )

                                @Html.EnumDropDownListFor(
                                    model => model.ChangePriority,
                                    "-- Select --",
                                    new { @class = "form-select" }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.ChangePriority,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>


                        <div class="col-md-6"
                             id="changeTypeTable">

                            <div class="table-responsive">

                                <table class="table table-striped table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th>Change Type</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="changetype">

                                        @if (Model.ChangeRequestTasks != null)
                                        {
                                            for (var i = 0; i < Model.ChangeRequestTasks.Count; i++)
                                            {
                                                <tr id="@i">

                                                    <td>

                                                        @Html.HiddenFor(
                                                            m => Model.ChangeRequestTasks[i].ChangeTypeId,
                                                            new { @class = "iHidden" }
                                                        )

                                                        @Html.HiddenFor(
                                                            m => Model.ChangeRequestTasks[i].ChangeType.Name
                                                        )

                                                        @Model.ChangeRequestTasks[i].ChangeType.Name

                                                    </td>

                                                    <td class="text-end">

                                                        <button type="button"
                                                                id="btnRemove@i"
                                                                name="btnRemove@i"
                                                                onclick="deleteRowChangeType(@i)"
                                                                class="btn btn-sm btn-danger">

                                                            <i class="align-middle" data-lucide="trash-2"></i>

                                                        </button>

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.PlannedChange,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.PlannedChange,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.PlannedChange,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.RiskIdentification,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.RiskIdentification,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.RiskIdentification,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.RollbackPlan,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.RollbackPlan,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.RollbackPlan,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.RollbackTestResults,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.RollbackTestResults,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.RollbackTestResults,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.RiskAssessment,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.RiskAssessment,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.RiskAssessment,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        <div class="form-check">

                            @Html.CheckBoxFor(
                                model => model.IsDowntimeRequired,
                                new { @class = "form-check-input" }
                            )

                            @Html.LabelFor(
                                model => model.IsDowntimeRequired,
                                new { @class = "form-check-label" }
                            )

                        </div>

                    </div>


                    <div id="downtime">

                        <div class="card border-warning mb-3">

                            <div class="card-header">

                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="clock"></i>
                                    Downtime Details
                                </h5>

                            </div>

                            <div class="card-body">

                                <div class="mb-3">

                                    @Html.LabelFor(
                                        model => model.Downtime,
                                        new { @class = "form-label" }
                                    )

                                    @Html.TextAreaFor(
                                        model => model.Downtime,
                                        new
                                        {
                                            @class = "form-control",
                                            rows = "3",
                                            style = "white-space: pre-wrap;"
                                        }
                                    )

                                    @Html.ValidationMessageFor(
                                        model => model.Downtime,
                                        "",
                                        new { @class = "text-danger" }
                                    )

                                </div>

                                <div class="mb-0">

                                    @Html.LabelFor(
                                        model => model.DowntimeImpactedAreas,
                                        new { @class = "form-label" }
                                    )

                                    @Html.TextAreaFor(
                                        model => model.DowntimeImpactedAreas,
                                        new
                                        {
                                            @class = "form-control",
                                            rows = "3",
                                            style = "white-space: pre-wrap;"
                                        }
                                    )

                                    @Html.ValidationMessageFor(
                                        model => model.DowntimeImpactedAreas,
                                        "",
                                        new { @class = "text-danger" }
                                    )

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="mb-4">

                        @Html.LabelFor(
                            model => model.Comment,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.Comment,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Comment,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="card">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                <i class="align-middle me-2" data-lucide="boxes"></i>
                                Assign Assets
                            </h5>

                        </div>

                        <div class="card-body">

                            <div class="row g-3 align-items-end">

                                <div class="col-md-3">

                                    <label for="AssetCategoryId"
                                           class="form-label">
                                        Asset Category
                                    </label>

                                    <select id="AssetCategoryId"
                                            name="AssetCategoryId"
                                            class="form-select">
                                    </select>

                                </div>

                                <div class="col-md-3">

                                    <label for="AssetTypeId"
                                           class="form-label">
                                        Asset Type
                                    </label>

                                    <select id="AssetTypeId"
                                            name="AssetTypeId"
                                            class="form-select">
                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="AssetItemId"
                                           class="form-label">
                                        Asset
                                    </label>

                                    <select id="AssetItemId"
                                            name="AssetItemId"
                                            class="form-select select2">
                                    </select>

                                </div>

                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-sm btn-info w-100"
                                            onclick="addAsset()">

                                        <i class="align-middle me-1" data-lucide="plus"></i>
                                        Add

                                    </button>

                                </div>

                            </div>


                            <div class="table-responsive mt-4">

                                <table class="table table-striped table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th>Asset</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="assetdata">

                                        @if (Model.Assets != null)
                                        {
                                            for (var i = 0; i < Model.Assets.Count; i++)
                                            {
                                                <tr id="@i">

                                                    <td>

                                                        @Html.HiddenFor(
                                                            m => Model.Assets[i].AssetId,
                                                            new { @class = "iHidden" }
                                                        )

                                                        @Html.HiddenFor(
                                                            m => Model.Assets[i].AssetName
                                                        )

                                                        @Model.Assets[i].AssetName

                                                    </td>

                                                    <td class="text-end">

                                                        <button type="button"
                                                                id="btnRemove@i"
                                                                name="btnRemove@i"
                                                                onclick="deleteRow(@i)"
                                                                class="btn btn-sm btn-danger">

                                                            <i class="align-middle" data-lucide="trash-2"></i>

                                                        </button>

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                id="btnSave"
                                class="btn btn-sm btn-primary btnSubmitDisable">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            loadChangeAreas();
            loadAssetCategory();

            $("#AssetItemId").select2({
                width: "100%"
            });

            toggleDowntime();


            $("#IsDowntimeRequired").on("change", function () {
                toggleDowntime();
            });


            $("#ChangeAreaId").on("change", function () {
                loadChangeTypes();
            });


            $("#AssetCategoryId").on("change", function () {
                loadAssetType();
                loadAssets();
            });


            $("#AssetTypeId").on("change", function () {
                loadAssets();
            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return $("<div/>")
                .text(value)
                .html();

        }


        function toggleDowntime() {

            if ($("#IsDowntimeRequired").is(":checked")) {
                $("#downtime").show();
            }
            else {
                $("#downtime").hide();
            }

        }


        function loadChangeAreas() {

            var categoryId =
                $("#ChangeRequest_ChangeRequestCategoryId").val();


            $.getJSON(

                '@Url.Action("GetItemsByRequestCategoryJsonResult", "ChangeArea")',

                {
                    changeRequestCategoryId: categoryId
                },

                function (data) {

                    var dropDown =
                        $("#ChangeAreaId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.ChangeAreaId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.ChangeAreaId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    loadChangeTypes();

                }
            );

        }


        function loadChangeTypes() {

            var areaId =
                $("#ChangeAreaId").val();


            $.getJSON(

                '@Url.Action("GetItemsByAreaJsonResult", "ChangeType")',

                {
                    changeAreaId: areaId
                },

                function (data) {

                    var dropDown =
                        $("#ChangeTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.ChangeTypeId,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.ChangeTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function addChangeType() {

            var typeId =
                $("#ChangeTypeId").val();

            var typeName =
                $("#ChangeTypeId option:selected").text();


            if (!typeId || typeId === "0") {

                Swal.fire(
                    "Error!",
                    "Please select a change type",
                    "error"
                );

                return;

            }


            var duplicate =
                false;


            $("#changetype input.iHidden").each(function () {

                if (String($(this).val()) === String(typeId)) {

                    duplicate = true;

                    return false;

                }

            });


            if (duplicate) {

                Swal.fire(
                    "Error!",
                    "Change type already added",
                    "error"
                );

                return;

            }


            var itemIndex =
                $("#changetype tr").length;


            var safeTypeName =
                escapeHtml(typeName);


            var newItem =

                "<tr id='" + itemIndex + "'>" +

                    "<td>" +

                        "<input " +
                            "id='ChangeRequestTasks_" + itemIndex + "__ChangeTypeId' " +
                            "class='iHidden' " +
                            "name='ChangeRequestTasks[" + itemIndex + "].ChangeTypeId' " +
                            "type='hidden' " +
                            "value='" + typeId + "' />" +

                        "<input " +
                            "id='ChangeRequestTasks_" + itemIndex + "__ChangeType_Name' " +
                            "name='ChangeRequestTasks[" + itemIndex + "].ChangeType.Name' " +
                            "type='hidden' " +
                            "value='" + safeTypeName + "' />" +

                        safeTypeName +

                    "</td>" +

                    "<td class='text-end'>" +

                        "<button " +
                            "type='button' " +
                            "id='btnRemove" + itemIndex + "' " +
                            "name='btnRemove" + itemIndex + "' " +
                            "onclick='deleteRowChangeType(" + itemIndex + ")' " +
                            "class='btn btn-sm btn-danger'>" +

                            "<i data-lucide='trash-2'></i>" +

                        "</button>" +

                    "</td>" +

                "</tr>";


            $("#changetype")
                .append(newItem);


            if (window.lucide) {
                lucide.createIcons();
            }

        }


        function deleteRowChangeType(index) {

            $("#changetype #" + index)
                .remove();

            UpdateIndexesChangeType();

        }


        function UpdateIndexesChangeType() {

            $("#changetype tr").each(function (index) {

                $(this)
                    .attr("id", index);


                var typeIdInput =
                    $(this).find("input[name$='.ChangeTypeId']");

                var typeNameInput =
                    $(this).find("input[name$='.ChangeType.Name']");


                typeIdInput.attr({
                    id: "ChangeRequestTasks_" + index + "__ChangeTypeId",
                    name: "ChangeRequestTasks[" + index + "].ChangeTypeId"
                });


                typeNameInput.attr({
                    id: "ChangeRequestTasks_" + index + "__ChangeType_Name",
                    name: "ChangeRequestTasks[" + index + "].ChangeType.Name"
                });


                var removeButton =
                    $(this).find("button");


                removeButton.attr({
                    id: "btnRemove" + index,
                    name: "btnRemove" + index,
                    onclick: "deleteRowChangeType(" + index + ")"
                });

            });

        }


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    loadAssetType();

                }
            );

        }


        function loadAssetType() {

            var categoryId =
                $("#AssetCategoryId").val();


            $.getJSON(

                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',

                {
                    assetCategory: categoryId
                },

                function (data) {

                    var dropDown =
                        $("#AssetTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.AssetTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    loadAssets();

                }
            );

        }


        function loadAssets() {

            var categoryId =
                $("#AssetCategoryId").val();

            var typeId =
                $("#AssetTypeId").val();


            $.getJSON(

                '@Url.Action("GetAssetListAvbJsonResult", "Asset")',

                {
                    branchId: 0,
                    deptId: 0,
                    assetCatId: categoryId,
                    assetTypeId: typeId
                },

                function (data) {

                    var dropDown =
                        $("#AssetItemId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetId,
                                    text: item.AssetNo + " - " + item.Barcode
                                })
                            );

                        }
                    );


                    dropDown.trigger("change.select2");

                }
            );

        }


        function addAsset() {

            var assetId =
                $("#AssetItemId").val();

            var assetName =
                $("#AssetItemId option:selected").text();


            if (!assetId || assetId === "0") {

                Swal.fire(
                    "Error!",
                    "Please select an asset",
                    "error"
                );

                return;

            }


            var duplicate =
                false;


            $("#assetdata input[name$='.AssetId']").each(function () {

                if (String($(this).val()) === String(assetId)) {

                    duplicate = true;

                    return false;

                }

            });


            if (duplicate) {

                Swal.fire(
                    "Error!",
                    "Asset already added",
                    "error"
                );

                return;

            }


            var itemIndex =
                $("#assetdata tr").length;


            var safeAssetName =
                escapeHtml(assetName);


            var newItem =

                "<tr id='" + itemIndex + "'>" +

                    "<td>" +

                        "<input " +
                            "id='Assets_" + itemIndex + "__AssetId' " +
                            "class='iHidden' " +
                            "name='Assets[" + itemIndex + "].AssetId' " +
                            "type='hidden' " +
                            "value='" + assetId + "' />" +

                        "<input " +
                            "id='Assets_" + itemIndex + "__AssetName' " +
                            "name='Assets[" + itemIndex + "].AssetName' " +
                            "type='hidden' " +
                            "value='" + safeAssetName + "' />" +

                        safeAssetName +

                    "</td>" +

                    "<td class='text-end'>" +

                        "<button " +
                            "type='button' " +
                            "id='btnRemove" + itemIndex + "' " +
                            "name='btnRemove" + itemIndex + "' " +
                            "onclick='deleteRow(" + itemIndex + ")' " +
                            "class='btn btn-sm btn-danger'>" +

                            "<i data-lucide='trash-2'></i>" +

                        "</button>" +

                    "</td>" +

                "</tr>";


            $("#assetdata")
                .append(newItem);


            if (window.lucide) {
                lucide.createIcons();
            }

        }


        function deleteRow(index) {

            $("#assetdata #" + index)
                .remove();

            UpdateIndexes(index);

        }


        function UpdateIndexes() {

            $("#assetdata tr").each(function (index) {

                $(this)
                    .attr("id", index);


                var assetIdInput =
                    $(this).find("input[name$='.AssetId']");

                var assetNameInput =
                    $(this).find("input[name$='.AssetName']");


                assetIdInput.attr({
                    id: "Assets_" + index + "__AssetId",
                    name: "Assets[" + index + "].AssetId"
                });


                assetNameInput.attr({
                    id: "Assets_" + index + "__AssetName",
                    name: "Assets[" + index + "].AssetName"
                });


                var removeButton =
                    $(this).find("button");


                removeButton.attr({
                    id: "btnRemove" + index,
                    name: "btnRemove" + index,
                    onclick: "deleteRow(" + index + ")"
                });

            });

        }


        function removeItems() {

            $("#assetdata")
                .empty();

        }

    </script>
}