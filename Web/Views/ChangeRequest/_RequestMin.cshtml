@model Domain.CM.ChangeRequest
@using Service.CM
@using Service

<div class="row g-4">

    <div class="col-sm-8">

        <div class="mb-3">
            <div class="fw-semibold mb-1">
                @Html.DisplayNameFor(model => model.Subject)
            </div>

            <div class="text-muted">
                @Model.Subject
            </div>
        </div>

        <hr />

        <div class="mb-3">
            <div class="fw-semibold mb-1">
                @Html.DisplayNameFor(model => model.Description)
            </div>

            <div class="text-muted" style="white-space: pre-wrap;">
                @Model.Description
            </div>
        </div>

        <hr />

        <div class="mb-3">
            <div class="fw-semibold mb-1">
                @Html.DisplayNameFor(model => model.Justification)
            </div>

            <div class="text-muted" style="white-space: pre-wrap;">
                @Model.Justification
            </div>
        </div>

        <hr />

        <dl class="row mb-0">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DurationType)
            </dt>

            <dd class="col-sm-3">
                @Model.DurationType.EnumDisplayName()
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ExpireDate)
            </dt>

            <dd class="col-sm-3">

                @if (Model.DurationType == Domain.AssignedTypeEnum.Permanent)
                {
                    <span class="text-muted">N/A</span>
                }
                else
                {
                    @Model.ExpireDate.ToShortDateString()
                }

            </dd>

            <dt class="col-sm-3">
                Request Type
            </dt>

            <dd class="col-sm-3">
                @Model.ChangeRequestCategory.Name
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RequestedDate)
            </dt>

            <dd class="col-sm-3">
                @Model.RequestedDate.ToShortDateString()
            </dd>

        </dl>


        @if (Model.ChangeImplementData != null)
        {
            <hr />

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeAreaId)
                </dt>

                <dd class="col-sm-3">
                    @Model.ChangeImplementData.ChangeArea.Name
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeCategory)
                </dt>

                <dd class="col-sm-3">
                    @Model.ChangeImplementData.ChangeCategory.EnumDisplayName()
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ChangeImplementData.ChangePriority)
                </dt>

                <dd class="col-sm-3">
                    @Model.ChangeImplementData.ChangePriority.EnumDisplayName()
                </dd>

            </dl>
        }

    </div>


    <div class="col-sm-4">

        <div class="card mb-3">

            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="user"></i>
                    Requester
                </h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <div class="fw-semibold">
                        @Model.RequestedBy - @Model.RequestedUser.FullName
                    </div>
                </div>

                <div class="d-flex align-items-center mb-2">
                    <i class="align-middle me-2" data-lucide="briefcase"></i>
                    <span>@Model.RequestedUser.DesignationName</span>
                </div>

                <div class="d-flex align-items-center mb-2">
                    <i class="align-middle me-2" data-lucide="phone"></i>
                    <span>@Model.RequestedUser.ContactNo</span>
                </div>

                <div class="d-flex align-items-center">
                    <i class="align-middle me-2" data-lucide="mail"></i>
                    <span>@Model.RequestedUser.Email</span>
                </div>

            </div>

        </div>


        @if (Model.ApprovalByUser != null)
        {
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="shield-check"></i>
                        Approver
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <div class="fw-semibold">
                            @Model.ApprovalBy - @Model.ApprovalByUser.FullName
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                        <i class="align-middle me-2" data-lucide="briefcase"></i>
                        <span>@Model.ApprovalByUser.DesignationName</span>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                        <i class="align-middle me-2" data-lucide="phone"></i>
                        <span>@Model.ApprovalByUser.ContactNo</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <i class="align-middle me-2" data-lucide="mail"></i>
                        <span>@Model.ApprovalByUser.Email</span>
                    </div>

                </div>

            </div>
        }

    </div>

</div>