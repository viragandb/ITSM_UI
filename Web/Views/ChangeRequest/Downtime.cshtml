@model Web.Models.ChangeDowntimeVM
@using Service.CM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Downtime", "ChangeRequest", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.ChangeImplementDataId)
    @Html.HiddenFor(model => model.ChangeRequestId)
    @Html.HiddenFor(model => model.ChangeImplementData.ChangeRequest.ChangeRequestCategoryId)

    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <div>

                        <h5 class="card-title mb-1">
                            Request #@Model.ChangeRequestId
                        </h5>

                        <div class="text-muted">

                            <i class="align-middle me-1" data-lucide="layers"></i>
                            @Model.ChangeImplementData.ChangeRequest.ChangeRequestCategory.Name

                        </div>

                    </div>

                    @if (Model.ChangeImplementData.ChangeRequest.TeamId != null)
                    {
                        <span class="badge bg-@ChangeRequestService.GetStatusColor(Model.ChangeImplementData.ChangeRequest.Status)">

                            @Model.ChangeImplementData.ChangeRequest.Team.TeamName

                        </span>
                    }

                </div>

                <div class="card-body">

                    @Html.Partial("_RequestMin", Model.ChangeImplementData.ChangeRequest)

                    <hr />

                    <dl class="row mb-4">

                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeAreaId)
                        </dt>

                        <dd class="col-sm-4">
                            @Model.ChangeImplementData.ChangeArea.Name
                        </dd>

                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeCategory)
                        </dt>

                        <dd class="col-sm-4">
                            @Model.ChangeImplementData.ChangeCategory
                        </dd>


                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.ChangeRequestTasks)
                        </dt>

                        <dd class="col-sm-10">

                            @foreach (var task in Model.ChangeImplementData.ChangeRequestTasks)
                            {
                                <div>
                                    @task.ChangeType.Name
                                </div>
                            }

                        </dd>


                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.PlannedChange)
                        </dt>

                        <dd class="col-sm-10">
                            @Model.ChangeImplementData.PlannedChange
                        </dd>


                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.RiskAssessment)
                        </dt>

                        <dd class="col-sm-10">
                            @Model.ChangeImplementData.RiskAssessment
                        </dd>


                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChangeImplementData.RollbackPlan)
                        </dt>

                        <dd class="col-sm-10">
                            @Model.ChangeImplementData.RollbackPlan
                        </dd>

                    </dl>


                    <div class="row g-3">

                        <div class="col-md-8">

                            <div class="mb-3">

                                @Html.LabelFor(
                                    model => model.Downtime,
                                    new { @class = "form-label" }
                                )

                                @Html.TextBoxFor(
                                    model => model.Downtime,
                                    new { @class = "form-control" }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.Downtime,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="mb-3"
                                 id="Downtime_Date">

                                @Html.LabelFor(
                                    model => model.DowntimePlannedDate,
                                    new { @class = "form-label" }
                                )

                                @Html.TextBoxFor(
                                    model => model.DowntimePlannedDate,
                                    "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "date"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.DowntimePlannedDate,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.DowntimeImpactedAreas,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.DowntimeImpactedAreas,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.DowntimeImpactedAreas,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-3">

                        @Html.LabelFor(
                            model => model.DowntimeTimePeriod,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.DowntimeTimePeriod,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.DowntimeTimePeriod,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="mb-4">

                        @Html.LabelFor(
                            model => model.DowntimeTimePurpose,
                            new { @class = "form-label" }
                        )

                        @Html.TextAreaFor(
                            model => model.DowntimeTimePurpose,
                            new
                            {
                                @class = "form-control",
                                rows = "3",
                                style = "white-space: pre-wrap;"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.DowntimeTimePurpose,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <div class="card">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                <i class="align-middle me-2" data-lucide="mail"></i>
                                Email Recipients
                            </h5>

                        </div>

                        <div class="card-body">

                            <div class="row g-3 align-items-end">

                                <div class="col-md-5">

                                    <label for="Email"
                                           class="form-label">
                                        Email Recipient
                                    </label>

                                    <input type="email"
                                           id="Email"
                                           name="Email"
                                           placeholder="Email"
                                           class="form-control" />

                                </div>

                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-info btn-sm"
                                            onclick="addEmail()">

                                        <i class="align-middle me-1" data-lucide="plus"></i>
                                        Add

                                    </button>

                                </div>

                                <div class="col-md-5">

                                    <div class="table-responsive">

                                        <table id="dataTable"
                                               class="table table-striped table-hover align-middle mb-0">

                                            <thead>
                                                <tr>
                                                    <th>Email/s</th>
                                                    <th class="text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody id="emailAlert">

                                                @if (Model.DowntimeAlertEmails != null)
                                                {
                                                    for (var i = 0; i < Model.DowntimeAlertEmails.Count; i++)
                                                    {
                                                        <tr id="@i">

                                                            <td>

                                                                @Html.HiddenFor(
                                                                    m => Model.DowntimeAlertEmails[i].Email,
                                                                    new { @class = "iHidden" }
                                                                )

                                                                @Model.DowntimeAlertEmails[i].Email

                                                            </td>

                                                            <td class="text-end">

                                                                <button type="button"
                                                                        id="btnRemove@i"
                                                                        name="btnRemove@i"
                                                                        onclick="deleteRowEmail(@i)"
                                                                        class="btn btn-sm btn-danger">

                                                                    <i class="align-middle" data-lucide="trash-2"></i>

                                                                </button>

                                                            </td>

                                                        </tr>
                                                    }
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                id="btnSave"
                                class="btn btn-sm btn-primary btnSubmitDisable">

                            <i class="align-middle me-1" data-lucide="send"></i>
                            Send Email

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return $("<div/>")
                .text(value)
                .html();

        }


        function addEmail() {

            var email =
                $.trim($("#Email").val());

            if (!email) {

                Swal.fire(
                    "Error!",
                    "Please enter a valid email",
                    "error"
                );

                return;

            }


            var duplicate =
                false;


            $("#emailAlert input.iHidden").each(function () {

                if (
                    String($(this).val()).toLowerCase() ===
                    email.toLowerCase()
                ) {

                    duplicate = true;

                    return false;

                }

            });


            if (duplicate) {

                Swal.fire(
                    "Error!",
                    "Email already added",
                    "error"
                );

                return;

            }


            var itemIndex =
                $("#emailAlert tr").length;


            var safeEmail =
                escapeHtml(email);


            var newItem =
                "<tr id='" + itemIndex + "'>" +

                "<td>" +

                "<input " +
                "class='iHidden' " +
                "id='DowntimeAlertEmails_" + itemIndex + "__Email' " +
                "name='DowntimeAlertEmails[" + itemIndex + "].Email' " +
                "type='hidden' " +
                "value='" + safeEmail + "' />" +

                safeEmail +

                "</td>" +

                "<td class='text-end'>" +

                "<button " +
                "type='button' " +
                "id='btnRemove" + itemIndex + "' " +
                "name='btnRemove" + itemIndex + "' " +
                "onclick='deleteRowEmail(" + itemIndex + ")' " +
                "class='btn btn-sm btn-danger'>" +

                "<i data-lucide='trash-2'></i>" +

                "</button>" +

                "</td>" +

                "</tr>";


            $("#emailAlert")
                .append(newItem);


            $("#Email")
                .val("");


            if (window.lucide) {
                lucide.createIcons();
            }

        }


        function deleteRowEmail(index) {

            $("#emailAlert #" + index)
                .remove();

            UpdateIndexesEmail();

        }


        function UpdateIndexesEmail() {

            $("#emailAlert tr").each(function (index) {

                $(this)
                    .attr("id", index);


                var emailInput =
                    $(this).find("input.iHidden");


                emailInput.attr({
                    id: "DowntimeAlertEmails_" + index + "__Email",
                    name: "DowntimeAlertEmails[" + index + "].Email"
                });


                var removeButton =
                    $(this).find("button");


                removeButton.attr({
                    id: "btnRemove" + index,
                    name: "btnRemove" + index,
                    onclick: "deleteRowEmail(" + index + ")"
                });

            });

        }

    </script>
}