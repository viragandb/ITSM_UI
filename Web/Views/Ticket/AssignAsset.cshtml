@model Web.Models.AssignAssetVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.HiddenFor(model => model.ItemId)

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="boxes"></i>
                    Ticket @Model.Ticket.Code - Assign Asset
                </h5>

                <a href="@Url.Action("AssignAssetDoc", "Ticket")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            <div class="card-body">

                @Html.Partial("_Ticket", Model.Ticket)

                <div class="row mt-4">
                    <div class="col-12">

                        <div class="card">

                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="link"></i>
                                    Ticket Assets
                                </h5>
                            </div>

                            <div class="card-body">

                                <div class="table-responsive">

                                    <table id="dataTable"
                                           class="table table-striped table-hover align-middle w-100">

                                        <thead>
                                            <tr>
                                                <th>Asset #</th>
                                                <th>Asset Type</th>
                                                <th>Make</th>
                                                <th>Model</th>
                                                <th>Serial #</th>
                                                <th>Bar Code</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @foreach (var item in Model.AssignedItems)
                                            {
                                                <tr>

                                                    <td>@item.Asset.AssetNo</td>

                                                    <td>
                                                        @(item.Asset.AssetType != null
                                                            ? item.Asset.AssetType.AssetTypeName
                                                            : "N/A")
                                                    </td>

                                                    <td>
                                                        @(item.Asset.AssetMake != null
                                                            ? item.Asset.AssetMake.Name
                                                            : "N/A")
                                                    </td>

                                                    <td>@item.Asset.ModelName</td>

                                                    <td>@item.Asset.SerialNo</td>

                                                    <td>@item.Asset.Barcode</td>

                                                    <td class="text-end">

                                                        <button type="button"
                                                                class="btn btn-sm btn-danger removeAsset"
                                                                onclick="removeAssetTicket('@item.ItemAssetId')">

                                                            <i class="align-middle me-1"
                                                               data-lucide="unlink"></i>

                                                            Unassign

                                                        </button>

                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>


                <div class="row mt-3">
                    <div class="col-12">

                        <div class="card">

                            <div class="card-header">

                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="map-pin"></i>
                                    Available Assets of
                                    @(Model.Ticket.Branch != null
                                        ? Model.Ticket.Branch.Name
                                        : "Selected Location")
                                </h5>

                            </div>

                            <div class="card-body">

                                <div class="table-responsive">

                                    <table id="dataTableLoc"
                                           class="table table-striped table-hover align-middle w-100">

                                        <thead>
                                            <tr>
                                                <th>Asset #</th>
                                                <th>Asset Type</th>
                                                <th>Make</th>
                                                <th>Model</th>
                                                <th>Serial #</th>
                                                <th>Bar Code</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @foreach (var item in Model.LocationItems)
                                            {
                                                <tr>

                                                    <td>@item.AssetNo</td>

                                                    <td>
                                                        @(item.AssetType != null
                                                            ? item.AssetType.AssetTypeName
                                                            : "N/A")
                                                    </td>

                                                    <td>
                                                        @(item.AssetMake != null
                                                            ? item.AssetMake.Name
                                                            : "N/A")
                                                    </td>

                                                    <td>@item.ModelName</td>

                                                    <td>@item.SerialNo</td>

                                                    <td>@item.Barcode</td>

                                                    <td class="text-end">

                                                        <button type="button"
                                                                class="btn btn-sm btn-info text-white addAsset"
                                                                onclick="assignAssetTicket('@item.AssetId')">

                                                            <i class="align-middle me-1"
                                                               data-lucide="link"></i>

                                                            Assign

                                                        </button>

                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

            $("#dataTableLoc").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

        });


        function assignAssetTicket(assetId) {

            var itemId = $("#ItemId").val();

            if (!itemId) {

                Swal.fire(
                    "Something went wrong!",
                    "Please try again",
                    "error"
                );

                return;
            }

            $(".addAsset").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("AssignAssetTicket", "ItemAsset")',

                type: "GET",

                dataType: "json",

                data: {
                    itemId: itemId,
                    assetId: assetId
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Asset has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        $(".addAsset").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $(".addAsset").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function removeAssetTicket(itemId) {

            $(".removeAsset").prop("disabled", true);

            $.ajax({

                url: '@Url.Action("RemoveAssetTicket", "ItemAsset")',

                type: "GET",

                dataType: "json",

                data: {
                    itemId: itemId
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Asset has been unassigned",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        $(".removeAsset").prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $(".removeAsset").prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }

    </script>
}