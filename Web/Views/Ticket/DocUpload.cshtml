@model Web.Models.DocUploadVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="file-text"></i>
                    Ticket # @Model.Ticket.Code - Documents
                </h5>

                <div class="d-flex gap-2">

                    <a href="@Html.EncodedActionLink("", "Info", "Ticket", "", new { id = Model.TicketId }, null)"
                       target="_blank"
                       class="btn btn-sm btn-light">

                        <i class="align-middle" data-lucide="info"></i>

                    </a>

                    <a href="@Url.Action(Model.BackAction, Model.BackController)"
                       class="btn btn-sm btn-info text-white">

                        <i class="align-middle me-1" data-lucide="arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

            <div class="card-body">

                <div class="row">
                    <div class="col-12">

                        @Html.Partial("_Ticket", Model.Ticket)

                    </div>
                </div>

                <div class="row g-3 mt-2">

                    <div class="col-lg-5">

                        <div class="card">

                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="align-middle me-2" data-lucide="folder"></i>
                                    Documents
                                </h5>
                            </div>

                            <div class="card-body">

                                @foreach (var item in Model.TicketDocs)
                                {
                                    <div class="d-flex justify-content-between align-items-center gap-2 border-bottom py-2">

                                        <div class="text-truncate">

                                            <a href="@item.FileUrl"
                                               target="_blank"
                                               class="text-decoration-none">

                                                <i class="align-middle me-1" data-lucide="file-text"></i>
                                                @item.DocumentName

                                            </a>

                                        </div>

                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Delete"
                                                onclick="deleteItem('@item.TicketDocId')">

                                            <i class="align-middle" data-lucide="trash-2"></i>

                                        </button>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-7">

                        @using (Html.BeginForm(
                            "DocUpload",
                            "Ticket",
                            FormMethod.Post,
                            new
                            {
                                enctype = "multipart/form-data"
                            }))
                        {
                            @Html.HiddenFor(model => model.Ticket.TicketId)
                            @Html.HiddenFor(model => model.BackAction)
                            @Html.HiddenFor(model => model.BackController)

                            <div class="card">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="upload"></i>
                                        Upload Documents
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="mb-3">

                                        @Html.LabelFor(
                                            model => model.FileName,
                                            new { @class = "form-label" }
                                        )

                                        @Html.TextBoxFor(
                                            model => model.FileName,
                                            new { @class = "form-control" }
                                        )

                                        @Html.ValidationMessageFor(
                                            model => model.FileName,
                                            "",
                                            new { @class = "text-danger" }
                                        )

                                    </div>

                                    <div class="mb-0">

                                        <label for="itemFile"
                                               class="form-label">
                                            Select File
                                        </label>

                                        <input type="file"
                                               name="itemFile"
                                               id="itemFile"
                                               class="form-control" />

                                    </div>

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex justify-content-end">

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">

                                            <i class="align-middle me-1" data-lucide="upload"></i>
                                            Upload

                                        </button>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        function deleteItem(itemId) {

            Swal.fire({

                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true

            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("DeleteDoc", "Ticket")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);

                            }
                            else if (data == "2" || data == 2) {

                                Swal.fire(
                                    "Data in use!",
                                    "Data is currently in use and cannot be deleted",
                                    "error"
                                );

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted, Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted, Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }

    </script>
}