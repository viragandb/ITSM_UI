@using Service
@model IEnumerable<Domain.Ticket>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "Ticket", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="ticket"></i>
                        Tickets
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="TeamId" class="form-label">
                                Team
                            </label>

                            <select id="TeamId"
                                    name="TeamId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TeamId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="TicketTypeId" class="form-label">
                                Ticket Type
                            </label>

                            <select id="TicketTypeId"
                                    name="TicketTypeId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TicketTypeId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="CategoryId" class="form-label">
                                Category
                            </label>

                            <select id="CategoryId"
                                    name="CategoryId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="CategoryId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="AllocatedTypeId" class="form-label">
                                Allocated Type
                            </label>

                            <select id="AllocatedTypeId"
                                    name="AllocatedTypeId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="AllocatedTypeId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="UserEmpNo" class="form-label">
                                Assigned To
                            </label>

                            <select id="UserEmpNo"
                                    name="UserEmpNo"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="UserEmpNo"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label for="TicketMediumId" class="form-label">
                                Ticket Medium
                            </label>

                            <select id="TicketMediumId"
                                    name="TicketMediumId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TicketMediumId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="StartDate" class="form-label">
                                Requested Date From
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="StartDate"
                                   value="@ViewBag.StartDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-3">

                            <label for="EndDate" class="form-label">
                                Requested Date To
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="EndDate"
                                   value="@ViewBag.EndDate"
                                   class="form-control" />

                        </div>

                        <div class="col-md-3 d-flex align-items-end">

                            <div class="form-check mb-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="checkBoxSLA"
                                       name="checkBoxSLA"
                                       @ViewBag.SLA />

                                <label for="checkBoxSLA"
                                       class="form-check-label">
                                    SLA Violations
                                </label>

                            </div>

                        </div>

                        <div class="col-md-3 d-flex align-items-end">

                            <div class="form-check mb-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="checkBoxOnGoing"
                                       name="checkBoxOnGoing"
                                       @ViewBag.OnGoing />

                                <label for="checkBoxOnGoing"
                                       class="form-check-label">
                                    On Going
                                </label>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <label for="TicketCode" class="form-label">
                                Ticket #
                            </label>

                            <input type="text"
                                   id="TicketCode"
                                   name="TicketCode"
                                   value="@ViewBag.TicketCode"
                                   class="form-control" />

                        </div>

                        <div class="col-md-4">

                            <label for="StatusId" class="form-label">
                                Status
                            </label>

                            <select id="StatusId"
                                    name="StatusId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="StatusId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label for="VendorId" class="form-label">
                                Vendor
                            </label>

                            <select id="VendorId"
                                    name="VendorId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="list"></i>
                        Ticket Results
                    </h5>
                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>
                                <tr>
                                    <th>Ticket Id</th>
                                    <th>Category</th>
                                    <th>Asset Type</th>
                                    <th>Subcategory</th>
                                    <th>Ticket Medium</th>
                                    <th>Priority</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Request By</th>
                                    <th>Created By</th>
                                    <th>Assigned To</th>
                                    <th>Requested Date</th>
                                    <th>Last Updated Date</th>
                                    <th>Root Cause</th>
                                    <th>Corrective Action</th>
                                    <th>Preventive Action</th>
                                    <th>Lessons Learnt</th>
                                    <th>Spent Hrs</th>
                                    <th>Vendor</th>
                                    <th>Latest Comment</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    var latestUpdate = item.TicketUpdates != null
                                        ? item.TicketUpdates
                                            .OrderByDescending(u => u.UpdatedDate)
                                            .FirstOrDefault()
                                        : null;

                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "Info", "Ticket", "", new { id = item.TicketId }, null)"
                                               target="_blank">
                                                @item.Code
                                            </a>

                                        </td>

                                        <td>

                                            @if (item.RequestType != null &&
                                                 item.RequestType.Category != null)
                                            {
                                                <span class="badge bg-@TicketService.GetTicketTypeColor(item.RequestType.TicketType)">
                                                    @item.RequestType.Category.CategoryName
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @(item.RequestType != null &&
                                              item.RequestType.AssetType != null
                                                ? item.RequestType.AssetType.AssetTypeName
                                                : "")
                                        </td>

                                        <td>
                                            @(item.RequestType != null &&
                                              item.RequestType.SubCategory != null
                                                ? item.RequestType.SubCategory.SubCategoryName
                                                : "")
                                        </td>

                                        <td>
                                            @item.TicketMedium.EnumDisplayName()
                                        </td>

                                        <td>

                                            @if (item.RequestType != null &&
                                                 item.RequestType.TicketType == Domain.TicketTypeEnum.IN)
                                            {
                                                @item.Priority.EnumDisplayName()
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }

                                        </td>

                                        <td>
                                            @(item.Branch != null
                                                ? item.Branch.Name
                                                : "")
                                        </td>

                                        <td>

                                            <div class="d-flex flex-wrap gap-1">

                                                <span class="badge bg-@TicketService.GetTicketStatusColor(item.Status)">
                                                    @item.Status.EnumDisplayName()
                                                </span>

                                                @if (item.IsTimeViolated)
                                                {
                                                    <span class="badge bg-danger">
                                                        SLA Violated
                                                    </span>
                                                }

                                            </div>

                                        </td>

                                        <td>
                                            @(item.RequestedUser != null
                                                ? item.RequestedUser.FullName
                                                : "")
                                        </td>

                                        <td>
                                            @(item.CreatedUser != null
                                                ? item.CreatedUser.FullName
                                                : "")
                                        </td>

                                        <td>
                                            @(item.AssignedToUser != null
                                                ? item.AssignedToUser.FullName
                                                : "")
                                        </td>

                                        <td>
                                            @item.RequestedDate
                                        </td>

                                        <td>
                                            @item.UpdatedDate
                                        </td>

                                        @if (item.RequestType != null &&
                                             item.RequestType.TicketType == Domain.TicketTypeEnum.SR)
                                        {
                                            <td>N/A</td>
                                            <td>N/A</td>
                                            <td>N/A</td>
                                            <td>N/A</td>
                                        }
                                        else
                                        {
                                            <td>@item.RootCause</td>
                                            <td>@item.CorrectiveAction</td>
                                            <td>@item.PreventiveAction</td>
                                            <td>@item.LessonsLearnt</td>
                                        }

                                        <td class="text-end">
                                            @item.SpentTime
                                        </td>

                                        <td>
                                            @(item.Vendor != null
                                                ? item.Vendor.VendorName
                                                : "")
                                        </td>

                                        <td>

                                            @if (latestUpdate != null)
                                            {
                                                @latestUpdate.Comment
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    No comments yet
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row g-3">

        <div class="col-lg-4">

            <div class="card h-100">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="chart-no-axes-column"></i>
                        Status Summary
                    </h5>

                </div>

                <div class="card-body">

                    @foreach (Domain.TicketStatusEnum item in Enum.GetValues(typeof(Domain.TicketStatusEnum)))
                    {
                        var count = Model.Count(w => w.Status == item);

                        if (count > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span class="badge bg-@TicketService.GetTicketStatusColor(item)">
                                    @item.EnumDisplayName()
                                </span>

                                <strong>
                                    @count
                                </strong>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="card h-100">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="layers"></i>
                        Ticket Type Summary
                    </h5>

                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="badge bg-@TicketService.GetTicketTypeColor(Domain.TicketTypeEnum.SR)">
                            @Domain.TicketTypeEnum.SR.EnumDisplayName()
                        </span>

                        <strong>
                            @Model.Count(w =>
                                w.RequestType != null &&
                                w.RequestType.TicketType == Domain.TicketTypeEnum.SR)
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="badge bg-@TicketService.GetTicketTypeColor(Domain.TicketTypeEnum.IN)">
                            @Domain.TicketTypeEnum.IN.EnumDisplayName()
                        </span>

                        <strong>
                            @Model.Count(w =>
                                w.RequestType != null &&
                                w.RequestType.TicketType == Domain.TicketTypeEnum.IN)
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({

                responsive: true,
                lengthChange: false,
                autoWidth: false,
                paging: false,

                buttons: [

                    {
                        extend: "excelHtml5",
                        text: "Excel",
                        title: "Tickets",
                        exportOptions: {
                            modifier: {
                                page: "current"
                            }
                        }
                    },

                    {
                        extend: "pdfHtml5",
                        text: "PDF",
                        title: "Tickets",
                        orientation: "landscape",
                        exportOptions: {
                            modifier: {
                                page: "current"
                            }
                        }
                    },

                    {
                        extend: "print",
                        text: "Print",
                        title: "Tickets",
                        autoPrint: true
                    },

                    "colvis"

                ]

            }).buttons().container()
              .appendTo("#dataTable_wrapper .col-md-6:eq(0)");


            loadTeams();
            loadTicketTypes();
            loadStatus();
            loadCategory();
            loadAllocatedTypes();
            loadTicketMediums();
            loadVendor();

        });


        $("#TeamId").on("change", function () {
            loadUsers();
        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadTeams() {

            var dropDown = $("#TeamId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.TeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    loadUsers();

                }
            );

        }


        function loadUsers() {

            var teamId = $("#TeamId").val();

            var dropDown = $("#UserEmpNo");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetUsersByTeamIdJsonResult", "User")',
                {
                    teamId: teamId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.EmpNo,
                                    text:
                                        item.EmpNo +
                                        " - " +
                                        item.FullName +
                                        " (" +
                                        item.DesignationName +
                                        ")"
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.UserEmpNo';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadTicketTypes() {

            var dropDown = $("#TicketTypeId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetTicketTypesJsonResult", "RequestType")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.TicketTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadTicketMediums() {

            var dropDown = $("#TicketMediumId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetTicketMediumJsonResult", "RequestType")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.TicketMediumId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadAllocatedTypes() {

            var dropDown = $("#AllocatedTypeId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetAllocatedTypesJsonResult", "Ticket")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.AllocatedTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadStatus() {

            var dropDown = $("#StatusId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetStatusJsonResult", "Ticket")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.StatusId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadCategory() {

            var dropDown = $("#CategoryId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetCategoryListJsonResult", "Category")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.CategoryId,
                                    text: item.CategoryName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.CategoryId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadVendor() {

            var dropDown = $("#VendorId");

            dropDown.empty();
            dropDown.append("<option value='0'>-- All --</option>");


            $.getJSON(
                '@Url.Action("GetVendorListJsonResult", "Vendor")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.VendorId,
                                    text: item.VendorName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.VendorId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}