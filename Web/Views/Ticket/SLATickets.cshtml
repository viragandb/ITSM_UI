@model ICollection<Domain.Ticket>
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("SLATickets", "Ticket", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="ticket"></i>
                        Tickets
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="CompanyId" class="form-label">
                                Company
                            </label>

                            <select id="CompanyId"
                                    name="CompanyId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="CompanyId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label for="CategoryId" class="form-label">
                                Category
                            </label>

                            <select id="CategoryId"
                                    name="CategoryId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="CategoryId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label for="StatusId" class="form-label">
                                Status
                            </label>

                            <select id="StatusId"
                                    name="StatusId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="StatusId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="accordion" id="slaTicketAccordion">

                        @foreach (var item in Model)
                        {
                            var collapseId = "ticket_" + item.TicketId;

                            <div class="accordion-item">

                                <h2 class="accordion-header"
                                    id="heading_@item.TicketId">

                                    <button class="accordion-button collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">

                                        <div class="w-100 d-flex justify-content-between align-items-center flex-wrap gap-2 me-3">

                                            <div>

                                                <strong>
                                                    @item.Code
                                                </strong>

                                                <span class="mx-2 text-muted">|</span>

                                                @(item.RequestType != null && item.RequestType.Category != null
                                                    ? item.RequestType.Category.CategoryName
                                                    : "N/A")

                                                <i class="align-middle mx-1"
                                                   data-lucide="chevrons-right"></i>

                                                @(item.RequestType != null && item.RequestType.AssetType != null
                                                    ? item.RequestType.AssetType.AssetTypeName
                                                    : "N/A")

                                                <i class="align-middle mx-1"
                                                   data-lucide="chevrons-right"></i>

                                                <strong>
                                                    @(item.RequestType != null && item.RequestType.SubCategory != null
                                                        ? item.RequestType.SubCategory.SubCategoryName
                                                        : "N/A")
                                                </strong>

                                            </div>

                                            <div class="text-muted small">

                                                @(item.Department != null
                                                    ? item.Department.DepartmentName
                                                    : "N/A")

                                                <span class="mx-2">|</span>

                                                @(item.Branch != null
                                                    ? item.Branch.Name
                                                    : "N/A")

                                                <span class="mx-2">|</span>

                                                @item.RequestedDate.ToShortDateString()

                                            </div>

                                        </div>

                                    </button>

                                </h2>

                                <div id="@collapseId"
                                     class="accordion-collapse collapse"
                                     aria-labelledby="heading_@item.TicketId"
                                     data-bs-parent="#slaTicketAccordion">

                                    <div class="accordion-body">

                                        @Html.Partial("_Ticket", item)

                                    </div>

                                    <div class="card-footer">

                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <a href="@Html.EncodedActionLink("", "TicketInfo", "Ticket", "", new { id = item.TicketId }, null)"
                                               target="_blank"
                                               class="btn btn-sm btn-light">

                                                <i class="align-middle me-1" data-lucide="info"></i>
                                                More

                                            </a>

                                            <button type="button"
                                                    class="openTaskUpdate btn btn-sm btn-warning"
                                                    data-id="@item.TicketId"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateSla">

                                                <i class="align-middle me-1" data-lucide="pencil"></i>
                                                Update Reason

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    </div>
}


<div class="modal fade"
     id="modalUpdateSla"
     tabindex="-1"
     aria-labelledby="modalUpdateSlaLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalUpdateSlaLabel">

                    <i class="align-middle me-2" data-lucide="triangle-alert"></i>
                    Enter Reason for SLA Violation

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       name="clTaskId"
                       id="clTaskId" />

                <div class="mb-0">

                    <label for="textComment"
                           class="form-label">
                        Reason
                    </label>

                    <textarea rows="4"
                              id="textComment"
                              name="textComment"
                              class="form-control"
                              placeholder="Enter SLA violation reason"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-sm btn-light"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Close

                </button>

                <button type="button"
                        class="btn btn-sm btn-primary btnUpdateSla"
                        onclick="updateTask()">

                    <i class="align-middle me-1" data-lucide="save"></i>
                    Update

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            loadCategory();
            loadCompanies();
            loadStatus();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        $(document).on("click", ".openTaskUpdate", function () {

            var ticketId = $(this).data("id");

            $("#clTaskId").val(ticketId);

            $("#textComment").val("");

            $(".btnUpdateSla").prop("disabled", false);

        });


        function updateTask() {

            var ticketId =
                $("#clTaskId").val();

            var comment =
                $("#textComment").val().trim();

            var button =
                $(".btnUpdateSla");


            if (!comment) {

                Swal.fire(
                    "Error!",
                    "Please enter comment",
                    "error"
                );

                return;
            }


            button.prop("disabled", true);


            $.ajax({

                url: '@Url.Action("UpdateSLAReason", "Ticket")',

                type: "GET",

                dataType: "json",

                data: {
                    id: ticketId,
                    comment: comment
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Updated",
                            "Reason has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        button.prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    button.prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function loadCategory() {

            var dropDown =
                $("#CategoryId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- All --</option>"
            );


            $.getJSON(
                '@Url.Action("GetCategoryListJsonResult", "Category")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.CategoryId,
                                    text: item.CategoryName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.CategoryId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadCompanies() {

            var dropDown =
                $("#CompanyId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- All --</option>"
            );


            $.getJSON(
                '@Url.Action("GetCompanyListJsonResult", "Company")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.CompanyId,
                                    text: item.CompanyName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.CompanyId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadStatus() {

            var dropDown =
                $("#StatusId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- All --</option>"
            );


            $.getJSON(
                '@Url.Action("GetUpdateStatusJsonResult", "Ticket")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.StatusId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}