@model Web.Models.TicketCompleteVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="check-circle"></i>
                    Ticket Complete | Ticket # @Model.Ticket.Code
                </h5>

                <a href="@Url.Action("Pending", "Ticket")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("CompleteTicket", "Ticket", FormMethod.Post))
            {
                @Html.HiddenFor(model => model.TicketId)
                @Html.HiddenFor(model => model.IsSLAReasonRequired)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-lg-5">

                            @Html.Partial("_TicketMin", Model.Ticket)

                        </div>

                        <div class="col-lg-7">

                            <div class="card">

                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                                        Complete Ticket
                                    </h5>
                                </div>

                                <div class="card-body">

                                    <div hidden>

                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.RootCause,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.RootCause,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "2"
                                                }
                                            )

                                        </div>

                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.CorrectiveAction,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.CorrectiveAction,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "2"
                                                }
                                            )

                                        </div>

                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.PreventiveAction,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.PreventiveAction,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "2"
                                                }
                                            )

                                        </div>

                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.LessonsLearnt,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.LessonsLearnt,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "2"
                                                }
                                            )

                                        </div>

                                    </div>

                                    @if (Model.IsSLAReasonRequired)
                                    {
                                        <div id="vendor">

                                            <div class="alert alert-warning d-flex align-items-start gap-2">

                                                <i class="align-middle mt-1"
                                                   data-lucide="triangle-alert"></i>

                                                <div class="w-100">

                                                    <div class="fw-semibold mb-2">
                                                        SLA reason is required
                                                    </div>

                                                    @Html.LabelFor(
                                                        model => model.ReasonForSLA,
                                                        new { @class = "form-label" }
                                                    )

                                                    @Html.TextAreaFor(
                                                        model => model.ReasonForSLA,
                                                        new
                                                        {
                                                            @class = "form-control",
                                                            rows = "3"
                                                        }
                                                    )

                                                    @Html.ValidationMessageFor(
                                                        model => model.ReasonForSLA,
                                                        "",
                                                        new { @class = "text-danger" }
                                                    )

                                                </div>

                                            </div>
                                        </div>
                                    }

                                    <div class="mb-0">

                                        @Html.LabelFor(
                                            model => model.Comment,
                                            new { @class = "form-label" }
                                        )

                                        @Html.TextAreaFor(
                                            model => model.Comment,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "4"
                                            }
                                        )

                                        @Html.ValidationMessageFor(
                                            model => model.Comment,
                                            "",
                                            new { @class = "text-danger" }
                                        )

                                    </div>

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex justify-content-end">

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">

                                            <i class="align-middle me-1"
                                               data-lucide="save"></i>

                                            Update

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</div>