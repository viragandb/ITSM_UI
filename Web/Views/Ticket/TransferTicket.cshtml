@model Web.Models.TicketTransferVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="arrow-right-left"></i>
                    Transfer | Ticket # @Model.Ticket.Code
                </h5>

                <div class="d-flex gap-2">

                    <a href="@Html.EncodedActionLink("", "Info", "Ticket", "", new { id = Model.TicketId }, null)"
                       target="_blank"
                       class="btn btn-sm btn-light">

                        <i class="align-middle me-1" data-lucide="info"></i>
                        More

                    </a>

                    <a href="@Url.Action(ViewBag.BackAction, ViewBag.BackController)"
                       class="btn btn-sm btn-light">

                        <i class="align-middle me-1" data-lucide="arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

            @using (Html.BeginForm("TransferTicket", "Ticket", FormMethod.Post))
            {
                @Html.HiddenFor(model => model.TicketId)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-lg-5">

                            @Html.Partial("_TicketMin", Model.Ticket)

                        </div>

                        <div class="col-lg-7">

                            <div class="card">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="users"></i>
                                        Transfer Ticket
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="mb-3">

                                        @Html.LabelFor(
                                            model => model.PendingTeamId,
                                            new { @class = "form-label" }
                                        )

                                        @Html.DropDownListFor(
                                            model => model.PendingTeamId,
                                            new List<SelectListItem>(),
                                            new { @class = "form-select" }
                                        )

                                    </div>

                                    <div class="mb-0">

                                        @Html.LabelFor(
                                            model => model.Comment,
                                            new { @class = "form-label" }
                                        )

                                        @Html.TextAreaFor(
                                            model => model.Comment,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "4"
                                            }
                                        )

                                        @Html.ValidationMessageFor(
                                            model => model.Comment,
                                            "",
                                            new { @class = "text-danger" }
                                        )

                                    </div>

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex justify-content-end">

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">

                                            <i class="align-middle me-1" data-lucide="save"></i>
                                            Update

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            loadTeams();
        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadTeams() {

            var dropDown = $("#PendingTeamId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.PendingTeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}