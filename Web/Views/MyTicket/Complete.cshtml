@model ICollection<Domain.Ticket>
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="ticket"></i>
                    Tickets
                </h5>
            </div>

            <div class="card-body">

                <div class="accordion" id="ticketAccordion">

                    @foreach (var item in Model)
                    {
                        var collapseId = "ticket_" + item.TicketId;

                        <div class="accordion-item">

                            <h2 class="accordion-header"
                                id="heading_@item.TicketId">

                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">

                                    <div class="w-100 d-flex justify-content-between align-items-center me-3 flex-wrap gap-2">

                                        <div>

                                            <strong>
                                                @item.Code
                                            </strong>

                                            <span class="mx-2 text-muted">|</span>

                                            <span>
                                                @(item.RequestType != null && item.RequestType.Category != null
                                                    ? item.RequestType.Category.CategoryName
                                                    : "N/A")
                                            </span>

                                            <i class="align-middle mx-2"
                                               data-lucide="chevrons-right"></i>

                                            <span>
                                                @(item.RequestType != null && item.RequestType.AssetType != null
                                                    ? item.RequestType.AssetType.AssetTypeName
                                                    : "N/A")
                                            </span>

                                            <i class="align-middle mx-2"
                                               data-lucide="chevrons-right"></i>

                                            <strong>
                                                @(item.RequestType != null && item.RequestType.SubCategory != null
                                                    ? item.RequestType.SubCategory.SubCategoryName
                                                    : "N/A")
                                            </strong>

                                        </div>

                                        <span class="text-muted small">
                                            @item.RequestedDate.ToShortDateString()
                                        </span>

                                    </div>

                                </button>

                            </h2>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="heading_@item.TicketId"
                                 data-bs-parent="#ticketAccordion">

                                <div class="accordion-body">

                                    @Html.Partial("~/Views/Ticket/_Ticket.cshtml", item)

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a href="@Html.EncodedActionLink("", "Info", "Ticket", "", new { id = item.TicketId }, null)"
                                           target="_blank"
                                           class="btn btn-sm btn-light">

                                            <i class="align-middle me-1"
                                               data-lucide="info"></i>

                                            More

                                        </a>

                                        <a href="@Html.EncodedActionLink("", "Rate", "MyTicket", "", new { id = item.TicketId }, null)"
                                           class="btn btn-sm btn-warning">

                                            <i class="align-middle me-1"
                                               data-lucide="check-circle"></i>

                                            Close

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
</div>


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/Scripts/custom_functions.js"></script>

}