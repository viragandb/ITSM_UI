@model Domain.AR.AccessPrivilegeCategory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">

    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between">

                <h5 class="card-title mb-0">
                    Access Privilege Category
                </h5>

                <a href="@Url.Action("Index", "AccessPrivilegeCategory")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1"
                       data-lucide="arrow-left"></i>

                    Back

                </a>

            </div>

            @using (Html.BeginForm(
                "Edit",
                "AccessPrivilegeCategory",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "alert alert-danger" }
                )

                @Html.HiddenFor(model => model.AccessPrivilegeCategoryId)

                <div class="card-body">

                    <div class="row mb-3">

                        <div class="col-md-2">

                            @Html.LabelFor(
                                model => model.Name,
                                new { @class = "form-label" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.TextBoxFor(
                                model => model.Name,
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Name,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-danger">

                            <i class="align-middle me-1"
                               data-lucide="rotate-ccw"></i>

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary btnSubmitDisable">

                            <i class="align-middle me-1"
                               data-lucide="save"></i>

                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section scripts {
}
