@model Domain.TicketStatus

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var teamId = Convert.ToInt64(TempData["TeamId"]);
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="plus"></i>
                    Create New
                </h5>

                <a href="@Url.Action("Index", "TicketStatus")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Create", "TicketStatus", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.Status,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.Status,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Status,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.TeamId,
                                new { @class = "form-label" }
                            )

                            <select id="TeamId"
                                    name="TeamId"
                                    class="form-select">
                                <option value="0">-- Select --</option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TeamId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <div class="form-check">

                                @Html.CheckBoxFor(
                                    model => model.TimeCapture,
                                    new { @class = "form-check-input" }
                                )

                                @Html.LabelFor(
                                    model => model.TimeCapture,
                                    new { @class = "form-check-label" }
                                )

                            </div>

                            @Html.ValidationMessageFor(
                                model => model.TimeCapture,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            <div class="form-check">

                                @Html.CheckBoxFor(
                                    model => model.AllowUpdate,
                                    new { @class = "form-check-input" }
                                )

                                @Html.LabelFor(
                                    model => model.AllowUpdate,
                                    new { @class = "form-check-label" }
                                )

                            </div>

                            @Html.ValidationMessageFor(
                                model => model.AllowUpdate,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            loadTeams();
        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadTeams() {

            var dropDown = $("#TeamId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.TeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}