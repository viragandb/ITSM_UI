@model Domain.TicketStatus
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="info"></i>
                    Ticket Status Details
                </h5>

                <a href="@Url.Action("Index", "TicketStatus")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Edit", "TicketStatus", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.TicketStatusId)
                @Html.HiddenFor(model => model.Status)
                @Html.HiddenFor(model => model.TeamId)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.Status)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @Model.Status.EnumDisplayName()
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                @Html.DisplayNameFor(model => model.TeamId)
                            </label>

                            <div class="form-control bg-body-tertiary">
                                @(Model.Team != null
                                    ? Model.Team.TeamName
                                    : "N/A")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-check">

                                @Html.CheckBoxFor(
                                    model => model.TimeCapture,
                                    new { @class = "form-check-input" }
                                )

                                @Html.LabelFor(
                                    model => model.TimeCapture,
                                    new { @class = "form-check-label" }
                                )

                            </div>

                            @Html.ValidationMessageFor(
                                model => model.TimeCapture,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            <div class="form-check">

                                @Html.CheckBoxFor(
                                    model => model.AllowUpdate,
                                    new { @class = "form-check-input" }
                                )

                                @Html.LabelFor(
                                    model => model.AllowUpdate,
                                    new { @class = "form-check-label" }
                                )

                            </div>

                            @Html.ValidationMessageFor(
                                model => model.AllowUpdate,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>