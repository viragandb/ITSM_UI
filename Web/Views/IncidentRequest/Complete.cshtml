@model Web.Models.IncidentCompleteVM
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="clipboard-check"></i>
                    Incident | Request # @Model.IncidentRequestId
                </h5>

                <div class="d-flex gap-2">

                    <a href="@Html.EncodedActionLink("", "Info", "IncidentRequest", "", new { id = Model.IncidentRequestId }, null)"
                       target="_blank"
                       class="btn btn-sm btn-light">

                        <i class="align-middle me-1" data-lucide="info"></i>
                        More

                    </a>

                    <a href="@Url.Action("Pending", "IncidentRequest")"
                       class="btn btn-sm btn-light">

                        <i class="align-middle me-1" data-lucide="arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

            @using (Html.BeginForm("Complete", "IncidentRequest", FormMethod.Post))
            {
                @Html.HiddenFor(model => model.IncidentRequestId)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-12">

                            @Html.Partial("_RequestMin", Model.IncidentRequest)

                        </div>

                        <div class="col-12">

                            <div class="card">

                                <div class="card-body">

                                    <div @ViewBag.HideDiv>

                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.RootCause,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.RootCause,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "3"
                                                }
                                            )

                                            @Html.ValidationMessageFor(
                                                model => model.RootCause,
                                                "",
                                                new { @class = "text-danger" }
                                            )

                                        </div>


                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.CorrectiveAction,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.CorrectiveAction,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "3"
                                                }
                                            )

                                            @Html.ValidationMessageFor(
                                                model => model.CorrectiveAction,
                                                "",
                                                new { @class = "text-danger" }
                                            )

                                        </div>


                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.PreventiveAction,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.PreventiveAction,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "3"
                                                }
                                            )

                                            @Html.ValidationMessageFor(
                                                model => model.PreventiveAction,
                                                "",
                                                new { @class = "text-danger" }
                                            )

                                        </div>


                                        <div class="mb-3">

                                            @Html.LabelFor(
                                                model => model.LessonsLearnt,
                                                new { @class = "form-label" }
                                            )

                                            @Html.TextAreaFor(
                                                model => model.LessonsLearnt,
                                                new
                                                {
                                                    @class = "form-control",
                                                    rows = "3"
                                                }
                                            )

                                            @Html.ValidationMessageFor(
                                                model => model.LessonsLearnt,
                                                "",
                                                new { @class = "text-danger" }
                                            )

                                        </div>

                                    </div>


                                    <div class="mb-4">

                                        @Html.LabelFor(
                                            model => model.Comment,
                                            new { @class = "form-label" }
                                        )

                                        @Html.TextAreaFor(
                                            model => model.Comment,
                                            new
                                            {
                                                @class = "form-control",
                                                rows = "3"
                                            }
                                        )

                                        @Html.ValidationMessageFor(
                                            model => model.Comment,
                                            "",
                                            new { @class = "text-danger" }
                                        )

                                    </div>


                                    <div class="card mb-0">

                                        <div class="card-header">

                                            <h5 class="card-title mb-0">
                                                <i class="align-middle me-2" data-lucide="boxes"></i>
                                                Assign Assets
                                            </h5>

                                        </div>

                                        <div class="card-body">

                                            <div class="row g-3 align-items-end">

                                                <div class="col-md-3">

                                                    <label for="AssetCategoryId"
                                                           class="form-label">
                                                        Asset Category
                                                    </label>

                                                    <select id="AssetCategoryId"
                                                            name="AssetCategoryId"
                                                            class="form-select">
                                                    </select>

                                                </div>


                                                <div class="col-md-3">

                                                    <label for="AssetTypeId"
                                                           class="form-label">
                                                        Asset Type
                                                    </label>

                                                    <select id="AssetTypeId"
                                                            name="AssetTypeId"
                                                            class="form-select">
                                                    </select>

                                                </div>


                                                <div class="col-md-4">

                                                    <label for="AssetItemId"
                                                           class="form-label">
                                                        Asset
                                                    </label>

                                                    <select id="AssetItemId"
                                                            name="AssetItemId"
                                                            class="form-select select2">
                                                    </select>

                                                </div>


                                                <div class="col-md-2">

                                                    <button type="button"
                                                            class="btn btn-sm btn-info w-100"
                                                            onclick="addAsset()">

                                                        <i class="align-middle me-1"
                                                           data-lucide="plus">
                                                        </i>

                                                        Add

                                                    </button>

                                                </div>

                                            </div>


                                            <div class="table-responsive mt-3">

                                                <table id="assetTable"
                                                       class="table table-striped table-hover align-middle mb-0">

                                                    <thead>
                                                        <tr>
                                                            <th>Asset</th>
                                                            <th class="text-end">Action</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody id="assetdata">

                                                        @if (Model.Assets != null)
                                                        {
                                                            for (var i = 0; i < Model.Assets.Count; i++)
                                                            {
                                                                <tr id="@i">

                                                                    <td>

                                                                        @Html.HiddenFor(
                                                                            m => Model.Assets[i].AssetId,
                                                                            new { @class = "iHidden" }
                                                                        )

                                                                        @Html.HiddenFor(
                                                                            m => Model.Assets[i].AssetName
                                                                        )

                                                                        @Model.Assets[i].AssetName

                                                                    </td>

                                                                    <td class="text-end">

                                                                        <button type="button"
                                                                                id="btnRemove@i"
                                                                                name="btnRemove@i"
                                                                                onclick="deleteRow(@i)"
                                                                                class="btn btn-sm btn-danger"
                                                                                title="Remove">

                                                                            <i class="align-middle"
                                                                               data-lucide="trash-2">
                                                                            </i>

                                                                        </button>

                                                                    </td>

                                                                </tr>
                                                            }
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex justify-content-end">

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">

                                            <i class="align-middle me-1" data-lucide="save"></i>
                                            Update

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#AssetItemId").select2({
                width: "100%"
            });

            loadAssetCategory();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return $("<div/>").text(value).html();

        }


        $("#AssetCategoryId").on("change", function () {

            loadAssetType();

        });


        $("#AssetTypeId").on("change", function () {

            loadAssets();

        });


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown = $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );


                    loadAssetType();

                }
            );

        }


        function loadAssetType() {

            var categoryId = $("#AssetCategoryId").val();

            var dropDown = $("#AssetTypeId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            $("#AssetItemId")
                .empty()
                .append("<option value='0'>-- Select --</option>")
                .trigger("change.select2");


            $.getJSON(
                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',
                {
                    assetCategory: categoryId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );


                    var selectedTypeId =
                        '@ViewBag.AssetTypeId';

                    if (selectedTypeId && selectedTypeId != "0") {

                        dropDown.val(selectedTypeId);

                    }


                    loadAssets();

                }
            );

        }


        function loadAssets() {

            var categoryId =
                $("#AssetCategoryId").val();

            var typeId =
                $("#AssetTypeId").val();

            var selectedTypeId =
                '@ViewBag.AssetTypeId';


            if (selectedTypeId && selectedTypeId != "0") {
                typeId = selectedTypeId;
            }


            var dropDown =
                $("#AssetItemId");


            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            if (!categoryId || categoryId == "0" || !typeId || typeId == "0") {

                dropDown.trigger("change.select2");

                return;
            }


            $.getJSON(
                '@Url.Action("GetAssetListAvbJsonResult", "Asset")',
                {
                    branchId: 0,
                    deptId: 0,
                    assetCatId: categoryId,
                    assetTypeId: typeId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetId,
                                    text: item.AssetNo + " - " + item.Barcode
                                })
                            );

                        }
                    );


                    dropDown.trigger("change.select2");

                }
            );

        }


        function addAsset() {

            var assetId =
                $("#AssetItemId").val();

            var assetName =
                $("#AssetItemId option:selected").text();


            if (!assetId || assetId == "0") {
                return;
            }


            var exists = false;


            $("#assetdata input[name$='.AssetId']").each(function () {

                if ($(this).val() == assetId) {
                    exists = true;
                    return false;
                }

            });


            if (exists) {

                Swal.fire(
                    "Asset already added",
                    "The selected asset is already in the list.",
                    "warning"
                );

                return;
            }


            var itemIndex =
                $("#assetdata tr").length;


            var newItem =
                "<tr id='" + itemIndex + "'>" +

                    "<td>" +

                        "<input id='Assets_" + itemIndex + "__AssetId'" +
                        " class='iHidden'" +
                        " name='Assets[" + itemIndex + "].AssetId'" +
                        " type='hidden'" +
                        " value='" + escapeHtml(assetId) + "' />" +

                        "<input id='Assets_" + itemIndex + "__AssetName'" +
                        " name='Assets[" + itemIndex + "].AssetName'" +
                        " type='hidden'" +
                        " value='" + escapeHtml(assetName) + "' />" +

                        escapeHtml(assetName) +

                    "</td>" +

                    "<td class='text-end'>" +

                        "<button type='button'" +
                        " id='btnRemove" + itemIndex + "'" +
                        " name='btnRemove" + itemIndex + "'" +
                        " onclick='deleteRow(" + itemIndex + ")'" +
                        " class='btn btn-sm btn-danger'" +
                        " title='Remove'>" +

                            "<i data-lucide='trash-2'></i>" +

                        "</button>" +

                    "</td>" +

                "</tr>";


            $("#assetdata").append(newItem);


            if (window.lucide) {
                lucide.createIcons();
            }

        }


        function deleteRow(index) {

            $("#assetdata #" + index).remove();

            UpdateIndexes(index);

        }


        function UpdateIndexes() {

            $("#assetdata tr").each(function (index) {

                var row =
                    $(this);

                row.attr("id", index);


                var assetIdInput =
                    row.find("input[name$='.AssetId']");

                var assetNameInput =
                    row.find("input[name$='.AssetName']");


                assetIdInput.attr({
                    id: "Assets_" + index + "__AssetId",
                    name: "Assets[" + index + "].AssetId"
                });


                assetNameInput.attr({
                    id: "Assets_" + index + "__AssetName",
                    name: "Assets[" + index + "].AssetName"
                });


                var removeButton =
                    row.find("button");


                removeButton.attr({
                    id: "btnRemove" + index,
                    name: "btnRemove" + index,
                    onclick: "deleteRow(" + index + ")"
                });

            });

        }


        function removeItems() {

            $("#assetdata").empty();

        }

    </script>
}