@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($('#dataTable').length) {

                $('#dataTable').DataTable({
                    paging: true,
                    responsive: true,
                    autoWidth: false,
                    searching: true
                });

            }


            $('.dataTableModel').each(function () {

                $(this).DataTable({
                    paging: false,
                    responsive: false,
                    autoWidth: false,
                    searching: false,
                    info: false
                });

            });


            $('.dataTableModel2').each(function () {

                $(this).DataTable({
                    paging: false,
                    responsive: false,
                    autoWidth: false,
                    searching: false,
                    info: false
                });

            });

        });

    </script>

