
@model Domain.Holiday

@{
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <!-- Horizontal Form -->
        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title">Holiday Details</h3>
                <div class="box-tools pull-right">
                    <a href="@Url.Action("Index", "Holiday")" class="btn btn-social btn-cancel">
                        <i class="fa fa-arrow-left"></i>Back
                    </a>
                </div>
            </div>
            <!-- /.box-header -->
            <!-- form start -->

            @using (Html.BeginForm("Edit", "Holiday", FormMethod.Post, new { @class = "form-horizontal" }))
            {

                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.HolidayId)


                <div class="box-body">

                    <div class="form-group">
                        @Html.LabelFor(model => model.HolidayName, new { @class = "col-md-2 control-label" })
                        <div class="col-md-6">
                            @Html.TextBoxFor(model => model.HolidayName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.HolidayName, null, new { @class = "help-block" })
                        </div>
                    </div>
                    <div class="form-group ">

                        <label class="control-label col-md-2">
                            Date :
                        </label>
                        <div class="col-md-2">
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" name="Date" id="Date" value="@ViewBag.Date" class="form-control datepicker" />
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.box-body -->
                <div class="box-footer">
                    <div class="text-right">
                        <button type="reset" class="btn btn-social btn-danger"><i class="fa fa-undo"></i>Cancel</button>
                        <button type="submit" class="btn btn-social btn-default"><i class="fa fa-floppy-o"></i>Save</button>

                    </div>
                </div>
                <!-- /.box-footer -->
            }
        </div>
        <!-- /.box -->
    </div>
</div>


