@model Web.Models.SystemEnvironmentVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="plus"></i>
                    Create New
                </h5>

                <a href="@Url.Action("Index", "SystemEnvironment")"
                   class="btn btn-sm btn-light">

                    <i class="align-middle me-1" data-lucide="arrow-left"></i>
                    Back

                </a>

            </div>

            @using (Html.BeginForm("Create", "SystemEnvironment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.EnvironmentType,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.EnvironmentType,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.EnvironmentType,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.AssetCategory,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.AssetCategory,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                            @Html.ValidationMessageFor(
                                model => model.AssetCategory,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="col-md-6">

                            @Html.LabelFor(
                                model => model.AssetTypeId,
                                new { @class = "form-label" }
                            )

                            <select id="AssetTypeId"
                                    name="AssetTypeId"
                                    class="form-select">

                                <option value="0">-- Select --</option>

                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="AssetTypeId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-sm btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>
</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            loadAssetType();

            $("#AssetCategory").on("change", function () {
                loadAssetType();
            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadAssetType() {

            var categoryId = $("#AssetCategory").val();

            var dropDown = $("#AssetTypeId");

            dropDown.empty();

            dropDown.append(
                "<option value='0'>-- Select --</option>"
            );


            if (!categoryId) {
                return;
            }


            $.getJSON(
                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',
                {
                    assetCategory: categoryId
                },
                function (data) {

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );


                    var selectedId = '@ViewBag.AssetTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}