@model Web.Models.ItemVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "AssetTransfer", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="col-lg-8">

            <div class="card">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="arrow-right-left"></i>
                        Asset Transfer
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label for="ItemBarCode" class="form-label">
                            Bar Code
                        </label>

                        <div class="input-group">

                            @Html.TextBox(
                                "ItemBarCode",
                                "",
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Bar Code"
                                }
                            )

                            @Html.HiddenFor(model => model.ItemId)

                            <button type="button"
                                    class="btn btn-primary"
                                    onclick="loadItems()">

                                <i class="align-middle me-1" data-lucide="search"></i>
                                Search

                            </button>

                        </div>

                    </div>


                    <div class="card bg-body-tertiary mb-4">

                        <div class="card-header">

                            <h6 class="card-title mb-0">
                                <i class="align-middle me-2" data-lucide="box"></i>
                                Asset Information
                            </h6>

                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemName)
                                    </div>

                                    <div id="ItemName" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemSerialNo)
                                    </div>

                                    <div id="ItemSerialNo" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemFixedAssetNo)
                                    </div>

                                    <div id="ItemFixedAssetNo" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.LocationName)
                                    </div>

                                    <div id="LocationName" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.DepartmentName)
                                    </div>

                                    <div id="DepartmentName" class="text-muted">
                                        -
                                    </div>

                                </div>

                            </div>

                            <hr />

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemCost)
                                    </div>

                                    <div id="ItemCost" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemPurchaseDate)
                                    </div>

                                    <div id="ItemPurchaseDate" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemExpiryDate)
                                    </div>

                                    <div id="ItemExpiryDate" class="text-muted">
                                        -
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="fw-semibold mb-1">
                                        @Html.DisplayNameFor(model => model.ItemInputDate)
                                    </div>

                                    <div id="ItemInputDate" class="text-muted">
                                        -
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        <h5 class="mb-3">
                            <i class="align-middle me-2" data-lucide="map-pin"></i>
                            Asset Transfer To
                        </h5>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label for="TransferLocationId" class="form-label">
                                    @Html.DisplayNameFor(model => model.LocationName)
                                </label>

                                <select id="TransferLocationId"
                                        name="TransferLocationId"
                                        class="form-select select2">

                                    <option value=""></option>

                                </select>

                                <span class="text-danger"
                                      data-valmsg-for="TransferLocationId"
                                      data-valmsg-replace="true">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label for="TransferDepartmentId" class="form-label">
                                    @Html.DisplayNameFor(model => model.DepartmentName)
                                </label>

                                <select id="TransferDepartmentId"
                                        name="TransferDepartmentId"
                                        class="form-select select2">

                                    <option value=""></option>

                                </select>

                                <span class="text-danger"
                                      data-valmsg-for="TransferDepartmentId"
                                      data-valmsg-replace="true">
                                </span>

                            </div>

                            <div class="col-12">

                                @Html.LabelFor(
                                    model => model.Remark,
                                    new { @class = "form-label" }
                                )

                                @Html.TextAreaFor(
                                    model => model.Remark,
                                    new
                                    {
                                        @class = "form-control",
                                        rows = "3"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    model => model.Remark,
                                    "",
                                    new { @class = "text-danger" }
                                )

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                id="btnSave"
                                class="btn btn-primary btnSubmitDisable">

                            <i class="align-middle me-1" data-lucide="arrow-right-left"></i>
                            Transfer

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }

            loadLocation();
            loadDepartment();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadItems() {

            var itemBarCode =
                $("#ItemBarCode").val();


            if (!itemBarCode || itemBarCode.trim() === "") {

                Swal.fire(
                    "Error!",
                    "Please enter the bar code",
                    "error"
                );

                return;

            }


            $.getJSON(
                '@Url.Action("GetItemJsonResult", "Item")',
                {
                    BarCode: itemBarCode.trim()
                },
                function (data) {

                    var item =
                        parseJsonResult(data);


                    if (!item) {

                        Swal.fire(
                            "Error!",
                            "Asset not found",
                            "error"
                        );

                        return;

                    }


                    $.each(item, function (index, value) {

                        if (index === "ItemId") {
                            $("#ItemId").val(value);
                        }

                        if (index === "ItemName") {
                            $("#ItemName").text(value || "-");
                        }

                        if (index === "ItemSerialNo") {
                            $("#ItemSerialNo").text(value || "-");
                        }

                        if (index === "ItemFixedAssetNo") {
                            $("#ItemFixedAssetNo").text(value || "-");
                        }

                        if (index === "LocationName") {
                            $("#LocationName").text(value || "-");
                        }

                        if (index === "DepartmentName") {
                            $("#DepartmentName").text(value || "-");
                        }

                        if (index === "ItemCost") {
                            $("#ItemCost").text(value || "-");
                        }

                        if (index === "ItemPurchaseDate") {
                            $("#ItemPurchaseDate").text(value || "-");
                        }

                        if (index === "ItemExpiryDate") {
                            $("#ItemExpiryDate").text(value || "-");
                        }

                        if (index === "ItemInputDate") {
                            $("#ItemInputDate").text(value || "-");
                        }

                    });

                }
            )
            .fail(function () {

                Swal.fire(
                    "Error!",
                    "Unable to load asset information",
                    "error"
                );

            });

        }


        function loadLocation() {

            var companyId =
                0;


            if (companyId === "") {
                companyId = 1;
            }


            if ('@ViewBag.CompanyId' &&
                '@ViewBag.CompanyId' != '0') {

                companyId =
                    '@ViewBag.CompanyId';

            }


            $.getJSON(
                '@Url.Action("GetLocationListJsonResult", "Location")',
                {
                    CompanyId: companyId
                },
                function (data) {

                    var dropDown =
                        $("#TransferLocationId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.LocationId,
                                    text: item.LocationName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.TransferLocationId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function loadDepartment() {

            $.getJSON(
                '@Url.Action("GetDepartmentListJsonResult", "Department")',
                function (data) {

                    var dropDown =
                        $("#TransferDepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );


                    var selectedId =
                        '@ViewBag.TransferDepartmentId';


                    if (selectedId) {
                        dropDown.val(selectedId);
                    }


                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }

    </script>
}