@model ICollection<Domain.DR.DisposalRequest>
@using Service.AR
@using Service
@using Domain.AR

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="clock"></i>
                    Pending Disposal Approval
                </h5>

            </div>

            <div class="card-body">

                <div id="accordion">

                    @foreach (var item in Model.Where(e =>
                        e.Status == Domain.DR.DisposalStatusEnum.PendingApproval))
                    {
                        var collapseId = "G_" + item.DisposalRequestId;

                        <div class="card mb-3">

                            <div class="card-header">

                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">

                                    <a href="#@collapseId"
                                       class="text-body text-decoration-none fw-semibold collapsed"
                                       data-bs-toggle="collapse"
                                       aria-expanded="false"
                                       aria-controls="@collapseId">

                                        <i class="align-middle me-1" data-lucide="file-text"></i>
                                        Request #@item.DisposalRequestId

                                    </a>

                                    <span class="badge bg-primary">
                                        Pending Approval
                                    </span>

                                </div>

                            </div>

                            <div id="@collapseId"
                                 class="collapse"
                                 data-bs-parent="#accordion">

                                <div class="card-body">

                                    <div class="mb-3">

                                        <div class="fw-semibold mb-1">
                                            Title
                                        </div>

                                        <div class="text-muted">
                                            @item.Title
                                        </div>

                                    </div>

                                    <hr />

                                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">

                                        <div class="fw-semibold">
                                            Asset Summary
                                        </div>

                                        <span class="badge bg-secondary">
                                            Total:
                                            @item.DisposalItems.Count(e => !e.IsDeleted)
                                        </span>

                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mb-3">

                                        @{
                                            var summary = item.DisposalItems
                                                .Where(e => !e.IsDeleted)
                                                .GroupBy(di => di.Asset.AssetType.AssetTypeName)
                                                .Select(g => new
                                                {
                                                    Type = g.Key,
                                                    Count = g.Count()
                                                });
                                        }

                                        @foreach (var group in summary)
                                        {
                                            <span class="badge bg-info text-dark p-2">
                                                @group.Type
                                                <span class="ms-1">
                                                    (@group.Count)
                                                </span>
                                            </span>
                                        }

                                    </div>

                                    <hr />

                                    <div class="table-responsive"
                                         style="max-height:300px; overflow-y:auto;">

                                        <table class="table table-sm table-striped table-hover align-middle disposalAssetTable mb-0">

                                            <thead>

                                                <tr>
                                                    <th>Asset No</th>
                                                    <th>Asset Name</th>
                                                    <th>Model</th>
                                                </tr>

                                            </thead>

                                            <tbody>

                                                @foreach (var disposedItem in item.DisposalItems.Where(e => !e.IsDeleted))
                                                {
                                                    <tr>

                                                        <td>
                                                            @disposedItem.Asset.AssetNo
                                                        </td>

                                                        <td>
                                                            @disposedItem.Asset.AssetName
                                                        </td>

                                                        <td>
                                                            @disposedItem.Asset.ModelName
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                    <hr />

                                    <div>

                                        <div class="fw-semibold mb-1">
                                            <i class="align-middle me-1" data-lucide="calendar"></i>
                                            Request Created Date
                                        </div>

                                        <div class="text-muted">
                                            @item.RequestCreatedDate.ToShortDateString()
                                        </div>

                                    </div>

                                </div>

                                <div class="card-footer">

                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                           target="_blank"
                                           class="btn btn-light btn-sm">

                                            <i class="align-middle me-1" data-lucide="info"></i>
                                            More

                                        </a>

                                        <button type="button"
                                                class="btn btn-danger btn-sm openModalUpdateReject"
                                                data-id="@item.DisposalRequestId"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalUpdateReject">

                                            <i class="align-middle me-1" data-lucide="thumbs-down"></i>
                                            Reject

                                        </button>

                                        <button type="button"
                                                class="btn btn-warning btn-sm openModalUpdateReturn"
                                                data-id="@item.DisposalRequestId"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalUpdateReturn">

                                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                                            Return

                                        </button>

                                        <button type="button"
                                                class="btn btn-success btn-sm openModalUpdateApprove"
                                                data-id="@item.DisposalRequestId"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalUpdateApprove">

                                            <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                                            Approve

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
</div>


<div class="modal fade"
     id="modalUpdateApprove"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="approveRequestLabel"></span> Approve
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalTicketIdApproval" />

                <div class="mb-3">

                    <label for="textCommentApproval"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="textCommentApproval"
                           class="form-control"
                           placeholder="Enter comment" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="generalCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-success btn-sm btnClickDisable"
                        onclick="approve()">

                    <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                    Approve

                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalUpdateReject"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="rejectRequestLabel"></span> Reject
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalTicketIdReject" />

                <div class="mb-3">

                    <label for="textCommentReject"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="textCommentReject"
                           name="textCommentReject"
                           class="form-control"
                           placeholder="Enter Comment" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="generalRejectCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-danger btn-sm btnClickDisable"
                        onclick="reject()">

                    <i class="align-middle me-1" data-lucide="thumbs-down"></i>
                    Reject

                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalUpdateReturn"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="returnRequestLabel"></span> Return
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalTicketIdReturn" />

                <div class="mb-3">

                    <label for="textCommentReturn"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="textCommentReturn"
                           name="textCommentReturn"
                           class="form-control"
                           placeholder="Enter Comment" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="generalReturnCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-warning btn-sm btnClickDisable"
                        onclick="returnRequest()">

                    <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                    Return

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $(".dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true
            });

        });


        $(document).on("click", ".openModalUpdateReject", function () {

            var id = $(this).data("id");

            $("#modalTicketIdReject")
                .val(id);

            $("#rejectRequestLabel")
                .text(id);

            $("#textCommentReject")
                .val("");

            $("#modalUpdateReject .btnClickDisable")
                .prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateApprove", function () {

            var id = $(this).data("id");

            $("#modalTicketIdApproval")
                .val(id);

            $("#approveRequestLabel")
                .text(id);

            $("#textCommentApproval")
                .val("");

            $("#modalUpdateApprove .btnClickDisable")
                .prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateReturn", function () {

            var id = $(this).data("id");

            $("#modalTicketIdReturn")
                .val(id);

            $("#returnRequestLabel")
                .text(id);

            $("#textCommentReturn")
                .val("");

            $("#modalUpdateReturn .btnClickDisable")
                .prop("disabled", false);

        });


        $("#generalCancelBtn").on("click", function () {

            $("#textCommentApproval").val("");

        });


        $("#generalRejectCancelBtn").on("click", function () {

            $("#textCommentReject").val("");

        });


        $("#generalReturnCancelBtn").on("click", function () {

            $("#textCommentReturn").val("");

        });


        function reject() {

            var requestId =
                $("#modalTicketIdReject").val();

            var comment =
                $("#textCommentReject").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error",
                    "Please provide comment",
                    "error"
                );

                return;

            }


            $("#modalUpdateReject .btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "Comment",
                comment.trim()
            );


            fetch(
                '@Url.Action("DisposalReject", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been rejected",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else if (data === 3) {

                    $("#modalUpdateReject .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Please provide comment",
                        "error"
                    );

                }
                else {

                    $("#modalUpdateReject .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $("#modalUpdateReject .btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }


        function approve() {

            var requestId =
                $("#modalTicketIdApproval").val();

            var comment =
                $("#textCommentApproval").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error",
                    "Please provide comment",
                    "error"
                );

                return;

            }


            $("#modalUpdateApprove .btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "Comment",
                comment.trim()
            );


            fetch(
                '@Url.Action("DisposalApprove", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been approved",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else if (data === 3) {

                    $("#modalUpdateApprove .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Please provide comment",
                        "error"
                    );

                }
                else {

                    $("#modalUpdateApprove .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $("#modalUpdateApprove .btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }


        function returnRequest() {

            var requestId =
                $("#modalTicketIdReturn").val();

            var comment =
                $("#textCommentReturn").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error",
                    "Please provide comment",
                    "error"
                );

                return;

            }


            $("#modalUpdateReturn .btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "Comment",
                comment.trim()
            );


            fetch(
                '@Url.Action("DisposalReturn", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been returned",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else if (data === 3) {

                    $("#modalUpdateReturn .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Please provide comment",
                        "error"
                    );

                }
                else {

                    $("#modalUpdateReturn .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $("#modalUpdateReturn .btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }

    </script>
}

<style>

    .disposalAssetTable thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bs-body-bg);
        box-shadow: inset 0 -1px 0 var(--bs-border-color);
    }

    .disposalAssetTable {
        border-collapse: separate;
        border-spacing: 0;
    }
</style>