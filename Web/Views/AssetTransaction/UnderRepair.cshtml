@model ICollection<Domain.AssetTransferRequest>
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("UnderRepair", "AssetTransaction", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="search"></i>
                        Search
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="VendorId" class="form-label">
                                Vendor
                            </label>

                            <select id="VendorId"
                                    name="VendorId"
                                    class="form-select select2">
                            </select>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="wrench"></i>
                        Under Repair
                    </h5>

                </div>

                <div class="card-body">

                    <div id="repairAccordion">

                        @foreach (var item in Model)
                        {
                            var collapseId = "repair_" + item.AssetTransferRequestId;

                            <div class="card mb-3">

                                <div class="card-header">

                                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">

                                        <div>

                                            <a href="#@collapseId"
                                               class="text-body text-decoration-none fw-semibold collapsed"
                                               data-bs-toggle="collapse"
                                               aria-expanded="false"
                                               aria-controls="@collapseId">

                                                <i class="align-middle me-1" data-lucide="file-text"></i>
                                                #@item.AssetTransferRequestId

                                            </a>

                                            <span class="ms-2 text-muted">

                                                <i class="align-middle me-1" data-lucide="building-2"></i>
                                                @item.Vendor.VendorName

                                            </span>

                                        </div>

                                        <div class="d-flex align-items-center gap-2">

                                            <span class="badge bg-@AssetTransferRequestService.GetTransTypeColor(item.TransactionType)">
                                                @item.TransactionType.EnumDisplayName()
                                            </span>

                                            <span class="text-muted small">

                                                <i class="align-middle me-1" data-lucide="calendar"></i>
                                                @item.UpdatedDate.ToShortDateString()

                                            </span>

                                        </div>

                                    </div>

                                </div>

                                <div id="@collapseId"
                                     class="collapse"
                                     data-bs-parent="#repairAccordion">

                                    <div class="card-body">

                                        @Html.Partial(
                                            "~/Views/AssetTransaction/_Min.cshtml",
                                            item
                                        )

                                    </div>

                                    <div class="card-footer">

                                        <div class="d-flex flex-wrap justify-content-end gap-2">

                                            <button type="button"
                                                    data-id="@item.AssetTransferRequestId"
                                                    data-code="@item.AssetTransferRequestId"
                                                    class="openModalUpdateOOS btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateOOS">

                                                <i class="align-middle me-1" data-lucide="x-circle"></i>
                                                Out Of Service

                                            </button>

                                            <button type="button"
                                                    data-id="@item.AssetTransferRequestId"
                                                    data-code="@item.AssetTransferRequestId"
                                                    class="openModalUpdate btn btn-success btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdate">

                                                <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                                                Back To Operation

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    </div>
}


<div class="modal fade"
     id="modalUpdate"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    #<span id="backToOperationRequestLabel"></span> Back To Operation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="backToOperationRequestId"
                       value="" />

                <div class="mb-3">

                    <label for="backToOperationComment"
                           class="form-label">
                        Comment
                    </label>

                    <textarea id="backToOperationComment"
                              class="form-control"
                              rows="3"
                              placeholder="Enter comment"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-success btn-sm btnClickDisable"
                        onclick="update()">

                    <i class="align-middle me-1" data-lucide="save"></i>
                    Update

                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalUpdateOOS"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    #<span id="outOfServiceRequestLabel"></span> Out Of Service
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="outOfServiceRequestId"
                       value="" />

                <div class="mb-3">

                    <label for="outOfServiceComment"
                           class="form-label">
                        Comment
                    </label>

                    <textarea id="outOfServiceComment"
                              class="form-control"
                              rows="3"
                              placeholder="Enter comment"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-danger btn-sm btnClickDisable"
                        onclick="updateOOS()">

                    <i class="align-middle me-1" data-lucide="save"></i>
                    Update

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }

            loadVendor();


            $(document).on("click", ".openModalUpdate", function () {

                var requestId =
                    $(this).data("id");

                var code =
                    $(this).data("code");

                $("#backToOperationRequestId")
                    .val(requestId);

                $("#backToOperationRequestLabel")
                    .text(code);

                $("#backToOperationComment")
                    .val("");

                $("#modalUpdate .btnClickDisable")
                    .prop("disabled", false);

            });


            $(document).on("click", ".openModalUpdateOOS", function () {

                var requestId =
                    $(this).data("id");

                var code =
                    $(this).data("code");

                $("#outOfServiceRequestId")
                    .val(requestId);

                $("#outOfServiceRequestLabel")
                    .text(code);

                $("#outOfServiceComment")
                    .val("");

                $("#modalUpdateOOS .btnClickDisable")
                    .prop("disabled", false);

            });

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function loadVendor() {

            $.getJSON(
                '@Url.Action("GetVendorListJsonResult", "Vendor")',
                function (data) {

                    var dropDown =
                        $("#VendorId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.VendorId,
                                    text: item.VendorName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.VendorId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function update() {

            var requestId =
                $("#backToOperationRequestId").val();

            var comment =
                $("#backToOperationComment").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error!",
                    "Please enter the comment",
                    "error"
                );

                return;

            }


            $("#modalUpdate .btnClickDisable")
                .prop("disabled", true);


            $.ajax({

                url: '@Url.Action("BackToOperation", "AssetTransaction")',

                type: "GET",

                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment.trim()
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        $("#modalUpdate .btnClickDisable")
                            .prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#modalUpdate .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }


        function updateOOS() {

            var requestId =
                $("#outOfServiceRequestId").val();

            var comment =
                $("#outOfServiceComment").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error!",
                    "Please enter the comment",
                    "error"
                );

                return;

            }


            $("#modalUpdateOOS .btnClickDisable")
                .prop("disabled", true);


            $.ajax({

                url: '@Url.Action("OutOfService", "AssetTransaction")',

                type: "GET",

                dataType: "json",

                data: {
                    requestId: requestId,
                    comment: comment.trim()
                },

                success: function (data) {

                    if (data == "1" || data == 1) {

                        Swal.fire(
                            "Completed",
                            "Request has been updated",
                            "success"
                        );

                        setTimeout(function () {
                            window.location.reload();
                        }, 500);

                    }
                    else {

                        $("#modalUpdateOOS .btnClickDisable")
                            .prop("disabled", false);

                        Swal.fire(
                            "Something went wrong!",
                            "Please try again",
                            "error"
                        );

                    }

                },

                error: function () {

                    $("#modalUpdateOOS .btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                }

            });

        }

    </script>
}