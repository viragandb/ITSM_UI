@model Web.Models.DisposalVM
@using Service
@using Domain.DR

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <ul class="nav nav-pills card-header-pills" role="tablist">

                    <li class="nav-item" role="presentation">
                        <a class="nav-link active"
                           href="#tab_ManageItems"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="boxes"></i>
                            Manage Items
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_OnGoing"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="clock"></i>
                            On Going
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_Approved"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                            Approved
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_InTransit"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="truck"></i>
                            In Transit
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_Returned"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Returned
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_Rejected"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="thumbs-down"></i>
                            Rejected
                        </a>
                    </li>

                    <li class="nav-item" role="presentation">
                        <a class="nav-link"
                           href="#tab_Completed"
                           data-bs-toggle="tab"
                           role="tab">
                            <i class="align-middle me-1" data-lucide="check-circle"></i>
                            Completed
                        </a>
                    </li>

                </ul>

            </div>

            <div class="tab-content">

                <div class="tab-pane fade show active"
                     id="tab_ManageItems"
                     role="tabpanel">

                    <div class="card-header">

                        <h5 class="card-title mb-0">
                            <i class="align-middle me-2" data-lucide="trash-2"></i>
                            Disposal Items
                        </h5>

                    </div>

                    @using (Html.BeginForm("Disposed", "AssetTransaction", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)

                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-12">

                                    <label for="drpRequest" class="form-label">
                                        Disposal Request
                                    </label>

                                    <select id="drpRequest"
                                            name="DisposalRequestId"
                                            class="form-select">
                                        <option value="0">-- Select --</option>
                                    </select>

                                </div>

                                <div class="col-md-4">

                                    @Html.LabelFor(
                                        model => model.BranchIdFrom,
                                        new { @class = "form-label" }
                                    )

                                    @Html.DropDownListFor(
                                        model => model.BranchIdFrom,
                                        new List<SelectListItem>(),
                                        new { @class = "form-select select2" }
                                    )

                                </div>

                                <div class="col-md-4">

                                    @Html.LabelFor(
                                        model => model.DepartmentIdFrom,
                                        new { @class = "form-label" }
                                    )

                                    @Html.DropDownListFor(
                                        model => model.DepartmentIdFrom,
                                        new List<SelectListItem>(),
                                        new { @class = "form-select select2" }
                                    )

                                </div>

                            </div>


                            <div class="card mt-4">

                                <div class="card-header">

                                    <h5 class="card-title mb-0">
                                        <i class="align-middle me-2" data-lucide="boxes"></i>
                                        Assets
                                    </h5>

                                </div>

                                <div class="card-body">

                                    <div class="row g-3">

                                        <div class="col-md-3">

                                            <label for="AssetCategoryId"
                                                   class="form-label">
                                                Asset Category
                                            </label>

                                            <select id="AssetCategoryId"
                                                    name="AssetCategoryId"
                                                    class="form-select">
                                            </select>

                                        </div>

                                        <div class="col-md-3">

                                            <label for="AssetTypeId"
                                                   class="form-label">
                                                Asset Type
                                            </label>

                                            <select id="AssetTypeId"
                                                    name="AssetTypeId"
                                                    class="form-select">
                                            </select>

                                        </div>

                                        <div class="col-md-6 d-flex align-items-end">

                                            <div class="form-check mb-2">

                                                <input type="checkbox"
                                                       id="selectAllAssets"
                                                       class="form-check-input" />

                                                <label for="selectAllAssets"
                                                       class="form-check-label">
                                                    Select All
                                                </label>

                                            </div>

                                        </div>

                                    </div>

                                    <div id="loadingSpinner"
                                         class="text-center my-3"
                                         style="display:none;">

                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        Updating Selection...

                                    </div>

                                    <div class="table-responsive mt-3"
                                         style="max-height:300px; overflow-y:auto;">

                                        <table id="assetTable"
                                               class="table table-sm table-striped table-hover align-middle mb-0">

                                            <thead>
                                                <tr>
                                                    <th style="width:70px;">Select</th>
                                                    <th>Asset No</th>
                                                    <th>Asset Name</th>
                                                    <th>Model</th>
                                                </tr>
                                            </thead>

                                            <tbody id="assetTableBody">
                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>


                            <div class="row g-4 mt-1">

                                <div class="col-lg-6">

                                    <div class="card h-100">

                                        <div class="card-header d-flex align-items-center justify-content-between">

                                            <h5 class="card-title mb-0">
                                                <i class="align-middle me-2" data-lucide="check-circle"></i>
                                                Items Selected to Dispose
                                            </h5>

                                            <span class="badge bg-primary">
                                                <span id="selectedCount">0</span>
                                                Assets Selected
                                            </span>

                                        </div>

                                        <div class="card-body p-2">

                                            <div class="table-responsive"
                                                 style="max-height:300px; min-height:300px; overflow-y:auto;">

                                                <table id="newChosenTable"
                                                       class="table table-striped table-hover align-middle mb-0">

                                                    <thead>
                                                        <tr>
                                                            <th>Disposing Assets</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                    </tbody>

                                                </table>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="col-lg-6">

                                    <div class="card h-100"
                                         id="itemsContainer"
                                         style="display:none;">

                                        <div class="card-header">

                                            <h5 class="card-title mb-0">
                                                <i class="align-middle me-2" data-lucide="link"></i>
                                                Previously Linked Items
                                            </h5>

                                        </div>

                                        <div class="card-body p-2">

                                            <div class="table-responsive"
                                                 style="max-height:300px; min-height:300px; overflow-y:auto;">

                                                <table class="table table-striped table-hover align-middle mb-0">

                                                    <thead>
                                                        <tr>
                                                            <th>Linked Assets</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody id="tblItemsBody">
                                                    </tbody>

                                                </table>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div id="selectedAssetsHidden"></div>
                            <div id="removedAssetsHidden"></div>

                        </div>

                        <div class="card-footer">

                            <div class="d-flex justify-content-end gap-2">

                                <button type="reset"
                                        class="btn btn-danger">

                                    <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                                    Cancel

                                </button>

                                <button id="disposeBtn"
                                        type="submit"
                                        class="btn btn-success btnSubmitDisable">

                                    <i class="align-middle me-1" data-lucide="save"></i>
                                    Update Items

                                </button>

                                <button id="sendToApprovalBtn"
                                        type="button"
                                        class="btn btn-primary openModalUpdateApprove"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalUpdateApprove">

                                    <i class="align-middle me-1" data-lucide="send"></i>
                                    Send To Approval

                                </button>

                            </div>

                        </div>
                    }

                </div>


                <div id="tab_OnGoing"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Requested Date</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status > DisposalStatusEnum.Initiated &&
                                    r.Status <= DisposalStatusEnum.InTransit))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.Status.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div id="tab_Approved"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status == DisposalStatusEnum.Approved))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>

                                            <button type="button"
                                                    data-id="@item.DisposalRequestId"
                                                    class="openModalUpdateRequest btn btn-primary btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateRequest">

                                                <i class="align-middle me-1" data-lucide="pencil"></i>
                                                Update Request

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div id="tab_InTransit"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status == DisposalStatusEnum.InTransit))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>

                                            <button type="button"
                                                    data-id="@item.DisposalRequestId"
                                                    class="completeBtn btn btn-success btn-sm">

                                                <i class="align-middle me-1" data-lucide="check-circle"></i>
                                                Complete

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div id="tab_Returned"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status == DisposalStatusEnum.Return))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>

                                            <button type="button"
                                                    data-id="@item.DisposalRequestId"
                                                    class="resubmitBtn btn btn-primary btn-sm">

                                                <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                                                Amend and Resubmit

                                            </button>

                                            <button type="button"
                                                    data-id="@item.DisposalRequestId"
                                                    class="openModalUpdateReject btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalUpdateReject">

                                                <i class="align-middle me-1" data-lucide="thumbs-down"></i>
                                                Reject

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div id="tab_Rejected"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status == DisposalStatusEnum.Reject))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <div id="tab_Completed"
                     class="tab-pane fade p-4"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle dataTable w-100">

                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.AllDisposalRequests.Where(r =>
                                    r.Status == DisposalStatusEnum.Completed))
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink("", "DisposalRequestInfo", "AssetTransaction", "", new { id = item.DisposalRequestId }, null)"
                                               target="_blank">
                                                #@item.DisposalRequestId
                                            </a>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>
                                            @item.RequestCreatedDate.ToString("yyyy-MM-dd")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>


<div class="modal fade"
     id="modalUpdateApprove"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="approvalRequestId"></span>
                    Send To Approval
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label for="textCommentApproval"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="textCommentApproval"
                           class="form-control"
                           placeholder="Enter comment" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="generalCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-primary btn-sm btnClickDisable"
                        onclick="sendToApproval()">

                    <i class="align-middle me-1" data-lucide="send"></i>
                    Send

                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalUpdateRequest"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="updateRequestLabel"></span>
                    Update Request
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalTicketIdUpdateRequest" />

                <div class="mb-3">

                    <label for="textBuyerName"
                           class="form-label">
                        Buyer Name
                    </label>

                    <input type="text"
                           id="textBuyerName"
                           class="form-control"
                           placeholder="Enter Buyer Name" />

                </div>


                <div class="mb-3">

                    <label for="fileInput"
                           class="form-label">
                        Upload Spend Smart Approval &amp; Procurement Approval Documents
                    </label>

                    <div class="input-group">

                        <input type="file"
                               id="fileInput"
                               multiple
                               class="form-control" />

                        <button type="button"
                                id="fileButton"
                                class="btn btn-info"
                                disabled>

                            <i class="align-middle me-1" data-lucide="upload"></i>
                            Upload Files

                        </button>

                    </div>

                </div>

                <div id="uploadedFiles"></div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="buyergeneralCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-primary btn-sm btnClickDisable"
                        onclick="updateRequest()">

                    <i class="align-middle me-1" data-lucide="save"></i>
                    Update

                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalUpdateReject"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request #<span id="rejectRequestLabel"></span>
                    Reject
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalTicketIdReject" />

                <div class="mb-3">

                    <label for="textCommentReject"
                           class="form-label">
                        Comment
                    </label>

                    <input type="text"
                           id="textCommentReject"
                           name="textCommentReject"
                           class="form-control"
                           placeholder="Enter Comment" />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="rejectGeneralCancelBtn"
                        class="btn btn-light btn-sm"
                        data-bs-dismiss="modal">

                    <i class="align-middle me-1" data-lucide="x"></i>
                    Cancel

                </button>

                <button type="button"
                        class="btn btn-danger btn-sm btnClickDisable"
                        onclick="reject()">

                    <i class="align-middle me-1" data-lucide="thumbs-down"></i>
                    Reject

                </button>

            </div>

        </div>

    </div>

</div>


@section scripts {

    <script type="text/javascript">

        var selectedAssets = {};
        var linkedAssets = {};
        var removedAssets = {};


        $(document).ready(function () {

            if ($.fn.select2) {
                $(".select2").select2({
                    width: "100%"
                });
            }

            loadDisposalRequests();
            loadLocations();
            loadAssetCategory();
            loadAssets();
            loadTempDocs();

            $("#disposeBtn").prop("disabled", true);
            $("#sendToApprovalBtn").prop("disabled", true);

            if ($.fn.DataTable) {

                $(".dataTable").DataTable({
                    paging: true,
                    lengthChange: true,
                    searching: true,
                    ordering: false,
                    info: true,
                    autoWidth: false,
                    responsive: true
                });

            }

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return $("<div/>").text(value).html();

        }


        $(document).on("click", ".openModalUpdateApprove", function () {

            var id =
                $("#drpRequest").val();

            $("#approvalRequestId").text(id);

            $(".btnClickDisable")
                .prop("disabled", false);

        });


        $(document).on("click", ".openModalUpdateRequest", function () {

            var id =
                $(this).data("id");

            $("#updateRequestLabel").text(id);

            $("#modalTicketIdUpdateRequest")
                .val(id);

            $(".btnClickDisable")
                .prop("disabled", false);

            loadTempDocs();

        });


        $(document).on("click", ".openModalUpdateReject", function () {

            var id =
                $(this).data("id");

            $("#modalTicketIdReject")
                .val(id);

            $("#rejectRequestLabel")
                .text(id);

            $(".btnClickDisable")
                .prop("disabled", false);

        });


        $("#fileInput").on("change", function () {

            $("#fileButton")
                .prop(
                    "disabled",
                    !this.files || this.files.length === 0
                );

        });


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchIdFrom");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.BranchIdFrom';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadDepartments();

                }
            );

        }


        $("#BranchIdFrom").on("change", function () {

            loadDepartments();
            loadAssets();

        });


        function loadDepartments() {

            var branchId =
                $("#BranchIdFrom").val();

            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown =
                        $("#DepartmentIdFrom");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.DepartmentIdFrom';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadAssets();

                }
            );

        }


        $("#DepartmentIdFrom").on("change", function () {

            loadAssets();

        });


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    loadAssetType();

                }
            );

        }


        $("#AssetCategoryId").on("change", function () {

            loadAssetType();

        });


        function loadAssetType() {

            var categoryId =
                $("#AssetCategoryId").val();

            $.getJSON(
                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',
                {
                    assetCategory: categoryId
                },
                function (data) {

                    var dropDown =
                        $("#AssetTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.AssetTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    loadAssets();

                }
            );

        }


        $("#AssetTypeId").on("change", function () {

            loadAssets();

        });


        function loadDisposalRequests() {

            $.getJSON(
                '@Url.Action("GetDisposalRequestsListJsonResult", "AssetTransaction")',
                function (data) {

                    var dropDown =
                        $("#drpRequest");

                    dropDown.find("option:not(:first)").remove();

                    $.each(
                        parseJsonResult(data),
                        function (index, request) {

                            dropDown.append(
                                $("<option/>", {
                                    value: request.DisposalRequestId,
                                    text:
                                        "Request #" +
                                        request.DisposalRequestId +
                                        " - " +
                                        request.Title
                                })
                            );

                        }
                    );

                }
            );

        }


        $("#drpRequest").on("change", function () {

            var selectedId =
                $(this).val();

            var tableBody =
                $("#tblItemsBody");

            var container =
                $("#itemsContainer");

            linkedAssets = {};
            removedAssets = {};

            tableBody.empty();

            if (!selectedId || selectedId === "0") {

                container.hide();

                $("#sendToApprovalBtn")
                    .prop("disabled", true);

                updateSubmitButtonState();

                return;

            }


            $.ajax({

                url: '@Url.Action("GetLinkedDisposalItemsJsonResult", "AssetTransaction")',

                type: "GET",

                dataType: "json",

                data: {
                    requestId: selectedId
                },

                success: function (data) {

                    var items =
                        parseJsonResult(data);

                    if (items.length === 0) {

                        tableBody.append(
                            "<tr>" +
                                "<td class='text-center text-muted'>" +
                                    "No items found" +
                                "</td>" +
                            "</tr>"
                        );

                        container.show();

                        $("#sendToApprovalBtn")
                            .prop("disabled", true);

                        updateSubmitButtonState();

                        return;

                    }


                    $.each(
                        items,
                        function (index, asset) {

                            linkedAssets[asset.AssetId] =
                                asset;

                            var row =
                                "<tr data-id='" + asset.AssetId + "'>" +

                                    "<td>" +

                                        "<div class='d-flex align-items-center justify-content-between gap-2'>" +

                                            "<span>" +
                                                escapeHtml(asset.AssetNo) +
                                                " - " +
                                                escapeHtml(asset.AssetName) +
                                            "</span>" +

                                            "<button type='button' " +
                                                    "class='btn btn-sm btn-danger btnRemoveLinkedAsset'>" +

                                                "<i data-lucide='unlink'></i> Remove" +

                                            "</button>" +

                                        "</div>" +

                                    "</td>" +

                                "</tr>";

                            tableBody.append(row);

                        }
                    );


                    container.show();

                    $("#sendToApprovalBtn")
                        .prop("disabled", false);

                    updateSubmitButtonState();

                    if (window.lucide) {
                        lucide.createIcons();
                    }

                },

                error: function () {

                    Swal.fire(
                        "Something went wrong!",
                        "Unable to load linked assets",
                        "error"
                    );

                }

            });

        });


        $(document).on("click", ".btnRemoveLinkedAsset", function () {

            var button =
                $(this);

            var row =
                button.closest("tr");

            var assetId =
                row.data("id");

            removedAssets[assetId] =
                linkedAssets[assetId];

            delete linkedAssets[assetId];


            button
                .removeClass("btnRemoveLinkedAsset btn-danger")
                .addClass("btnUndo btn-secondary")
                .html(
                    "<i data-lucide='rotate-ccw'></i> Undo"
                );


            updateSubmitButtonState();


            if (window.lucide) {
                lucide.createIcons();
            }

        });


        $(document).on("click", ".btnUndo", function () {

            var button =
                $(this);

            var row =
                button.closest("tr");

            var assetId =
                row.data("id");

            linkedAssets[assetId] =
                removedAssets[assetId];

            delete removedAssets[assetId];


            button
                .removeClass("btnUndo btn-secondary")
                .addClass("btnRemoveLinkedAsset btn-danger")
                .html(
                    "<i data-lucide='unlink'></i> Remove"
                );


            updateSubmitButtonState();


            if (window.lucide) {
                lucide.createIcons();
            }

        });


        function loadAssets() {

            var branchId =
                $("#BranchIdFrom").val() || 0;

            var departmentId =
                $("#DepartmentIdFrom").val() || 0;

            var categoryId =
                $("#AssetCategoryId").val() || 0;

            var typeId =
                $("#AssetTypeId").val() || 0;


            if (branchId == 0 &&
                departmentId == 0 &&
                categoryId == 0 &&
                typeId == 0) {

                $("#assetTableBody").empty();

                updateSelectAllState();

                return;

            }


            $.getJSON(
                '@Url.Action("GetDisposedAssetListJsonResult", "AssetTransaction")',
                {
                    branchId: branchId,
                    deptId: departmentId,
                    assetCatId: categoryId,
                    assetTypeId: typeId
                },
                function (data) {

                    var tableBody =
                        $("#assetTableBody");

                    tableBody.empty();


                    $.each(
                        parseJsonResult(data),
                        function (index, asset) {

                            var checked =
                                selectedAssets[asset.AssetId]
                                    ? " checked"
                                    : "";

                            var row =
                                "<tr>" +

                                    "<td>" +

                                        "<input type='checkbox' " +
                                               "class='form-check-input asset-checkbox' " +
                                               "value='" + asset.AssetId + "'" +
                                               checked +
                                               " />" +

                                    "</td>" +

                                    "<td>" +
                                        escapeHtml(asset.AssetNo) +
                                    "</td>" +

                                    "<td>" +
                                        escapeHtml(asset.AssetName) +
                                    "</td>" +

                                    "<td>" +
                                        escapeHtml(asset.ModelName) +
                                    "</td>" +

                                "</tr>";


                            tableBody.append(row);

                        }
                    );


                    updateSelectAllState();

                }
            );

        }


        $(document).on("change", ".asset-checkbox", function () {

            var checkbox =
                $(this);

            var row =
                checkbox.closest("tr");

            var assetId =
                checkbox.val();

            var asset = {
                AssetId: assetId,
                AssetNo: row.find("td:eq(1)").text().trim(),
                AssetName: row.find("td:eq(2)").text().trim(),
                ModelName: row.find("td:eq(3)").text().trim()
            };


            if (checkbox.is(":checked")) {

                if (removedAssets[assetId]) {

                    linkedAssets[assetId] =
                        removedAssets[assetId];

                    delete removedAssets[assetId];

                    $("#tblItemsBody tr[data-id='" + assetId + "']")
                        .find(".btnUndo")
                        .removeClass("btnUndo btn-secondary")
                        .addClass("btnRemoveLinkedAsset btn-danger")
                        .html("<i data-lucide='unlink'></i> Remove");

                }
                else if (!linkedAssets[assetId]) {

                    selectedAssets[assetId] =
                        asset;

                }

            }
            else {

                delete selectedAssets[assetId];

            }


            renderSelectedTable();
            updateSelectAllState();


            if (window.lucide) {
                lucide.createIcons();
            }

        });


        function renderSelectedTable() {

            var tbody =
                $("#newChosenTable tbody");

            var hiddenDiv =
                $("#selectedAssetsHidden");

            tbody.empty();
            hiddenDiv.empty();

            var index =
                0;


            $.each(
                selectedAssets,
                function (id, asset) {

                    var row =
                        "<tr>" +

                            "<td>" +

                                "<div class='d-flex align-items-center gap-2'>" +

                                    "<input type='checkbox' " +
                                           "class='form-check-input remove-asset' " +
                                           "value='" + asset.AssetId + "' " +
                                           "checked />" +

                                    "<span>" +
                                        escapeHtml(asset.AssetNo) +
                                        " - " +
                                        escapeHtml(asset.AssetName) +
                                    "</span>" +

                                "</div>" +

                            "</td>" +

                        "</tr>";


                    tbody.append(row);


                    hiddenDiv.append(
                        "<input type='hidden' " +
                               "name='Assets[" + index + "].AssetId' " +
                               "value='" + asset.AssetId + "' />"
                    );


                    index++;

                }
            );


            $("#selectedCount")
                .text(Object.keys(selectedAssets).length);


            updateSubmitButtonState();

        }


        $(document).on("change", ".remove-asset", function () {

            var assetId =
                $(this).val();

            delete selectedAssets[assetId];

            $(".asset-checkbox[value='" + assetId + "']")
                .prop("checked", false);

            renderSelectedTable();
            updateSelectAllState();

        });


        $("#selectAllAssets").on("change", function () {

            $("#loadingSpinner").show();

            var checked =
                $(this).is(":checked");


            setTimeout(function () {

                $(".asset-checkbox").each(function () {

                    var checkbox =
                        $(this);

                    if (checkbox.is(":checked") !== checked) {

                        checkbox
                            .prop("checked", checked)
                            .trigger("change");

                    }

                });


                $("#loadingSpinner").hide();

            }, 50);

        });


        function updateSelectAllState() {

            var total =
                $(".asset-checkbox").length;

            var checked =
                $(".asset-checkbox:checked").length;

            var selectAll =
                $("#selectAllAssets");


            if (total === 0 || checked === 0) {

                selectAll
                    .prop("checked", false)
                    .prop("indeterminate", false);

                return;

            }


            if (checked === total) {

                selectAll
                    .prop("checked", true)
                    .prop("indeterminate", false);

            }
            else {

                selectAll
                    .prop("checked", false)
                    .prop("indeterminate", true);

            }

        }


        function updateSubmitButtonState() {

            var selectedCount =
                Object.keys(selectedAssets).length;

            var removedCount =
                Object.keys(removedAssets).length;


            $("#disposeBtn")
                .prop(
                    "disabled",
                    selectedCount === 0 &&
                    removedCount === 0
                );

        }


        $("form[action*='Disposed']").on("submit", function () {

            var hiddenDiv =
                $("#selectedAssetsHidden");

            var removeDiv =
                $("#removedAssetsHidden");

            hiddenDiv.empty();
            removeDiv.empty();

            var index =
                0;


            $.each(
                selectedAssets,
                function (id, asset) {

                    hiddenDiv.append(
                        "<input type='hidden' " +
                               "name='Assets[" + index + "].AssetId' " +
                               "value='" + asset.AssetId + "' />"
                    );

                    index++;

                }
            );


            index = 0;


            $.each(
                removedAssets,
                function (id, asset) {

                    removeDiv.append(
                        "<input type='hidden' " +
                               "name='RemovedAssets[" + index + "].AssetId' " +
                               "value='" + asset.AssetId + "' />"
                    );

                    index++;

                }
            );

        });


        $("#generalCancelBtn").on("click", function () {

            $("#textCommentApproval").val("");

        });


        $("#buyergeneralCancelBtn").on("click", function () {

            $("#textBuyerName").val("");

        });


        $("#rejectGeneralCancelBtn").on("click", function () {

            $("#textCommentReject").val("");

        });


        function sendToApproval() {

            var requestId =
                $("#drpRequest").val();

            var comment =
                $("#textCommentApproval").val();


            if (!requestId || requestId === "0") {

                Swal.fire(
                    "Error",
                    "Please select a disposal request",
                    "error"
                );

                return;

            }


            $(".btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "Comment",
                comment
            );


            fetch(
                '@Url.Action("SendDisposalToApproval", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been sent to approval",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else {

                    $(".btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $(".btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }


        function reject() {

            var requestId =
                $("#modalTicketIdReject").val();

            var comment =
                $("#textCommentReject").val();


            if (!comment || comment.trim() === "") {

                Swal.fire(
                    "Error",
                    "Please provide comment",
                    "error"
                );

                return;

            }


            $(".btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "Comment",
                comment.trim()
            );


            fetch(
                '@Url.Action("DisposalReject", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been rejected",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else if (data === 3) {

                    $(".btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Please provide comment",
                        "error"
                    );

                }
                else {

                    $(".btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $(".btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }


        $("#fileButton").on("click", function () {

            var files =
                $("#fileInput").get(0).files;

            if (!files || files.length === 0) {
                return;
            }


            var fileData =
                new FormData();


            for (var i = 0; i < files.length; i++) {

                fileData.append(
                    "fileInput",
                    files[i]
                );

            }


            $("#fileButton")
                .prop("disabled", true);


            $.ajax({

                type: "POST",

                url: '@Url.Action("UploadFiles", "ChangeRequest")',

                dataType: "json",

                contentType: false,

                processData: false,

                data: fileData,

                success: function (result) {

                    Swal.fire(
                        "Completed",
                        result,
                        "success"
                    );

                    $("#fileInput").val("");

                    loadTempDocs();

                },

                error: function () {

                    Swal.fire(
                        "Something went wrong!",
                        "Please try again",
                        "error"
                    );

                },

                complete: function () {

                    $("#fileButton")
                        .prop("disabled", true);

                }

            });

        });


        function loadTempDocs() {

            $.getJSON(
                '@Url.Action("GetTempDocListJsonResult", "ChangeRequest")',
                function (data) {

                    var tempDocDiv =
                        $("#uploadedFiles");

                    tempDocDiv.empty();


                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            var row =
                                "<div class='d-flex align-items-center gap-2 mb-2'>" +

                                    "<button type='button' " +
                                            "class='btn btn-sm btn-danger' " +
                                            "onclick='deleteDoc(" + item.TempDocId + ")'>" +

                                        "<i data-lucide='trash-2'></i>" +

                                    "</button>" +

                                    "<a href='" + escapeHtml(item.FileUrl) + "' " +
                                       "target='_blank'>" +

                                        "<i data-lucide='file-text'></i> " +
                                        escapeHtml(item.DocumentName) +

                                    "</a>" +

                                "</div>";


                            tempDocDiv.append(row);

                        }
                    );


                    if (window.lucide) {
                        lucide.createIcons();
                    }

                }
            );

        }


        function deleteDoc(itemId) {

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to delete?",
                icon: "warning",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                showCancelButton: true,
                reverseButtons: true
            }).then(function (result) {

                if (result.isConfirmed || result.value) {

                    $.ajax({

                        url: '@Url.Action("DeleteTempDoc", "ChangeRequest")',

                        type: "GET",

                        dataType: "json",

                        data: {
                            id: itemId
                        },

                        success: function (data) {

                            if (data == "1" || data == 1) {

                                Swal.fire(
                                    "Deleted!",
                                    "Record has been deleted",
                                    "success"
                                );

                                loadTempDocs();

                            }
                            else {

                                Swal.fire(
                                    "Something went wrong!",
                                    "Data is not deleted, Please try again",
                                    "error"
                                );

                            }

                        },

                        error: function () {

                            Swal.fire(
                                "Something went wrong!",
                                "Data is not deleted, Please try again",
                                "error"
                            );

                        }

                    });

                }

            });

        }


        function updateRequest() {

            var requestId =
                $("#modalTicketIdUpdateRequest").val();

            var buyerName =
                $("#textBuyerName").val();


            $(".btnClickDisable")
                .prop("disabled", true);


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );

            formData.append(
                "BuyerName",
                buyerName
            );


            fetch(
                '@Url.Action("UpdateDisposalRequest", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been updated",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else {

                    $(".btnClickDisable")
                        .prop("disabled", false);

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            })
            .catch(function () {

                $(".btnClickDisable")
                    .prop("disabled", false);

                Swal.fire(
                    "Error",
                    "Something went wrong",
                    "error"
                );

            });

        }


        $(document).on("click", ".completeBtn", function () {

            var requestId =
                $(this).data("id");


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );


            fetch(
                '@Url.Action("CompleteDisposalRequest", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been completed",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else {

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            });

        });


        $(document).on("click", ".resubmitBtn", function () {

            var requestId =
                $(this).data("id");


            var formData =
                new FormData();

            formData.append(
                "RequestId",
                requestId
            );


            fetch(
                '@Url.Action("DisposalResubmit", "AssetTransaction")',
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    },
                    body: formData
                }
            )
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {

                if (data === 1) {

                    Swal.fire(
                        "Completed",
                        "Request has been sent for amendment and resubmission",
                        "success"
                    );

                    setTimeout(function () {
                        window.location.reload();
                    }, 300);

                }
                else {

                    Swal.fire(
                        "Error",
                        "Something went wrong",
                        "error"
                    );

                }

            });

        });

    </script>

}

