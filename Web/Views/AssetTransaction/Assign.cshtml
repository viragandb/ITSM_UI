@model Web.Models.TransferVM
@using Service
@using Domain

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Assign", "AssetTransaction", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="arrow-right-left"></i>
                        Asset Transfer
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.BranchIdFrom,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.BranchIdFrom,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.DepartmentIdFrom,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.DepartmentIdFrom,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.AssignedType,
                                new { @class = "form-label" }
                            )

                            @Html.EnumDropDownListFor(
                                model => model.AssignedType,
                                "-- Select --",
                                new { @class = "form-select" }
                            )

                        </div>

                    </div>


                    <div class="row g-3 mt-1">

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.AssignTo,
                                new { @class = "form-label" }
                            )

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="align-middle" data-lucide="user"></i>
                                </span>

                                @Html.TextBoxFor(
                                    model => model.AssignTo,
                                    new
                                    {
                                        placeholder = "Type LAN Id here to search",
                                        @class = "form-control"
                                    }
                                )

                            </div>

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.AssignUserName,
                                new { @class = "form-label" }
                            )

                            @Html.TextBoxFor(
                                model => model.AssignUserName,
                                new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly"
                                }
                            )

                        </div>

                    </div>


                    <div class="card mt-4">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                <i class="align-middle me-2" data-lucide="boxes"></i>
                                Assets
                            </h5>

                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-3">

                                    <label for="AssetCategoryId" class="form-label">
                                        Asset Category
                                    </label>

                                    <select id="AssetCategoryId"
                                            name="AssetCategoryId"
                                            class="form-select">
                                    </select>

                                </div>

                                <div class="col-md-3">

                                    <label for="AssetTypeId" class="form-label">
                                        Asset Type
                                    </label>

                                    <select id="AssetTypeId"
                                            name="AssetTypeId"
                                            class="form-select">
                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="AssetItemId" class="form-label">
                                        Asset
                                    </label>

                                    <select id="AssetItemId"
                                            name="AssetItemId"
                                            class="form-select select2">
                                    </select>

                                </div>

                                <div class="col-md-2 d-flex align-items-end">

                                    <button type="button"
                                            class="btn btn-primary w-100 btnSubmitAdd"
                                            onclick="addAsset()">

                                        <i class="align-middle me-1" data-lucide="plus"></i>
                                        Add

                                    </button>

                                </div>

                            </div>


                            <div class="table-responsive mt-4">

                                <table id="dataTable"
                                       class="table table-striped table-hover align-middle mb-0">

                                    <thead>
                                        <tr>
                                            <th>Asset</th>
                                            <th class="text-end" style="width:80px;">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="assetdata">

                                        @if (Model.Assets != null)
                                        {
                                            for (var i = 0; i < Model.Assets.Count; i++)
                                            {
                                                <tr>

                                                    <td>

                                                        @Html.HiddenFor(
                                                            m => Model.Assets[i].AssetId,
                                                            new { @class = "iHidden" }
                                                        )

                                                        @Html.HiddenFor(
                                                            m => Model.Assets[i].AssetName
                                                        )

                                                        @Model.Assets[i].AssetName

                                                    </td>

                                                    <td class="text-end">

                                                        <button type="button"
                                                                class="btn btn-sm btn-danger btnRemoveAsset">

                                                            <i class="align-middle" data-lucide="trash-2"></i>

                                                        </button>

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>


                    <div class="row g-3 mt-4">

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.BranchId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.BranchId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                        </div>

                        <div class="col-md-4">

                            @Html.LabelFor(
                                model => model.DepartmentId,
                                new { @class = "form-label" }
                            )

                            @Html.DropDownListFor(
                                model => model.DepartmentId,
                                new List<SelectListItem>(),
                                new { @class = "form-select select2" }
                            )

                        </div>

                    </div>


                    <div class="row g-3 mt-1">

                        <div class="col-12">

                            @Html.LabelFor(
                                model => model.Comment,
                                new { @class = "form-label" }
                            )

                            @Html.TextAreaFor(
                                model => model.Comment,
                                new
                                {
                                    @class = "form-control",
                                    rows = "3",
                                    style = "white-space: pre-wrap;"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.Comment,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end gap-2">

                        <button type="reset"
                                class="btn btn-danger">

                            <i class="align-middle me-1" data-lucide="rotate-ccw"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary btnSubmitDisable">

                            <i class="align-middle me-1" data-lucide="save"></i>
                            Save

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>
}

@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            if ($.fn.select2) {

                $(".select2").select2({
                    width: "100%"
                });

            }

            SearchADUser();
            loadLocations();
            loadAssetCategory();
            loadToLocations();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return $("<div/>")
                .text(value)
                .html();

        }


        function SearchADUser() {

            $("#AssignTo").autocomplete({

                source: function (request, response) {

                    $("#AssignUserName").val("");

                    $.ajax({

                        url: '@Url.Action("GetSearchUserByLanIdJsonResult", "User")',

                        dataType: "json",

                        data: {
                            term: request.term
                        },

                        success: function (data) {

                            response(
                                $.map(
                                    data,
                                    function (val) {

                                        return {
                                            label:
                                                val.EmpNo +
                                                " - " +
                                                val.FullName +
                                                " | " +
                                                val.DepartmentName,

                                            value: val.EmpNo,
                                            itemId: val.EmpNo,
                                            itemName: val.FullName
                                        };

                                    }
                                )
                            );

                        }

                    });

                },

                minLength: 1,

                select: function (event, ui) {

                    $("#AssignUserName")
                        .val(ui.item.itemName);

                }

            });

        }


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchIdFrom");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.BranchIdFrom';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadDepartments();

                }
            );

        }


        $("#BranchIdFrom").on("change", function () {

            loadDepartments();
            loadAssets();

        });


        function loadDepartments() {

            var branchId =
                $("#BranchIdFrom").val();

            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown =
                        $("#DepartmentIdFrom");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.DepartmentIdFrom';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadAssets();

                }
            );

        }


        $("#DepartmentIdFrom").on("change", function () {

            removeItems();
            loadAssets();

        });


        function loadAssetCategory() {

            $.getJSON(
                '@Url.Action("GetAssetCategoryJsonResult", "AssetType")',
                function (data) {

                    var dropDown =
                        $("#AssetCategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    loadAssetType();

                }
            );

        }


        $("#AssetCategoryId").on("change", function () {

            loadAssetType();

        });


        function loadAssetType() {

            var categoryId =
                $("#AssetCategoryId").val();

            $.getJSON(
                '@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")',
                {
                    assetCategory: categoryId
                },
                function (data) {

                    var dropDown =
                        $("#AssetTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetTypeId,
                                    text: item.AssetTypeName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.AssetTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    loadAssets();

                }
            );

        }


        $("#AssetTypeId").on("change", function () {

            loadAssets();

        });


        function loadAssets() {

            var branchId =
                $("#BranchIdFrom").val() || 0;

            var departmentId =
                $("#DepartmentIdFrom").val() || 0;

            var categoryId =
                $("#AssetCategoryId").val() || 0;

            var typeId =
                $("#AssetTypeId").val() || 0;


            $.getJSON(
                '@Url.Action("GetAssetListAvbJsonResult", "Asset")',
                {
                    branchId: branchId,
                    deptId: departmentId,
                    assetCatId: categoryId,
                    assetTypeId: typeId
                },
                function (data) {

                    var dropDown =
                        $("#AssetItemId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AssetId,
                                    text:
                                        item.AssetNo +
                                        " - " +
                                        item.Barcode
                                })
                            );

                        }
                    );

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function loadToLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown =
                        $("#BranchId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.BranchId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                    loadToDepartments();

                }
            );

        }


        $("#BranchId").on("change", function () {

            loadToDepartments();

        });


        function loadToDepartments() {

            var branchId =
                $("#BranchId").val();

            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown =
                        $("#DepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- Select --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );

                    var selectedId =
                        '@ViewBag.DepartmentId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    if ($.fn.select2) {
                        dropDown.trigger("change.select2");
                    }

                }
            );

        }


        function addAsset() {

            var assetId =
                $("#AssetItemId").val();

            var assetName =
                $("#AssetItemId option:selected").text();


            if (!assetId || assetId === "0") {

                Swal.fire(
                    "Error!",
                    "Please select an asset",
                    "error"
                );

                return;

            }


            var duplicate =
                false;


            $("#assetdata input.iHidden").each(function () {

                if ($(this).val() == assetId) {

                    duplicate =
                        true;

                    return false;

                }

            });


            if (duplicate) {

                Swal.fire(
                    "Error!",
                    "Asset has already been added",
                    "error"
                );

                return;

            }


            var row =
                "<tr>" +

                    "<td>" +

                        "<input type='hidden' " +
                               "class='iHidden asset-id' " +
                               "value='" + escapeHtml(assetId) + "' />" +

                        "<input type='hidden' " +
                               "class='asset-name' " +
                               "value='" + escapeHtml(assetName) + "' />" +

                        escapeHtml(assetName) +

                    "</td>" +

                    "<td class='text-end'>" +

                        "<button type='button' " +
                                "class='btn btn-sm btn-danger btnRemoveAsset'>" +

                            "<i data-lucide='trash-2'></i>" +

                        "</button>" +

                    "</td>" +

                "</tr>";


            $("#assetdata").append(row);

            reindexAssets();


            if (window.lucide) {
                lucide.createIcons();
            }

        }


        $(document).on("click", ".btnRemoveAsset", function () {

            $(this)
                .closest("tr")
                .remove();

            reindexAssets();

        });


        function reindexAssets() {

            $("#assetdata tr").each(function (index) {

                var row =
                    $(this);

                var assetId =
                    row.find(".asset-id");

                var assetName =
                    row.find(".asset-name");


                assetId.attr({
                    id: "Assets_" + index + "__AssetId",
                    name: "Assets[" + index + "].AssetId"
                });


                assetName.attr({
                    id: "Assets_" + index + "__AssetName",
                    name: "Assets[" + index + "].AssetName"
                });

            });

        }


        function removeItems() {

            $("#assetdata").empty();

        }

    </script>

}