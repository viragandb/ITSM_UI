@model Domain.AssetTransferRequest
@using Service

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<title>ITSM Gate Pass</title>

<div class="row">
    <div class="col-12">

        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between">

                <h5 class="card-title mb-0">
                    <i class="align-middle me-2" data-lucide="file-text"></i>
                    ITSM - Gate Pass # @Model.AssetTransferRequestId
                </h5>

                <button type="button"
                        onclick="window.print()"
                        class="btn btn-primary btn-sm">

                    <i class="align-middle me-1" data-lucide="printer"></i>
                    Print

                </button>

            </div>

            <div class="card-body">

                <div class="row">
                    <div class="col-12">

                        <div class="table-responsive">

                            <table class="table table-sm table-borderless align-middle mb-0">

                                <tbody>

                                    <tr>
                                        <th style="width:25%;">
                                            @Html.LabelFor(model => Model.TransactionType)
                                        </th>

                                        <td>
                                            @Model.TransactionType.EnumDisplayName()
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>
                                            From Location/Department
                                        </th>

                                        <td>
                                            @Model.BranchFrom.Name - @Model.DepartmentFrom.DepartmentName
                                        </td>
                                    </tr>

                                    @if (Model.TransactionType == Domain.AssetTransactionTypeEnum.SentToRepair)
                                    {
                                        <tr>
                                            <th>
                                                To Vendor
                                            </th>

                                            <td>
                                                @Model.Vendor.VendorName
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <th>
                                                To Location/Department
                                            </th>

                                            <td>
                                                @Model.Branch.Name - @Model.Department.DepartmentName
                                            </td>
                                        </tr>
                                    }

                                    <tr>
                                        <th>
                                            Authorized By/Date
                                        </th>

                                        <td>
                                            @Model.AuthorizedBy - @Model.AuthorizedDate
                                        </td>
                                    </tr>

                                    @if (Model.AssignedTo != null)
                                    {
                                        <tr>
                                            <th>
                                                Allocated To
                                            </th>

                                            <td>
                                                @Model.AssignedToUser.FullName
                                            </td>
                                        </tr>
                                    }

                                    <tr>
                                        <th>
                                            @Html.LabelFor(model => Model.AssignedType)
                                        </th>

                                        <td>
                                            @Model.AssignedType.EnumDisplayName()
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>
                                            @Html.LabelFor(model => Model.Comment)
                                        </th>

                                        <td>
                                            @Model.Comment
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>
                </div>

                <hr class="my-4" />

                <div class="row">
                    <div class="col-12">

                        <div class="table-responsive">

                            <table class="table table-striped table-hover table-bordered align-middle">

                                <thead>
                                    <tr>
                                        <th>Fix Asset No</th>
                                        <th>Serial No</th>
                                        <th>Asset Type</th>
                                        <th>Asset</th>
                                        <th>Barcode No</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.TransferItems)
                                    {
                                        <tr>

                                            <td>
                                                @item.Asset.AssetNo
                                            </td>

                                            <td>
                                                @item.Asset.SerialNo
                                            </td>

                                            <td>
                                                @item.Asset.AssetType.AssetTypeName
                                            </td>

                                            <td>
                                                @item.Asset.AssetName
                                            </td>

                                            <td>
                                                @item.Asset.Barcode
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

<style>

    @@media print {

        .sidebar,
        .navbar,
        .footer,
        .btn {
            display: none !important;
        }

        .main {
            margin: 0 !important;
        }

        .content {
            padding: 0 !important;
        }

        .card {
            border: 0 !important;
            box-shadow: none !important;
        }

        .card-header {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        body {
            background: #fff !important;
        }
    }
</style>