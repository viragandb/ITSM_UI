@using Service
@model IEnumerable<Domain.KedbItem>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "Kedb", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="database"></i>
                        Requests
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="TeamId" class="form-label">
                                Team
                            </label>

                            <select id="TeamId"
                                    name="TeamId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="TeamId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>


                        <div class="col-md-4">

                            <label for="CategoryId" class="form-label">
                                Category
                            </label>

                            <select id="CategoryId"
                                    name="CategoryId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="CategoryId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>


                        <div class="col-md-2">

                            <label for="StartDate" class="form-label">
                                Requested Date
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="StartDate"
                                   value="@ViewBag.StartDate"
                                   class="form-control" />

                        </div>


                        <div class="col-md-2">

                            <label for="EndDate" class="form-label">
                                To
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="EndDate"
                                   value="@ViewBag.EndDate"
                                   class="form-control" />

                        </div>


                        <div class="col-md-4">

                            <label for="StatusId" class="form-label">
                                Status
                            </label>

                            @Html.DropDownList(
                                "StatusId",
                                EnumHelper.GetSelectList(typeof(Domain.RequestStatusEnum)),
                                "-- All --",
                                new { @class = "form-select" }
                            )

                            <span class="text-danger"
                                  data-valmsg-for="StatusId"
                                  data-valmsg-replace="true">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-sm btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Team</th>
                                    <th>Category</th>
                                    <th>Asset Type</th>
                                    <th>Subcategory</th>
                                    <th>Subject</th>
                                    <th>Root Cause</th>
                                    <th>Solution</th>
                                    <th>Requested By</th>
                                    <th>Requested Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <div class="d-flex gap-1">

                                                @if (item.TicketId != null)
                                                {
                                                    <a href="@Html.EncodedActionLink("", "TicketInfo", "Ticket", "", new { id = item.TicketId }, null)"
                                                       target="_blank"
                                                       class="btn btn-sm btn-light"
                                                       title="View Ticket">

                                                        <i class="align-middle" data-lucide="ticket"></i>

                                                    </a>
                                                }

                                                @if (item.ProblemId != null)
                                                {
                                                    <a href="@Html.EncodedActionLink("", "Info", "Problem", "", new { id = item.ProblemId }, null)"
                                                       target="_blank"
                                                       class="btn btn-sm btn-light"
                                                       title="View Problem">

                                                        <i class="align-middle" data-lucide="circle-help"></i>

                                                    </a>
                                                }

                                            </div>

                                        </td>

                                        <td>
                                            @(item.RequestType != null && item.RequestType.Team != null
                                                ? item.RequestType.Team.TeamName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @(item.RequestType != null && item.RequestType.Category != null
                                                ? item.RequestType.Category.CategoryName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @(item.RequestType != null && item.RequestType.AssetType != null
                                                ? item.RequestType.AssetType.AssetTypeName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @(item.RequestType != null && item.RequestType.SubCategory != null
                                                ? item.RequestType.SubCategory.SubCategoryName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @item.Subject
                                        </td>

                                        <td style="white-space: pre-wrap;">
                                            @item.RootCause
                                        </td>

                                        <td style="white-space: pre-wrap;">
                                            @item.Solution
                                        </td>

                                        <td>
                                            @(item.RequestedUser != null
                                                ? item.RequestedUser.FullName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @item.RequestedDate.ToShortDateString()
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @item.Status.EnumDisplayName()
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>
}


@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#dataTable").DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: false
            });

            loadTeams();
            loadCategory();

        });


        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];
        }


        function loadTeams() {

            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    var dropDown = $("#TeamId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.TeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadCategory() {

            $.getJSON(
                '@Url.Action("GetCategoryListJsonResult", "Category")',
                function (data) {

                    var dropDown = $("#CategoryId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.CategoryId,
                                    text: item.CategoryName
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.CategoryId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>
}