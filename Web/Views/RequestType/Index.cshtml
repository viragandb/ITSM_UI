@using Service
@model IEnumerable<Domain.RequestType>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "RequestType", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">

                <div class="card-header with-border">
                    <h3 class="card-title">Request Types</h3>
                    <div class="card-tools pull-right">
                        <a href="@Url.Action("Create", "RequestType")" class="btn btn-sm btn-default">
                            <i class="fa fa-plus"></i>&nbsp;&nbsp;Add New
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="form-group row">
                        <label class="control-label col-md-2">
                            Team :
                        </label>
                        <div class="col-md-4">
                            <select id="TeamId" name="TeamId" class="form-control form-control-sm">
                                <option value=""></option>
                            </select>
                            <span class="help-block" data-valmsg-for="TeamId" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="form-group row">

                        <label class="control-label col-md-2">
                            Ticket Type :
                        </label>
                        <div class="col-md-3">
                            <select id="TicketTypeId" name="TicketTypeId" class="form-control form-control-sm">
                                <option value=""></option>
                            </select>
                            <span class="help-block" data-valmsg-for="TicketTypeId" data-valmsg-replace="true"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="control-label col-md-2">
                            Category :
                        </label>
                        <div class="col-md-4">
                            <select id="CategoryId" name="CategoryId" class="form-control form-control-sm">
                                <option value=""></option>
                            </select>
                            <span class="help-block" data-valmsg-for="CategoryId" data-valmsg-replace="true"></span>
                        </div>

                    </div>

                </div>
                <div class="card-footer">
                    <div class="text-right">
                        <button type="submit" class="btn btn-sm btn-default">
                            <i class="fa fa-search"></i>&nbsp;&nbsp;Search
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>

}
<div class="row">

    <div class="col-md-12">
        <!-- Horizontal Form -->
        <div class="card box-default">
            <div class="card-body">

                <table id="dataTable" class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Request Name</th>
                            <th>Category</th>
                            <th>Asset Type</th>
                            <th>Subcategory</th>
                            <th>SLA</th>
                            <th>Updated By</th>
                            <th>Updated Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.RequestTypeId</td>
                                    <td>@item.RequestTypeName</td>
                                    <td>@item.Category.CategoryName</td>
                                    <td>@item.AssetType.AssetTypeName</td>
                                    <td>@item.SubCategory.SubCategoryName</td>
                                    <td>
                                        @if (item.TicketType == Domain.TicketTypeEnum.IN)
                                        {

                                            foreach (var sla in item.RequestTypePriorities)
                                            {
                                                <p> @sla.Priority.EnumDisplayName() &nbsp;: @sla.Respond (Respond Hrs) - @sla.Resolve (Resolve Hrs)</p>
                                            }
                                        }
                                        else
                                        {
                                            @item.Sla

                                        }
                                    </td>
                                    <td>@item.UpdatedBy</td>
                                    <td>@item.UpdatedDate</td>
                                    <td>

                                        <a onclick="deleteItem('@item.RequestTypeId')" class="btn btn-danger text-white">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "RequestType", new { id = item.RequestTypeId })" class="btn btn-info">
                                            <i class="fa fa-edit"></i>
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>
            <!-- /.box-body -->

        </div>
        <!-- /.box -->

    </div>
</div>

@section scripts {

    <script type="text/javascript">
        function deleteItem(itemId) {
            Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to delete?",
            icon: 'warning',
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            showCancelButton: true,
            reverseButtons: true,
            }).then(function (result) {
                    if (result.value) {
                         $.ajax({
                        url: "@Url.Action("Delete", "RequestType")", type: 'GET', dataType: "json",
                        data: { id: itemId },
                        success: function (data) {
                            if (data == "1") {
                                Swal.fire("Deleted!", "Record has been deleted", "success");
                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);
                            }
                            else if(data == "2")
                                Swal.fire("Data in use!", "Data is currently in use and can not be deleted", "error");
                            else
                                Swal.fire("Something went wrong!", "Data is not deleted, Please try again", "error");
                        },
                        error: function (xhr) {
                            Swal.fire("Something went wrong!", "Data is not deleted, Please try again", "error");
                             }
                        });
                    }
             });
        }


        $(document).ready(function () {

            $("#dataTable").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false, "paging": false,
                /* "buttons": ["excel", "pdf", "print", "colvis"]*/
                "buttons": [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        title: 'Request Types',
                        exportOptions: {
                            modifier: {
                                page: 'current'
                            }
                        }
                    }
                    ,

                    "colvis"
                ]
            }).buttons().container().appendTo('#dataTable_wrapper .col-md-6:eq(0)');

        });


          $(document).ready(function () {

             loadTeams();
              loadTicketTypes();
              loadCategory();
        });

        function loadTeams() {

            $.getJSON("@Url.Action("GetTeamListJsonResult", "Team")", function (data) {
                var dropDown = $("#TeamId");

                dropDown.empty();
                //dropDown.append("<option value='0'>-- Select --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.TeamId }).html(optionaldata.TeamName));
                });

                if ('@ViewBag.TeamId') {
                      $('#TeamId').val(@ViewBag.TeamId).attr("selected", "selected");
                 }


            });

        }

        function loadCategory() {

            $.getJSON("@Url.Action("GetCategoryListJsonResult", "Category")",function(data) {
                    var dropDown = $("#CategoryId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- All --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.CategoryId }).html(optionaldata.CategoryName));
                });

                 if ('@ViewBag.CategoryId') {
                     $('#CategoryId').val('@ViewBag.CategoryId').attr("selected", "selected");
                }
                @*else {
                     $('#CategoryId').val('@categoryId').attr("selected", "selected");
                }*@

                });


        }

         function loadTicketTypes() {
            $.getJSON("@Url.Action("GetTicketTypesJsonResult", "RequestType")", function (data) {
                var dropDown = $("#TicketTypeId");

                dropDown.empty();
                //dropDown.append("<option value='0'>-- Select --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });

                if ('@ViewBag.TicketTypeId') {
                    $('#TicketTypeId').val(@ViewBag.TicketTypeId).attr("selected", "selected");
                 }
            });

        }



    </script>
}
