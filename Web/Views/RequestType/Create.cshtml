
@model Web.Models.RequestTypeVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var teamId = Convert.ToInt64(TempData["TeamId"]);
    var categoryId = Convert.ToInt64(TempData["CategoryId"]);
    var subCategoryId = Convert.ToInt64(TempData["SubCategoryId"]);
    var assetTypeId = Convert.ToInt64(TempData["AssetTypeId"]);

}

<div class="row">
    <div class="col-md-12">
        <!-- Horizontal Form -->
        <div class="card card-primary card-outline">
            <div class="card-header with-border">
                <h3 class="card-title">Create New</h3>
                <div class="card-tools pull-right">
                    <a href="@Url.Action("Index", "RequestType")" class="btn btn-sm btn-default">
                        <i class="fa fa-arrow-left"></i>&nbsp;&nbsp;Back
                    </a>
                </div>
            </div>
            <!-- /.box-header -->
            <!-- form start -->

            @using (Html.BeginForm("Create", "RequestType", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-group row">
                                @Html.LabelFor(model => model.TicketType, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    @Html.EnumDropDownListFor(model => model.TicketType, "--Select--", new { @class = "form-control form-control-sm" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.TeamId, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    <select id="TeamId" name="TeamId" class="form-control form-control-sm"></select>
                                    <span class="help-block" data-valmsg-for="TeamId" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.CategoryId, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    <select id="CategoryId" name="CategoryId" class="form-control form-control-sm"></select>
                                    <span class="help-block" data-valmsg-for="CategoryId" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.AssetCategory, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    @Html.EnumDropDownListFor(model => model.AssetCategory, "--Select--", new { @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            @*<div class="form-group row">
                                <label class="control-label col-md-4">
                                    Asset Category :
                                </label>
                                <div class="col-md-8">
                                    <select id="AssetCategoryId" name="AssetCategoryId" class="form-control form-control-sm">
                                        <option value=""></option>
                                    </select>
                                    <span class="help-block" data-valmsg-for="AssetCategoryId" data-valmsg-replace="true"></span>
                                </div>
                            </div>*@

                            <div class="form-group row">
                                @Html.LabelFor(model => model.AssetTypeId, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    <select id="AssetTypeId" name="AssetTypeId" class="form-control form-control-sm"></select>
                                    <span class="help-block" data-valmsg-for="AssetTypeId" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.SubCategoryId, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-8">
                                    <select id="SubCategoryId" name="SubCategoryId" class="form-control form-control-sm"></select>
                                    <span class="help-block" data-valmsg-for="SubCategoryId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1">
                            </div>
                        <div class="col-md-5">
                            <div id="SR_Sla" class="form-group row ">
                                @Html.LabelFor(model => model.Sla, new { @class = "col-md-4 col-form-label" })
                                <div class="col-md-2">
                                    @Html.TextBoxFor(model => model.Sla, new { @class = "form-control form-control-sm" })
                                    @Html.ValidationMessageFor(model => model.Sla, null, new { @class = "help-block" })
                                </div>
                            </div>

                            <div id="IN_Sla" class="form-group row ">

                                <table id="dataTable" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Priority </th>
                                            <th>Response Time (Hrs)</th>
                                            <th>Resolution Time (Hrs)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            for (int i = 0; i < Model.RequestTypePriorities.Count; i++)
                                            {
                                                @Html.HiddenFor(m => Model.RequestTypePriorities[i].Priority)

                                        <tr>

                                            <td>@Model.RequestTypePriorities[i].Priority</td>
                                            <td width="200px">
                                                @Html.TextBoxFor(m => Model.RequestTypePriorities[i].Respond, new { @class = "form-control form-control-sm" })
                                            </td>
                                            <td width="200px">
                                                @Html.TextBoxFor(m => Model.RequestTypePriorities[i].Resolve, new { @class = "form-control form-control-sm" })
                                            </td>

                                        </tr>

                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    <div class="text-right">
                        <button type="reset" class="btn btn-sm btn-danger"><i class="fa fa-undo"></i>&nbsp;&nbsp;Cancel</button>
                        <button type="submit" class="btn btn-sm btn-default"><i class="fa fa-save"></i>&nbsp;&nbsp;Save</button>
                    </div>
                </div>
                <!-- /.box-footer -->
            }
        </div>
        <!-- /.box -->
    </div>
</div>

@section scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            loadTeams();
            loadCategory();
            loadSubCategory();
      /*      loadAssetCategory();*/
            loadAssetType();
            disableSLA();
        });

        function loadTeams() {
            $.getJSON("@Url.Action("GetTeamListJsonResult", "Team")", function (data) {
                var dropDown = $("#TeamId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.TeamId }).html(optionaldata.TeamName));
                });

                if ('@ViewBag.TeamId') {
                     $('#TeamId').val('@ViewBag.TeamId').attr("selected", "selected");
                }

            });
        }

        function loadCategory() {
            $.getJSON("@Url.Action("GetCategoryListJsonResult", "Category")", function (data) {
                var dropDown = $("#CategoryId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.CategoryId }).html(optionaldata.CategoryName));
                });

                 if ('@ViewBag.CategoryId') {
                     $('#CategoryId').val('@ViewBag.CategoryId').attr("selected", "selected");
                }

            });
         }

        function loadSubCategory() {
            $.getJSON("@Url.Action("GetSubCategoryListJsonResult", "SubCategory")", function (data) {
                var dropDown = $("#SubCategoryId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.SubCategoryId }).html(optionaldata.SubCategoryName));
                });

                 if ('@ViewBag.SubCategoryId') {
                     $('#SubCategoryId').val('@ViewBag.SubCategoryId').attr("selected", "selected");
                }

            });
         }

        function loadAssetCategory() {

            $.getJSON("@Url.Action("GetAssetCategoryJsonResult", "AssetType")", function (data) {
                var dropDown = $("#AssetCategoryId");

                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");

                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.Id }).html(optionaldata.Name));
                });

                if ('@ViewBag.AssetCategoryId') {
                    $('#AssetCategoryId').val(@ViewBag.AssetCategoryId).attr("selected", "selected");
                 }
            });

        }

        $("select#AssetCategory").change(function (evt) {
            loadAssetType();

        });
        function loadAssetType() {
            var catId = $('#AssetCategory').val();

            $.getJSON("@Url.Action("GetAssetTypeByAssetCategoryListJsonResult", "AssetType")",
                {
                    assetCategory: catId
                },function(data) {
                var dropDown = $("#AssetTypeId");
                dropDown.empty();
                dropDown.append("<option value='0'>-- Select --</option>");
                $.each(JSON.parse(data), function (index, optionaldata) {
                    dropDown.append($('<option />', { value: optionaldata.AssetTypeId }).html(optionaldata.AssetTypeName));
                });

                if ('@ViewBag.AssetTypeId') {
                     $('#AssetTypeId').val('@ViewBag.AssetTypeId').attr("selected", "selected");
                }

            });
         }

        $("select#TicketType").change(function (evt) {
            disableSLA();

        });

        function disableSLA() {
            var _ticketType = $("#TicketType").val();
            //if (_ticketType == 2) {
            //    $("#SR_Sla").attr("disabled", "disabled");
            //    $("#IN_Sla").removeAttr("disabled");
            //}
            //else {
            //    $("#IN_Sla").attr("disabled", "disabled");
            //    $("#SR_Sla").removeAttr("disabled");
            //}


            if (_ticketType == 2) {
                $("#IN_Sla").show();
                $("#SR_Sla").hide();
            }
            else {
                $("#SR_Sla").show();
                $("#IN_Sla").hide();
            }

        }

    </script>

}
