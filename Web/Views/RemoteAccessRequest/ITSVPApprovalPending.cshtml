@model ICollection<Domain.RA.RemoteAccessRequest>
@using Service.AR
@using Service
@using Domain.AR
@{

    Layout = "~/Views/Shared/_Layout.cshtml";


    var clarificationRequests =
            ViewBag.ClarificationRequests as ICollection<Domain.RA.RemoteAccessRequest>;
}


<div class="row">
    <div class="col-lg-12">

        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title m-0 mb-3">IT SVP</h3>
                <div class="clearfix mb-2"></div>


                <ul class="nav nav-pills">
                    <li class="nav-item"><a class="nav-link active" href="#tab_Pending" data-bs-toggle="tab">Pending</a></li>
                    <li class="nav-item"><a class="nav-link" href="#tab_Clarification" data-bs-toggle="tab">Request For Clarifications</a></li>

                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_Pending">

                        <div id="accordion">

                            @{
                                var expandShow = "";

                                foreach (var item in Model)
                                {
                                    <div id="R_@item.RemoteAccessRequestId" class="panel-collapse in collapse show" style="">

                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h4 class="card-title">
                                                    <a data-bs-toggle="collapse" data-parent="#accordion" href="#G_@item.RemoteAccessRequestId" class="collapsed">
                                                        Request# @item.RemoteAccessRequestId
                                                    </a>
                                                    &nbsp; | &nbsp; Remote Access (WFH)
                                                </h4>
                                                <div class="text-right">
                                                    <span class="badge bg-danger text-sm">@item.RemoteAccessType.EnumDisplayName()</span>
                                                    @if ((bool)item.IsClarificationNeeded)
                                                    {
                                                        <span class="badge bg-warning text-sm">Awaiting Clarification</span>

                                                    }

                                                </div>
                                            </div>

                                            <div id="G_@item.RemoteAccessRequestId" class="panel-collapse in collapse @expandShow" style="">
                                                <div class="card-body">
                                                    @Html.Partial("_RequestMin", item)

                                                </div>
                                                <div class="card-footer">
                                                    <div class="row float-right">
                                                        <div class="margin">
                                                            <a href="@Html.EncodedActionLink("","Info", "RemoteAccessRequest","", new { id = item.RemoteAccessRequestId },null)"
                                                               target="_blank"><i class="fas fa-info"></i>&nbsp;&nbsp;More.. </a>
                                                            @if (!(bool)item.IsClarificationNeeded)
                                                            {
                                                                <a class="btn btn-danger btn-sm text-white openModalUpdateReject"
                                                                   data-id="@item.RemoteAccessRequestId"
                                                                   data-bs-toggle="modal"
                                                                   data-bs-target="#modalUpdateReject">
                                                                    <i class="fas fa-thumbs-down"></i> Reject
                                                                </a>

                                                                <a class="btn bg-primary btn-sm text-white openModalUpdateApprove"
                                                                   data-id="@item.RemoteAccessRequestId"
                                                                   data-stage="@((int)item.ApprovalStage)"
                                                                   data-bs-toggle="modal"
                                                                   data-bs-target="#modalUpdateApprove">
                                                                    <i class="fas fa-thumbs-up"></i> Approve
                                                                </a>


                                                            <a class="btn bg-primary btn-sm text-white openModalClarification"
                                                               data-id="@item.RemoteAccessRequestId"
                                                               data-stage="@((int)item.ApprovalStage)"
                                                               data-bs-toggle="modal"
                                                               data-bs-target="#modalClarification">
                                                                <i class="fa fa-question-circle"></i> Request for clarification
                                                            </a>

                                                            }

                                                        </div>
                                                    </div>

                                                </div>
                                            </div>


                                        </div>
                                    </div>

                                }
                            }


                        </div>
                    </div>

                    <div class="tab-pane" id="tab_Clarification">

                        <div id="accordionClarification">

                            @{
                                var expandShowClarifications = "";

                                foreach (var item in clarificationRequests)
                                {
                                    <div id="R_C_@item.RemoteAccessRequestId" class="panel-collapse in collapse show" style="">

                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h4 class="card-title">
                                                    <a data-bs-toggle="collapse" data-parent="#accordionClarification" href="#C_@item.RemoteAccessRequestId" class="collapsed">
                                                        Request# @item.RemoteAccessRequestId
                                                    </a>
                                                    &nbsp; | &nbsp; Remote Access (WFH)
                                                </h4>
                                                <div class="text-right">
                                                    <span class="badge bg-danger text-sm">@item.RemoteAccessType.EnumDisplayName()</span>


                                                </div>
                                            </div>

                                            <div id="C_@item.RemoteAccessRequestId" class="panel-collapse in collapse @expandShowClarifications" style="">
                                                <div class="card-body">

                                                    @Html.Partial("_RequestMin", item)

                                                </div>
                                                <div class="card-footer">
                                                    <div class="row float-right">
                                                        <div class="margin">
                                                            <a href="@Html.EncodedActionLink("","Info", "RemoteAccessRequest","", new { id = item.RemoteAccessRequestId },null)"
                                                               target="_blank"><i class="fas fa-info"></i>&nbsp;&nbsp;More.. </a>

                                                            <a data-id="@item.RemoteAccessRequestId" class="openModalClarificationReply btn btn-primary btn-sm text-white " data-bs-toggle="modal" data-bs-target="#modalClarificationReply">
                                                                <i class="fa fa-comment"></i>  Provide clarification
                                                            </a>

                                                            <a data-id="@item.RemoteAccessRequestId"
                                                               class="openModalRouteClarification btn btn-warning btn-sm"
                                                               data-bs-toggle="modal"
                                                               data-bs-target="#modalClarification">
                                                                <i class="fa fa-share"></i> Route Clarification
                                                            </a>

                                                        </div>
                                                    </div>

                                                </div>
                                            </div>


                                        </div>
                                    </div>

                                }
                            }


                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>


<div class="modal fade" id="modalUpdateApprove">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"> Request #<label id="modelLableId"></label> Approve</h5>
            </div>

            <div class="modal-body">

                <input type="hidden" id="modalTicketIdApproval" />


                <div class="form-group">
                    <label id="commentLabel">Comment</label>
                    <input type="text" id="textCommentApproval" class="form-control" placeholder="Enter comment" />
                </div>

                <div class="form-group mb-0">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox"
                               class="custom-control-input"
                               id="chkEscalateToDCEO">

                        <label class="custom-control-label" for="chkEscalateToDCEO">
                            Escalate to DCEO
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="generalCancelBtn" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-window-close"></i> Cancel
                </button>
                <button type="button" id="generalApproveBtn" class="btn btn-info btn-sm btnClickDisable" onclick="approve()">
                    <i class="fas fa-thumbs-up"></i> Approve
                </button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="modalUpdateReject">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ">Request #<label id="modelLableId" name="modelLableId"></label> Reject</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalTicketIdReject" />

                <div class="form-group">
                    <input type="text" id="textCommentReject" name="textCommentReject" placeholder="Comment" class="form-control">
                </div>
            </div>

            <div class="modal-footer ">
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal"><i class="fas fa-window-close"></i>&nbsp;&nbsp;Cancel</button>

                <button type="button" class="btn btn-info btn-sm btnClickDisable" onclick="reject()"><i class="fas fa-thumbs-down"></i>&nbsp;&nbsp; Reject</button>


            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalClarification">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ">
                    Request #<label id="lblClarificationRequestId" name="lblClarificationRequestId"></label> <span id="lblClarificationMode"></span>
                </h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalClarificationRequestId" />
                <input type="hidden" id="ClarificationMode" />

                <div class="form-group">
                    <label>Route clarification to</label>
                    <select id="ddlClarificationTarget" class="form-control">

                        <option value="">-- Select Recipient --</option>

                        <optgroup label="Individuals">
                            <option value="Requester">Requester</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="AVPOrVP">AVP / VP</option>
                        </optgroup>

                        <optgroup label="Workflow Teams">
                            <option value="Team_19">Risk Team</option>
                            <option value="Team_20">HR Team</option>
                            <option value="Team_21">IT Security Head</option>
                        </optgroup>


                    </select>
                </div>

                <div class="form-group" id="divClarificationReason">
                    <input type="text" id="textClarificationReason" name="textClarificationReason" placeholder="Reason for clarification" class="form-control">
                </div>

            </div>

            <div class="modal-footer ">
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal"><i class="fas fa-window-close"></i>&nbsp;&nbsp;Cancel</button>
                @*<button type="button" class="btn btn-info btn-sm btnClickDisable" onclick="raiseClarification()">
            <i class="fas fa-thumbs-up"></i> Request Clarification
        </button>*@
                <button id="btnClarificationAction"
                        type="button"
                        class="btn btn-info btn-sm btnClickDisable">
                </button>

            </div>
        </div>
    </div>
</div>






<div class="modal fade" id="modalClarificationReply">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ">Request #<label id="lblClarificationReplyId" name="lblClarificationReplyId"></label> Clarify</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" name="modalClarificationReplyId" id="modalClarificationReplyId" value="" />

                <input type="text" class="form-control" placeholder="Enter clarification" name="txtClarificationReply" id="txtClarificationReply" value="" />

            </div>

            <div class="modal-footer ">
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal"><i class="fas fa-window-close"></i>&nbsp;&nbsp;Cancel</button>

                <button type="button" class="btn btn-info btn-sm btnClickDisable" onclick="replyClarification()"><i class="fas fa-thumbs-up"></i>&nbsp;&nbsp; Provide Clarification</button>


            </div>
        </div>
    </div>
</div>



@section scripts {


    <script type="text/javascript">

        $(document).ready(function () {
            $('.dataTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": true
            });

        });



        $('#modalUpdateApprove').on('shown.bs.modal', function () {
            $('#ApprovalByUserNameModal').focus();
        });


        $('.openModalUpdateReject').on('click', function () {
            let id = $(this).data("id");
            $("#modalTicketIdReject").val(id);
            $('#modalUpdateReject #modelLableId').text(id);

        });


        $('.openModalUpdateApprove').on('click', function () {
            let id = $(this).data("id");
            let stage = $(this).data("stage");
            $("#chkEscalateToDCEO").prop("checked", false);

            $("#modalTicketIdApproval").val(id);
            $('#modalUpdateApprove #modelLableId').text(id);

        });

        $('.openModalClarification').on('click', function () {

            let id = $(this).data("id");

            $("#modalClarificationRequestId").val(id);

            $("#modalClarification #lblClarificationRequestId").text(id);

            $("#ddlClarificationTarget").val("");

            $("#txtClarificationReason").val("");

            $("#ClarificationMode").val("Request");

            $("#divClarificationReason").show();

            $("#lblClarificationMode").text("Reason for clarification");

            $("#btnClarificationAction")
                .html('<i class="fas fa-thumbs-up"></i> Request Clarification');


        });

        $('.openModalRouteClarification').click(function () {

            let id = $(this).data("id");

            $("#modalClarificationRequestId").val(id);
            $("#modalClarification #lblClarificationRequestId").text(id);

            $("#ClarificationMode").val("Route");

            $("#divClarificationReason").hide();

            $("#lblClarificationMode").text("Route clarification");

            $("#btnClarificationAction")
                .html('<i class="fas fa-thumbs-up"></i> Route Clarification');

        });

        $("#btnClarificationAction").click(function () {

            if ($("#ClarificationMode").val() === "Request") {
                raiseClarification();
            }
            else {
                routeClarification();
            }

        });

        function reject() {

            var requestId = $("#modalTicketIdReject").val();
            var comment = $("#textCommentReject").val();

            $('.btnClickDisable').prop('disabled', true);

            const formData = new FormData();
            formData.append("RequestId", requestId);
            formData.append("Comment", comment);

            fetch('/RemoteAccessRequest/ITSVPReject', {
                method: "POST",
                headers: { "Accept": "application/json" },
                body: formData
            })
                .then(res => res.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Request has been rejected", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide comment", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    }

                    else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }





        function approve() {


            var requestId = $("#modalTicketIdApproval").val();
            var comment = $("#textCommentApproval").val();

            var escalateToDCEO = $("#chkEscalateToDCEO").is(":checked");




            $('.btnClickDisable').prop('disabled', true);

            const formData = new FormData();
            formData.append("RequestId", requestId);
            formData.append("Comment", comment);
            formData.append("EscalateToDCEO", escalateToDCEO);



            fetch('/RemoteAccessRequest/ITSVPApprove', {
                method: "POST",
                headers: { "Accept": "application/json" },
                body: formData
            })
                .then(res => res.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Request has been approved", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide comment", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    }

                    else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });
        }


        function raiseClarification() {

            const formData = new FormData();

            formData.append("RequestId",
                $("#modalClarificationRequestId").val());

            formData.append("Reason",
                $("#textClarificationReason").val());

            formData.append("ClarificationRequestedByTeamId", 13);



            let selected = $("#ddlClarificationTarget").val();

            let recipientType = "";
            let assignedTeamId = "";

            if (selected.startsWith("Team_")) {

                recipientType = "Team";
                assignedTeamId = selected.replace("Team_", "");

            }
            else {

                recipientType = selected;
            }

            formData.append("ClarificationType", recipientType);

            if (assignedTeamId !== "") {
                formData.append("ClarificationAssignedToTeamId", assignedTeamId);
            }


            $('.btnClickDisable').prop('disabled', true);

            fetch('/RemoteAccessRequest/ITSVPRaiseClarification',
                {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Successfully Requested Clarification", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide a clarification reason", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    } else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }


        function routeClarification() {

            const formData = new FormData();

            formData.append("RequestId",
                $("#modalClarificationRequestId").val());                      



            let selected = $("#ddlClarificationTarget").val();

            let recipientType = "";
            let assignedTeamId = "";

            if (selected.startsWith("Team_")) {

                recipientType = "Team";
                assignedTeamId = selected.replace("Team_", "");

            }
            else {

                recipientType = selected;
            }

            formData.append("ClarificationType", recipientType);

            if (assignedTeamId !== "") {
                formData.append("ClarificationAssignedToTeamId", assignedTeamId);
            }


            $('.btnClickDisable').prop('disabled', true);

            fetch('/RemoteAccessRequest/ITSVPRouteClarification',
                {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Successfully Routed Clarification", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }




        $('.openModalClarificationReply').click(function () {

            let id = $(this).data("id");

            $("#modalClarificationReplyId").val(id);

            $("#modalClarificationReply #lblClarificationReplyId").text(id);

            $("#txtClarificationReply").val("");


        });

        function replyClarification() {

            const formData = new FormData();

            formData.append("RequestId",
                $("#modalClarificationReplyId").val());

            formData.append("Reply",
                $("#txtClarificationReply").val());



            $('.btnClickDisable').prop('disabled', true);


            fetch('/RemoteAccessRequest/ITSVPReplyClarification',
                {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Successfully Replied to Clarification", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide a clarification reply", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    } else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }
















        function loadOngoingRequests() {

            fetch('/RemoteAccessRequest/GetEmployeePendingRequests')
                .then(res => res.json())
                .then(data => {
                    const tbody = $("#ongoingRequestsBody");
                    tbody.empty();

                    data.forEach(item => {
                        tbody.append(`
                            <tr>
                                <td>
                                    <a href="/RemoteAccessRequest/Info/${item.RemoteAccessRequestId}" target="_blank">
                                        #${item.RemoteAccessRequestId}
                                    </a>
                                </td>
                                <td>${item.Department}</td>
                                <td>${item.RequestedDate}</td>
                                <td>${item.AccessType}</td>
                                <td><span class="badge bg-warning">${item.Status}</span></td>
                            </tr>
                        `);
                    });
                });
        }

        function loadCompletedRequests() {

            fetch('/RemoteAccessRequest/GetEmployeeCompletedRequests')
                .then(res => res.json())
                .then(data => {
                    const tbody = $("#completedRequestsBody");
                    tbody.empty();

                    data.forEach(item => {
                        tbody.append(`
                        <tr>
                            <td>
                                <a href="/RemoteAccessRequest/Info/${item.RemoteAccessRequestId}" target="_blank">
                                    #${item.RemoteAccessRequestId}
                                </a>
                            </td>
                            <td>${item.Department}</td>
                            <td>${item.RequestedDate}</td>
                            <td>${item.AccessType}</td>
                            <td><span class="badge bg-success">${item.Status}</span></td>
                        </tr>
                    `);
                    });
                });
        }

        function loadRejectedRequests() {

            fetch('/RemoteAccessRequest/GetEmployeeRejectedRequests')
                .then(res => res.json())
                .then(data => {
                    const tbody = $("#rejectedRequestsBody");
                    tbody.empty();

                    data.forEach(item => {
                        tbody.append(`
                    <tr>
                        <td>
                            <a href="/RemoteAccessRequest/Info/${item.RemoteAccessRequestId}" target="_blank">
                                #${item.RemoteAccessRequestId}
                            </a>
                        </td>
                        <td>${item.Department}</td>
                        <td>${item.RequestedDate}</td>
                        <td>${item.AccessType}</td>
                        <td><span class="badge bg-danger">${item.Status}</span></td>
                    </tr>
                `);
                    });
                });
        }


    </script>
}
