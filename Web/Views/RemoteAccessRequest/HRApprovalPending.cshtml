@model ICollection<Domain.RA.RemoteAccessRequest>
@using Service.AR
@using Service
@using Domain.AR
@{

    Layout = "~/Views/Shared/_Layout.cshtml";

    var clarificationRequests =
        ViewBag.ClarificationRequests as ICollection<Domain.RA.RemoteAccessRequest>;
}




<div class="row">
    <div class="col-lg-12">

        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title m-0 mb-3">HR Remotework Admin</h3>
                <div class="clearfix mb-2"></div>


                <ul class="nav nav-pills">
                    <li class="nav-item"><a class="nav-link active" href="#tab_Pending" data-bs-toggle="tab">Pending</a></li>
                    <li class="nav-item"><a class="nav-link" href="#tab_Clarification" data-bs-toggle="tab">Request For Clarifications</a></li>

                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_Pending">

                        <div id="accordion">

                            @{
                                var expandShow = "";

                                foreach (var item in Model)
                                {
                                    <div id="R_@item.RemoteAccessRequestId" class="panel-collapse in collapse show" style="">

                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h4 class="card-title">
                                                    <a data-bs-toggle="collapse" data-parent="#accordion" href="#G_@item.RemoteAccessRequestId" class="collapsed">
                                                        Request# @item.RemoteAccessRequestId
                                                    </a>
                                                    &nbsp; | &nbsp; Remote Access (WFH)
                                                </h4>
                                                <div class="text-right">
                                                    <span class="badge bg-danger text-sm">@item.RemoteAccessType.EnumDisplayName()</span>
                                                    @if ((bool)item.IsClarificationNeeded)
                                                    {
                                                        <span class="badge bg-warning text-sm">Awaiting Clarification</span>

                                                    }

                                                </div>
                                            </div>

                                            <div id="G_@item.RemoteAccessRequestId" class="panel-collapse in collapse @expandShow" style="">
                                                <div class="card-body">
                                                    @Html.Partial("_RequestMin", item)

                                                </div>
                                                <div class="card-footer">
                                                    <div class="row float-right">
                                                        <div class="margin">
                                                            <a href="@Html.EncodedActionLink("","Info", "RemoteAccessRequest","", new { id = item.RemoteAccessRequestId },null)"
                                                               target="_blank"><i class="fas fa-info"></i>&nbsp;&nbsp;More.. </a>
                                                            @if (!(bool)item.IsClarificationNeeded)
                                                            {


                                                                <a class="btn bg-primary btn-sm text-white openModalUpdateApprove"
                                                                   data-id="@item.RemoteAccessRequestId"
                                                                   data-stage="@((int)item.ApprovalStage)"
                                                                   data-bs-toggle="modal"
                                                                   data-bs-target="#modalUpdateApprove">
                                                                    <i class="fas fa-thumbs-up"></i> Approve
                                                                </a>




                                                            <a class="btn bg-primary btn-sm text-white openModalClarification"
                                                               data-id="@item.RemoteAccessRequestId"
                                                               data-stage="@((int)item.ApprovalStage)"
                                                               data-bs-toggle="modal"
                                                               data-bs-target="#modalClarification">
                                                                <i class="fa fa-question-circle"></i> Request for clarification
                                                            </a>

                                                            }


                                                        </div>
                                                    </div>

                                                </div>
                                            </div>


                                        </div>
                                    </div>

                                }
                            }


                        </div>
                    </div>

                    <div class="tab-pane" id="tab_Clarification">

                        <div id="accordionClarification">

                            @{
                                var expandShowClarifications = "";

                                foreach (var item in clarificationRequests)
                                {
                                    <div id="R_C_@item.RemoteAccessRequestId" class="panel-collapse in collapse show" style="">

                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h4 class="card-title">
                                                    <a data-bs-toggle="collapse" data-parent="#accordionClarification" href="#C_@item.RemoteAccessRequestId" class="collapsed">
                                                        Request# @item.RemoteAccessRequestId
                                                    </a>
                                                    &nbsp; | &nbsp; Remote Access (WFH)
                                                </h4>
                                                <div class="text-right">
                                                    <span class="badge bg-danger text-sm">@item.RemoteAccessType.EnumDisplayName()</span>


                                                </div>
                                            </div>

                                            <div id="C_@item.RemoteAccessRequestId" class="panel-collapse in collapse @expandShowClarifications" style="">
                                                <div class="card-body">

                                                    @Html.Partial("_RequestMin", item)

                                                </div>
                                                <div class="card-footer">
                                                    <div class="row float-right">
                                                        <div class="margin">
                                                            <a href="@Html.EncodedActionLink("","Info", "RemoteAccessRequest","", new { id = item.RemoteAccessRequestId },null)"
                                                               target="_blank"><i class="fas fa-info"></i>&nbsp;&nbsp;More.. </a>

                                                            <a data-id="@item.RemoteAccessRequestId" class="openModalClarificationReply btn btn-primary btn-sm text-white " data-bs-toggle="modal" data-bs-target="#modalClarificationReply">
                                                                <i class="fa fa-comment"></i>  Provide clarification
                                                            </a>

                                                        </div>
                                                    </div>

                                                </div>
                                            </div>


                                        </div>
                                    </div>

                                }
                            }


                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>





<div class="modal fade" id="modalUpdateApprove">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Request #<label id="modelLableId"></label> Approve</h5>
            </div>

            <div class="modal-body">

                <input type="hidden" id="modalTicketIdApproval" />
                <input type="hidden" id="modalApprovalStage" />

                <input type="hidden" id="HRAction">



                <div class="form-group">
                    <label id="commentLabel">Comment</label>
                    <input type="text" id="textCommentApproval" class="form-control" placeholder="Enter comment" />
                </div>

                <!--hr fiedls-->
                <h6>Please fill below fields to generate Remote Work Agreement (annexure two)</h6>
                <div class="form-group">
                    <label id="commentLabel">Days of Week</label>
                    <input type="number" id="numberDaysOfweek" min="1" max="7" class="form-control" placeholder="Enter Days of Week" />
                </div>

                <div class="form-group">
                    <label id="commentLabel">Notice Period</label>
                    <input type="text" id="textNoticePeriod" class="form-control" placeholder="Enter Notice Period eg:- 1 month, 4 day, 1 week" />
                </div>


            </div>

            <div class="modal-footer">
                <button type="button" id="generalCancelBtn" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-window-close"></i> Cancel
                </button>

                <!--HR buttons-->

                <button type="button" class="btn btn-info btn-sm btnClickDisable" id="HRRecommend" onclick="approve()">
                    <i class="fas fa-thumbs-up"></i> Recommend
                </button>




            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="modalClarification">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ">Request #<label id="lblClarificationRequestId" name="lblClarificationRequestId"></label> Reason for clarification</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalClarificationRequestId" />


                <div class="form-group">
                    <input type="text" id="textClarificationReason" name="textClarificationReason" placeholder="Reason for clarification" class="form-control">
                </div>
            </div>

            <div class="modal-footer ">
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal"><i class="fas fa-window-close"></i>&nbsp;&nbsp;Cancel</button>
                <button type="button" class="btn btn-info btn-sm btnClickDisable" onclick="raiseClarification()">
                    <i class="fas fa-thumbs-up"></i> Request Clarification
                </button>


            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalClarificationReply">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title ">Request #<label id="lblClarificationReplyId" name="lblClarificationReplyId"></label> Clarify</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" name="modalClarificationReplyId" id="modalClarificationReplyId" value="" />

                <input type="text" class="form-control" placeholder="Enter clarification" name="txtClarificationReply" id="txtClarificationReply" value="" />

            </div>

            <div class="modal-footer ">
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal"><i class="fas fa-window-close"></i>&nbsp;&nbsp;Cancel</button>

                <button type="button" class="btn btn-info btn-sm btnClickDisable" onclick="replyClarification()"><i class="fas fa-thumbs-up"></i>&nbsp;&nbsp; Provide Clarification</button>


            </div>
        </div>
    </div>
</div>




@section scripts {


    <script type="text/javascript">

        $(document).ready(function () {
            $('.dataTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": true
            });

        });



        $('#modalUpdateApprove').on('shown.bs.modal', function () {
            $('#ApprovalByUserNameModal').focus();
        });


        $('.openModalUpdateReject').on('click', function () {
            let id = $(this).data("id");
            $("#modalTicketIdReject").val(id);
            $('#modalUpdateReject #modelLableId').text(id);

        });


        $('.openModalUpdateApprove').on('click', function () {
            let id = $(this).data("id");
            let stage = $(this).data("stage");
            $("#modalTicketIdApproval").val(id);
            $('#modalUpdateApprove #modelLableId').text(id);
            $("#modalApprovalStage").val(stage);

        });

        // handle raise clarify
        $('.openModalClarification').on('click', function () {

            let id = $(this).data("id");

            $("#modalClarificationRequestId").val(id);

            $("#modalClarification #lblClarificationRequestId").text(id);

            $("#ddlClarificationTarget").val("");

            $("#txtClarificationReason").val("");

        });


        function raiseClarification() {

            const formData = new FormData();

            formData.append("RequestId",
                $("#modalClarificationRequestId").val());

            formData.append("Reason",
                $("#textClarificationReason").val());

            formData.append("ClarificationRequestedByTeamId",20);
          

            formData.append("ClarificationType", "Requester");

            formData.append("ClarificationAssignedToTeamId", null);
            


            $('.btnClickDisable').prop('disabled', true);

            fetch('/RemoteAccessRequest/HRRaiseClarification',
                {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Successfully Requested Clarification", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide a clarification reason", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    } else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }


        $('.openModalClarificationReply').click(function () {

            let id = $(this).data("id");

            $("#modalClarificationReplyId").val(id);

            $("#modalClarificationReply #lblClarificationReplyId").text(id);

            $("#txtClarificationReply").val("");


        });

        function replyClarification() {

            const formData = new FormData();

            formData.append("RequestId",
                $("#modalClarificationReplyId").val());

            formData.append("Reply",
                $("#txtClarificationReply").val());



            $('.btnClickDisable').prop('disabled', true);


            fetch('/RemoteAccessRequest/HRReplyClarification',
                {
                    method: "POST",
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Successfully Replied to Clarification", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide a clarification reply", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    } else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });

        }




        function approve() {


            var requestId = $("#modalTicketIdApproval").val();
            var approvalStage = $("#modalApprovalStage").val();
            var comment = $("#textCommentApproval").val();
            var daysOfWeek = $("#numberDaysOfweek").val();
            var noticePeriod = $("#textNoticePeriod").val();




            $('.btnClickDisable').prop('disabled', true);

            const formData = new FormData();
            formData.append("RequestId", requestId);
            formData.append("ApprovalStage", approvalStage);
            formData.append("Comment", comment);
            formData.append("DaysOfWeek", daysOfWeek);
            formData.append("NoticePeriod", noticePeriod);


            fetch('/RemoteAccessRequest/HRApprove', {
                method: "POST",
                headers: { "Accept": "application/json" },
                body: formData
            })
                .then(res => res.json())
                .then(data => {
                    if (data === 1) {
                        Swal.fire("Completed", "Request has been approved", "success");
                        setTimeout(() => { window.location.reload(); }, 2000);
                    }
                    else if (data === 3) {
                        Swal.fire("Error", "Please provide annexure details", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    }                   
                   
                    else if (data === 10) {
                        Swal.fire("Error", "Days of Week should be greater than zero and less than seven", "error");
                        setTimeout(() => { window.location.reload(); }, 2000);

                    }
                    else {
                        Swal.fire("Error", "Something went wrong", "error");
                    }
                });
        }





    </script>
}
