@model Domain.RA.RemoteAccessRequest
@using Service.AR
@using Service
@using Domain
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var WorkflowTeams = ViewBag.WorkflowTeams as List<long>;
    var riskTeamId = ViewBag.RiskTeamId;

    var updates = Model.RemoteAccessRequestUpdates
        .Where(u => !u.IsDeleted && u.TeamId != null)
        .OrderBy(u => u.UpdatedDate)
        .ToList();

    var updateByTeam = updates
        .GroupBy(u => u.TeamId)
        .ToDictionary(g => g.Key, g => g.Last());

    long? activeTeamId = Model.TeamId;

    
    string GetManualTeamName(long id)
    {
        switch (id)
        {
            case 19: return "Risk Team";
            case 20: return "HR Department";
            case 21: return "IT Security Head";
            case 13: return "IT SVP";
            case 22: return "DCEO";
            case 7: return "Implementer - IT Security";
            case 4: return "Implementer - Network Team";
            case 2: return "Help Desk";
            default: return "Reviewer";
        }
    }
    


}
<div class="row">
    <div class="col-lg-12">
        <div class="card card-primary card-outline">

            <div class="card-header">
                <h4 class="card-title">
                    <b>Request# @Model.RemoteAccessRequestId</b>
                    &nbsp; &nbsp; Remote Access
                </h4>
                <div class="text-right">

                    <span class="badge bg-@AccessRequestService.GetStatusColor(Model.Status) text-sm">
                        @Model.Status.EnumDisplayName()
                        @*@if (Model.Status == Domain.AR.AccessRequestStatusEnum.Pending)
                            {
                                <i class="fas fa-angle-double-right"></i>
                                <span>@Model.WorkflowLevelType.EnumDisplayName()&nbsp;-&nbsp;@(Model.TeamId !=null ? Model.Team.TeamName : "N/A") </span>
                            }*@
                    </span>&nbsp;&nbsp;
                </div>
            </div>
            <div class="card-body">

                <div class="bs-stepper linear card">
                    <div class="bs-stepper-header" role="tablist">
                        @{
                            int index = 0;
                        }
                        @foreach (var teamId in WorkflowTeams)
                        {
                            index++;

                            // 1. Determine State
                            bool isCompleted = updateByTeam.ContainsKey(teamId);
                            bool isActive = (activeTeamId == teamId && Model.Status == Domain.AR.AccessRequestStatusEnum.Pending);

                            // 2. Assign Classes
                            string stepClass = isActive ? "active" : "";
                            string circleClass = "bg-secondary"; // Default (Upcoming)

                            if (isActive)
                            {
                                circleClass = "bg-primary"; // Current stage color
                            }
                            else if (isCompleted)
                            {
                                var lastUpd = updateByTeam[teamId];
                                circleClass = (lastUpd.Status == Domain.AR.AccessRequestStatusEnum.Rejected ||
                                               lastUpd.Status == Domain.AR.AccessRequestStatusEnum.Revoked)
                                              ? "bg-danger"
                                              : "bg-success";
                            }

                            if (index > 1)
                            {<div class="line"></div> }

                            <div class="step @stepClass">
                                <button type="button" class="step-trigger">
                                    <span class="bs-stepper-circle @circleClass">@index</span>
                                    <span class="bs-stepper-label" style="font-size:x-small">
                                        @GetManualTeamName(teamId)
                                    </span>
                                </button>
                            </div>
                        }

                    </div>

                </div>

                <div class="row">

                    <div class="col-sm-8">

                        <strong>@Html.LabelFor(model => Model.BusinessJustification)</strong>
                        <p class="text-muted">

                            @(string.IsNullOrEmpty(Model?.BusinessJustification) ? "N/A" : Model?.BusinessJustification)
                        </p>
                        <hr />
                        <strong>@Html.LabelFor(model => Model.BelowAMJustification)</strong>
                        <p class="text-muted">

                            @(string.IsNullOrEmpty(Model?.BelowAMJustification) ? "N/A" : Model?.BelowAMJustification)
                        </p>

                        <hr />
                        <strong>@Html.LabelFor(model => Model.ToleranceLimitExceededJustification)</strong> 
                        <p class="text-muted">
                            @(string.IsNullOrEmpty(Model?.ToleranceLimitExceededJustification) ? "N/A" : Model?.ToleranceLimitExceededJustification)                            
                        </p>
                        
                        <hr />
