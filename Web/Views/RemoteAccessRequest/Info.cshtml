                                    <div class="card-header bg-light text-primary fw-bold py-2">
                                        Agreement Details
                                    </div>
                                    <div class="card-body pb-1">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-2 py-1">Location Type</dt>
                                            <dd class="col-sm-4 py-1">
                                                @((int)(item?.LocationType ?? 0) == 0 ? "N/A" : item?.LocationType.EnumDisplayName())
