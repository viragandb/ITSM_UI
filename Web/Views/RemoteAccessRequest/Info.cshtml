                <div class="row">
                    <div class="col-lg-8">
                        <div class="card direct-chat direct-chat-warning card-gray card-outline">
                            <div class="card-header">
                                <h3 class="card-title">Status</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                        <i class="fas fa-minus"></i>
                                    </button>

                                </div>
                            </div>
                            <div class="card-body pb-0">
                                <div class="row">
                                    <div class="col-12 p-4">
                                        @{
                                            foreach (var status in Model.RemoteAccessRequestUpdates.OrderBy(o => o.UpdatedDate))
                                            {
                                                <div class="direct-chat-msg">
                                                    <div class="direct-chat-infos clearfix">
                                                    <span class="direct-chat-name float-left">
                                                        @(string.IsNullOrEmpty(status?.UpdatedUser?.FullName) ? "N/A" : status?.UpdatedUser?.FullName)

                                                        @if (status.Team != null)
                                                        {
                                                            if (status.TeamId != 1)
                                                            {
                                                                <span>(@status.Team.TeamName)</span>
                                                            }
                                                        }
                                                    </span>
                                                        <span class="direct-chat-timestamp float-right">@status.UpdatedDate &nbsp;<i class="far fa-calendar"></i> </span>
                                                    </div>
                                                    <img class="direct-chat-img" src="@status.UpdatedUser.ProImageName" alt="message user image">
                                                    <div class="direct-chat-text bg-@AccessRequestService.GetStatusColor(status.Status) ">
                                                        <div class="row">
                                                            <div class="col-10">
                                                                @((int)(status?.Status ?? 0) == 0 ? "N/A" : status?.Status.EnumDisplayName())
                                                                | @(string.IsNullOrEmpty(status?.Comment) ? "No comment provided." : status?.Comment)
                                                            </div>
                                                            <div class="col-2 text-right">
                                                                <b>@status.SpentTimeFomated (HH:MM)</b>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="col-lg-4 ">
                        <div class="card card-gray card-outline">
                            <div class="card-header">
                                <h3 class="card-title">Ticket Log</h3>
                                <div class="card-tools">

                                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                        <i class="fas fa-minus"></i>
                                    </button>

                                </div>
                            </div>
                            <div class="card-body card-comments style=" display: block;"">
                                @{
                                    foreach (var log in Model.RemoteAccessRequestLogs.OrderBy(o => o.UpdatedDate))
                                    {
                                        <div class="row">
                                            <div class="col-sm-12">

                                                <div class="card-comment">
                                                    <img class="img-circle img-sm" src="@(log.UpdatedBy!=null? log.UpdatedUser.ProImageName : "/Images/userimage.png")" alt="User Image">
                                                    <div class="comment-text">
                                                        <span class="username">
                                                            @(log.UpdatedBy!=null? log?.UpdatedUser?.FullName : "N/A")
                                                            <span class="text-muted float-right">@log.UpdatedDate</span>
                                                        </span>
                                                        @(string.IsNullOrEmpty(log?.Description) ? "N/A" : log?.Description)
                                                        
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

