                                <dd class="col-sm-4 py-1">
                                    @(string.IsNullOrEmpty(Model?.RemoteWorkLocation) ? "N/A" : Model?.RemoteWorkLocation)
                                </dd>

                                <dt class="col-sm-2 py-1">Start Date</dt>
                                <dd class="col-sm-4 py-1">
                                    @(Model == null || Model.StartDate == DateTime.MinValue ? "N/A" : Model.StartDate.ToShortDateString())
                                </dd>

                                <dt class="col-sm-2 py-1">End Date</dt>
                                <dd class="col-sm-4 py-1">
                                    @(Model == null || Model.EndDate == DateTime.MinValue ? "N/A" : Model.EndDate.ToShortDateString())
                                </dd>

                                <dt class="col-sm-2 py-1">Tolerance Exceeded</dt>
                                <dd class="col-sm-4 py-1">
                                    <span class="badge @(Model.IsToleranceLimitExceeded ? "bg-danger" : "bg-success") px-2.5 py-1.5" style="font-size: 0.95rem; font-weight: 600;">
                                        @(Model.IsToleranceLimitExceeded ? "Yes" : "No")
                                    </span>
                                </dd>

                                <dt class="col-sm-2 py-1">Planned Schedule</dt>
                                <dd class="col-sm-4 py-1">
                                    @((int)(Model?.PlannedSchedule ?? 0) == 0 ? "N/A" : Model.PlannedSchedule.EnumDisplayName())
                                </dd>
                            </dl>
                        </div>

                        @if (Model.RemoteAgreements != null && Model.RemoteAgreements.Any())
                        {

                            foreach (var item in Model.RemoteAgreements)
