@model Web.Models.RemoteAccessRequestVM
@using Service
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "RemoteAccessRequest", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    @*@Html.HiddenFor(model => model.AccessTypeId)
    @Html.HiddenFor(model => model.AccessType)*@

    <div class="row">
        <div class="col-lg-8">
