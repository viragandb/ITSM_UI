        $("#addSystemBtn").click(function () {

            var AssetTypeId = $("#RemoteAccessItemTypeId").val();
            var AssetTypeName = $("#RemoteAccessItemTypeId option:selected").text();

            if (!AssetTypeId || AssetTypeId === "0") {
                Swal.fire("Warning", "Please select a system.", "warning");
                return;
            }

            var exists = false;
            $('#systemsTable tbody input[name$=".AssetTypeId"]').each(function () {
                if ($(this).val() === AssetTypeId) {
                    exists = true;
                    return false; // Break the .each loop
                }
            });

            if (exists) {
                Swal.fire("Warning", "This System/Application has already been added", "warning");
                return;
            }

            // Append row
            var index = $("#systemsTable tbody tr").length;

            var row = `
            <tr>
                <td>
                    ${AssetTypeName}
                    <input type="hidden" name="SelectedSystems[${index}].AssetTypeId" value="${AssetTypeId}" />
                    <input type="hidden" name="SelectedSystems[${index}].AssetTypeName" value="${AssetTypeName}" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger removeRow">Remove</button>
                </td>
            </tr>
        `;

            $("#systemsTable tbody").append(row);
        });

        // Remove row
        $(document).on("click", ".removeRow", function () {
            $(this).closest("tr").remove();

            // Re-index hidden inputs to avoid model binding errors
            $("#systemsTable tbody tr").each(function (i, row) {
                $(row).find("input[type=hidden]").each(function () {
                    var oldName = $(this).attr("name");
                    var newName = oldName.replace(/\[\d+\]/, "[" + i + "]");
                    $(this).attr("name", newName);
                });
            });
        });


