@section scripts {

    <script type="text/javascript">


        document.addEventListener('DOMContentLoaded', function () {
            loadUserDepartments();
            loadRemoteAccessSysTypes();
            SearchADUserApproval();
            SearchADUser();
            loadLocations();
            SearchAssets();

            // When select-all is clicked
            document.querySelectorAll(".select-all").forEach(selectAll => {
                selectAll.addEventListener("change", function () {
                    const group = this.dataset.group;
                    document.querySelectorAll("." + group).forEach(cb => {
                        cb.checked = this.checked;
                    });
                });
            });

            // When individual checkbox is changed
            document.querySelectorAll(".form-check-input").forEach(cb => {
                cb.addEventListener("change", function () {
                    this.classList.forEach(cls => {
                        const selectAll = document.querySelector(
                            `.select-all[data-group="${cls}"]`
                        );
                        if (!selectAll) return;

                        const all = document.querySelectorAll("." + cls);
                        const checked = document.querySelectorAll("." + cls + ":checked");

                        selectAll.checked = all.length === checked.length;
                    });
                });
            });

            function toggleOverseasFields() {
                if ($('#chkWillTravel').is(':checked')) {
                    $('#overseasFields').slideDown(400); // Slide down animation
                } else {
                    $('#overseasFields').slideUp(400);   // Slide up animation
                    // Optional: Clear the values if unticked
                    $('#overseasFields').find('input[type="text"]').val('');
                    $('#overseasFields').find('input[type="checkbox"]').prop('checked', false);
                }
            }

            // Run on page load 
            if ($('#chkWillTravel').is(':checked')) {
                $('#overseasFields').show();
            }

            $('#chkWillTravel').change(function () {
                toggleOverseasFields();
            });
        })

