@using Service
@using Service.AR
@model IEnumerable<Domain.AR.AccessRequest>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "AccessRequest", FormMethod.Get))
{
    <div class="row">
        <div class="col-12">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="align-middle me-2" data-lucide="key-round"></i>
                        Access Request
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label" for="TeamId">Team</label>
                            <select id="TeamId"
                                    name="TeamId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="AccessRequestTypeId">Request Type</label>
                            <select id="AccessRequestTypeId"
                                    name="AccessRequestTypeId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="BranchId">Branch</label>
                            <select id="BranchId"
                                    name="BranchId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="DepartmentId">Department</label>
                            <select id="DepartmentId"
                                    name="DepartmentId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="DurationTypeId">Duration Type</label>
                            <select id="DurationTypeId"
                                    name="DurationTypeId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="AccessTypeId">Access Type</label>
                            <select id="AccessTypeId"
                                    name="AccessTypeId"
                                    class="form-select">
                                <option value=""></option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="StartDate">Requested Date</label>
                            <div class="input-group">
                                <input type="date"
                                       name="StartDate"
                                       id="StartDate"
                                       value="@ViewBag.StartDate"
                                       class="form-control" />
                                <span class="input-group-text">
                                    <i class="align-middle" data-lucide="calendar"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="EndDate">To</label>
                            <div class="input-group">
                                <input type="date"
                                       name="EndDate"
                                       id="EndDate"
                                       value="@ViewBag.EndDate"
                                       class="form-control" />
                                <span class="input-group-text">
                                    <i class="align-middle" data-lucide="calendar"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="RequestId">Request #</label>
                            <input type="text"
                                   id="RequestId"
                                   name="RequestId"
                                   value="@ViewBag.RequestId"
                                   class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="StatusId">Status</label>
                            <select id="StatusId"
                                    name="StatusId"
                                    class="form-select">
                                <option value=""></option>
                            </select>

                            <span class="text-danger"
                                  data-valmsg-for="StatusId"
                                  data-valmsg-replace="true">
                            </span>
                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex justify-content-end">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="align-middle me-1" data-lucide="search"></i>

                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="dataTable"
                               class="table table-striped table-hover align-middle w-100">

                            <thead>

                                <tr>
                                    <th>Request #</th>
                                    <th>Type</th>
                                    <th>Access Type</th>
                                    <th>Duration Type</th>
                                    <th>Created By</th>
                                    <th>Requester</th>
                                    <th>Requested Date</th>
                                    <th>Status</th>
                                    <th>Team</th>
                                    <th>Branch</th>
                                    <th>Department</th>
                                    <th>Subject</th>
                                    <th>Description</th>
                                    <th>Justification</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <a href="@Html.EncodedActionLink(
                                                         "",
                                                         "Info",
                                                         "AccessRequest",
                                                         "",
                                                         new { id = item.AccessRequestId },
                                                         null
                                                     )"
                                               target="_blank"
                                               class="text-decoration-none">

                                                <i class="align-middle me-1"
                                                   data-lucide="external-link"></i>

                                                #@item.AccessRequestId

                                            </a>

                                        </td>

                                        <td>
                                            <span class="badge bg-@item.AccessRequestType.Color">
                                                @item.AccessRequestType.Name
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge bg-@AccessRequestService.GetUserTypeColor(item.AccessType)">
                                                @item.AccessType.EnumDisplayName()
                                            </span>
                                        </td>

                                        <td>
                                            @item.DurationType.EnumDisplayName()
                                        </td>

                                        <td>
                                            @item.CreatedUser.FullName
                                        </td>

                                        <td>

                                            @if (item.AccessType == Domain.AllocatedTypeEnum.Internal)
                                            {
                                                @item.RequestedUser.FullName
                                            }
                                            else
                                            {
                                                @item.ExternalUser
                                            }

                                        </td>

                                        <td>
                                            @item.RequestedDate
                                        </td>

                                        <td>

                                            <span class="badge bg-@AccessRequestService.GetStatusColor(item.Status)">

                                                @item.Status.EnumDisplayName()

                                                @if (item.Status == Domain.AR.AccessRequestStatusEnum.Pending)
                                                {
                                                    <i class="align-middle mx-1"
                                                       data-lucide="chevrons-right"></i>

                                                    <span>
                                                        @item.WorkflowLevelType.EnumDisplayName()
                                                        -
                                                        @(item.TeamId != null
                                                            ? item.Team.TeamName
                                                            : "N/A")
                                                    </span>
                                                }

                                            </span>

                                        </td>

                                        <td>
                                            @(item.TeamId != null
                                                ? item.Team.TeamName
                                                : "N/A")
                                        </td>

                                        <td>
                                            @item.Branch.Name
                                        </td>

                                        <td>
                                            @item.Department.DepartmentName
                                        </td>

                                        <td>
                                            @item.Subject
                                        </td>

                                        <td>
                                            @item.Description
                                        </td>

                                        <td>
                                            @item.Justification
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
}

@section scripts {

    <script type="text/javascript">

        function parseJsonResult(data) {

            if (typeof data === "string") {

                try {
                    return JSON.parse(data);
                }
                catch (e) {
                    return [];
                }

            }

            return data || [];

        }


        $(document).ready(function () {

            if ($.fn.DataTable) {

                $("#dataTable").DataTable({

                    responsive: true,
                    lengthChange: false,
                    autoWidth: false,
                    paging: false,

                    buttons: [
                        {
                            extend: "excelHtml5",
                            text: "Excel",
                            title: "Access Request",
                            exportOptions: {
                                modifier: {
                                    page: "current"
                                }
                            }
                        },
                        {
                            extend: "pdfHtml5",
                            text: "PDF",
                            title: "Access Request",
                            orientation: "landscape",
                            exportOptions: {
                                modifier: {
                                    page: "current"
                                }
                            }
                        },
                        {
                            extend: "print",
                            text: "Print",
                            title: "Access Request",
                            autoPrint: true
                        },
                        "colvis"
                    ]

                })
                .buttons()
                .container()
                .appendTo(
                    "#dataTable_wrapper .col-md-6:eq(0)"
                );

            }

            loadTeams();
            loadAccessRequestTypes();
            loadLocations();
            loadStatus();
            loadDurationTypes();
            loadAccessTypes();

        });


        function loadTeams() {

            $.getJSON(
                '@Url.Action("GetTeamListJsonResult", "Team")',
                function (data) {

                    var dropDown = $("#TeamId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.TeamId,
                                    text: item.TeamName
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.TeamId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadAccessRequestTypes() {

            $.getJSON(
                '@Url.Action("GetItemsJsonResult", "AccessRequestType")',
                function (data) {

                    var dropDown = $("#AccessRequestTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.AccessRequestTypeId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.AccessRequestTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadLocations() {

            $.getJSON(
                '@Url.Action("GetItemListJsonResult", "Branch")',
                function (data) {

                    var dropDown = $("#BranchId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.BranchId,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.BranchId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                    loadDepartments();

                }
            );

        }


        $("select#BranchId").on(
            "change",
            function () {
                loadDepartments();
            }
        );


        function loadDepartments() {

            var branchId = $("#BranchId").val();

            $.getJSON(
                '@Url.Action("GetDepartmentListBtBranchIdJsonResult", "Department")',
                {
                    branchId: branchId
                },
                function (data) {

                    var dropDown = $("#DepartmentId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.DepartmentId,
                                    text: item.DepartmentName
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.DepartmentId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadDurationTypes() {

            $.getJSON(
                '@Url.Action("GetDurationTypesJsonResult", "AccessRequest")',
                function (data) {

                    var dropDown = $("#DurationTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.DurationTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadAccessTypes() {

            $.getJSON(
                '@Url.Action("GetAccessTypesJsonResult", "AccessRequest")',
                function (data) {

                    var dropDown = $("#AccessTypeId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.AccessTypeId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }


        function loadStatus() {

            $.getJSON(
                '@Url.Action("GetStatusJsonResult", "AccessRequest")',
                function (data) {

                    var dropDown = $("#StatusId");

                    dropDown.empty();

                    dropDown.append(
                        "<option value='0'>-- All --</option>"
                    );

                    $.each(
                        parseJsonResult(data),
                        function (index, item) {

                            dropDown.append(
                                $("<option/>", {
                                    value: item.Id,
                                    text: item.Name
                                })
                            );

                        }
                    );

                    var selectedId = '@ViewBag.StatusId';

                    if (selectedId) {
                        dropDown.val(selectedId);
                    }

                }
            );

        }

    </script>

}
