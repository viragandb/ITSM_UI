        function reindexCollection(
            tableSelector,
            collectionName
        ) {

            $(tableSelector + " tr")
                .each(function (rowIndex) {

                    $(this)
                        .attr(
                            "id",
                            rowIndex
                        );

                    $(this)
                        .find(
                            "[name^='" +
                            collectionName +
                            "'][name*='[']"
                        )
                        .each(function () {

                            var name =
                                $(this).attr("name");

                            if (!name) {
                                return;
                            }

                            var newName =
                                name.replace(
                                    /\[\d+\]/,
                                    "[" + rowIndex + "]"
                                );

                            $(this)
                                .attr(
                                    "name",
                                    newName
                                );

                        });

                    $(this)
                        .find(
                            "[id^='" +
                            collectionName +
                            "_']"
                        )
                        .each(function () {

                            var id =
                                $(this).attr("id");

                            if (!id) {
                                return;
                            }

                            var newId =
                                id.replace(
                                    new RegExp(
                                        "^" +
                                        collectionName +
                                        "_\\d+__"
                                    ),
                                    collectionName +
                                    "_" +
                                    rowIndex +
                                    "__"
                                );

                            $(this)
                                .attr(
                                    "id",
                                    newId
                                );

                        });

                });

        }


